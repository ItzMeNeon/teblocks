---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand" aria-label={SITE_TITLE}>
			<Logo size={30} />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<div class="nav-links" id="nav-links">
			<a href="/#play">Play</a>
			<a href="/#modes">Modes</a>
			<a href="/leaderboards/">Leaderboards</a>
			<a href="/users">Players</a>
			<span class="nav-divider" aria-hidden="true"></span>
			<a href="/account/" data-account-link class="nav-cta">Sign up</a>
			<a href="/profile/" data-profile-link class="nav-pill">Profile</a>
		</div>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
			<span></span><span></span><span></span>
		</button>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: 0 1.4rem;
		background: rgba(6, 9, 18, 0.72);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 1120px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4rem;
		gap: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55em;
		font-weight: 800;
		font-size: 1.1rem;
		color: var(--text);
		letter-spacing: -0.01em;
		flex-shrink: 0;
	}
	.brand:hover {
		color: var(--text);
	}
	.brand-name {
		background: linear-gradient(120deg, #ffffff, var(--accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.nav-links a {
		padding: 0.55em 0.85em;
		color: var(--text-dim);
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 999px;
		transition: color 0.15s ease, background 0.15s ease;
		text-decoration: none;
	}
	.nav-links a:hover {
		color: var(--text);
		background: rgba(255, 255, 255, 0.05);
	}
	.nav-links a.active {
		color: var(--text);
	}
	.nav-links a.active::after {
		content: '';
		display: block;
		width: 20px;
		height: 2px;
		margin: 0.3em auto 0;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
	}

	.nav-divider {
		width: 1px;
		height: 1.4em;
		background: var(--border);
		margin: 0 0.35em;
	}
	.nav-cta {
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #03121a !important;
		font-weight: 700;
	}
	.nav-cta:hover {
		filter: brightness(1.08);
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
	}
	.nav-pill {
		border: 1px solid var(--border);
	}
	.nav-pill:hover {
		border-color: var(--border-bright);
		background: rgba(255, 255, 255, 0.05);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		gap: 4px;
		padding: 0.5em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: transparent;
		cursor: pointer;
	}
	.menu-toggle span {
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
	}

	@media (max-width: 760px) {
		header {
			padding: 0 0.9rem;
		}
		nav {
			position: relative;
			height: 4rem;
		}
		.menu-toggle {
			display: flex;
		}
		.nav-links {
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.6em 0.7em 0.8em;
			border-bottom: 1px solid var(--border);
			background: rgba(6, 9, 18, 0.96);
			backdrop-filter: blur(14px);
			box-shadow: var(--shadow);
		}
		.nav-links.open {
			display: flex;
		}
		.nav-links a {
			padding: 0.7em 0.6em;
			font-size: 0.95rem;
			border-radius: 8px;
		}
		.nav-links a.active::after {
			display: none;
		}
		.nav-divider {
			width: 100%;
			height: 1px;
			margin: 0.4em 0;
		}
		.nav-cta {
			text-align: center;
		}
	}
</style>

<script>
	const accountLinks = document.querySelectorAll('[data-account-link]');
	const profileLinks = document.querySelectorAll('[data-profile-link]');

	fetch('/api/auth/me', { credentials: 'include' })
		.then((response) => {
			if (response.ok) {
				accountLinks.forEach((link) => {
					link.textContent = 'Account';
					link.classList.remove('nav-cta');
					link.removeAttribute('data-account-link');
				});
				profileLinks.forEach((link) => link.removeAttribute('data-profile-link'));
			}
		})
		.catch(() => {});

	const menuToggle = document.querySelector('.menu-toggle');
	const navLinks = document.querySelector('#nav-links');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		navLinks?.classList.toggle('open', !expanded);
	});
	navLinks?.querySelectorAll('a').forEach((link) =>
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			navLinks.classList.remove('open');
		})
	);
</script>
