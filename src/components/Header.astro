---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="mark" aria-hidden="true">
				<span></span><span></span><span></span><span></span>
			</span>
			{SITE_TITLE}
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-links">Menu</button>
		<div id="site-links" class="internal-links">
			<HeaderLink href="/#modes">Modes</HeaderLink>
			<HeaderLink href="/#systems">Systems</HeaderLink>
			<HeaderLink href="/#play">Play</HeaderLink>
			<HeaderLink href="/account/" data-account-link>Account</HeaderLink>
			<HeaderLink href="/profile/">Profile</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0 1.5em;
		background: rgba(10, 12, 16, 0.85);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.2em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
				font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text);
		letter-spacing: -0.01em;
	}
	.brand:hover { color: var(--text); }

	/* O-piece mark: a tight 2x2 block grid, matching the actual tetromino */
	.mark {
		display: grid;
		grid-template-columns: 7px 7px;
		grid-template-rows: 7px 7px;
		gap: 2px;
	}
	.mark span {
		background: var(--o);
		border-radius: 1.5px;
	}

	.internal-links {
		display: flex;
		gap: 0.4em;
	}
	.menu-toggle { display: none; padding: .55em .7em; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--text); font: 700 .78rem "Atkinson", sans-serif; cursor: pointer; }
	.internal-links :global(a) {
		padding: 0.6em 0.9em;
		color: var(--dim);
		font-size: 0.92rem;
		font-weight: 500;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: var(--text);
		background: var(--panel);
	}
	@media (max-width: 720px) {
		header { padding: 0 0.8em; }
		nav { position: relative; height: auto; min-height: 4.2em; }
		.menu-toggle { display: block; }
		.internal-links { position: absolute; top: calc(100% + 1px); left: -.8em; right: -.8em; display: none; flex-direction: column; gap: 0; padding: .55em .8em .8em; border-bottom: 1px solid var(--line); background: rgba(10, 12, 16, .97); box-shadow: var(--shadow); }
		.internal-links.open { display: flex; }
		.internal-links :global(a) { padding: .7em .65em; font-size: .9rem; }
	}
</style>

<script>
	const accountLink = document.querySelector('[data-account-link]');

	if (accountLink) {
		fetch('/api/auth/me').then((response) => {
			if (response.ok) accountLink.remove();
		}).catch(() => {
			// Keep the sign-up link when auth state cannot be checked.
		});
	}

	const menuToggle = document.querySelector('.menu-toggle');
	const siteLinks = document.querySelector('#site-links');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		siteLinks?.classList.toggle('open', !expanded);
	});
	siteLinks?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menuToggle?.setAttribute('aria-expanded', 'false');
		siteLinks.classList.remove('open');
	}));
</script>
