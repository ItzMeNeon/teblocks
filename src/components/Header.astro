---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="mark" aria-hidden="true">
				<span></span><span></span><span></span><span></span>
			</span>
			{SITE_TITLE}
		</a>

		<div class="nav-links" id="nav-links">
			<a href="/#modes">Modes</a>
			<a href="/leaderboards/">Leaderboards</a>
			<a href="/#systems">Systems</a>
			<a href="/#play">Play</a>
			<a href="/users">Find players</a>
			<span class="nav-divider" aria-hidden="true"></span>
			<a href="/account/" data-account-link class="nav-cta">Create account</a>
			<a href="/profile/" data-profile-link>Profile</a>
		</div>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0 1.5em;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3.8em;
		gap: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 1rem;
		color: var(--text);
		letter-spacing: -0.01em;
		flex-shrink: 0;
	}
	.brand:hover { color: var(--text); }

	.mark {
		display: grid;
		grid-template-columns: 6px 6px;
		grid-template-rows: 6px 6px;
		gap: 2px;
	}
	.mark span {
		background: var(--accent);
		border-radius: 1px;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.2em;
	}
	.nav-links a {
		padding: 0.5em 0.75em;
		color: var(--text-dim);
		font-size: 0.88rem;
		font-weight: 500;
		border-radius: var(--radius);
		transition: color 0.15s ease, background 0.15s ease;
		text-decoration: none;
	}
	.nav-links a:hover {
		color: var(--text);
		background: var(--panel);
	}
	.nav-links a.active {
		color: var(--text);
		font-weight: 600;
	}
	.nav-links a.active::after {
		content: "";
		display: block;
		width: 18px;
		height: 2px;
		margin: 0.35em auto 0;
		border-radius: 1px;
		background: var(--accent);
	}
	.nav-divider {
		width: 1px;
		height: 1.4em;
		background: var(--border);
		margin: 0 0.4em;
	}
	.nav-cta {
		background: var(--accent);
		color: var(--bg);
		font-weight: 600;
		border: 1px solid var(--accent);
		border-radius: 6px;
	}
	.nav-cta:hover {
		background: var(--accent-dim);
		border-color: var(--accent-dim);
		color: var(--bg);
	}
	[data-profile-link] {
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	[data-profile-link]:hover {
		border-color: var(--border-bright);
	}

	.menu-toggle { display: none; padding: .45em .6em; border: 1px solid var(--border); border-radius: var(--radius); background: transparent; color: var(--text); font: 600 .75rem var(--font-ui); cursor: pointer; }

	@media (max-width: 720px) {
		header { padding: 0 0.8em; }
		nav { position: relative; height: auto; min-height: 3.8em; }
		.menu-toggle { display: block; }
		.nav-links {
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: .6em .7em .7em;
			border-bottom: 1px solid var(--border);
			background: var(--bg);
			box-shadow: var(--shadow);
		}
		.nav-links.open { display: flex; }
		.nav-links a {
			padding: .7em .5em;
			font-size: .95rem;
			border-radius: 6px;
		}
		.nav-links a.active::after {
			display: none;
		}
		.nav-divider {
			width: 100%;
			height: 1px;
			margin: 0.4em 0;
		}
		.nav-cta {
			text-align: center;
		}
	}
</style>

<script>
	const accountLinks = document.querySelectorAll('[data-account-link]');
	const profileLinks = document.querySelectorAll('[data-profile-link]');

	fetch('/api/auth/me', { credentials: 'include' }).then((response) => {
		if (response.ok) {
			accountLinks.forEach((link) => {
				link.textContent = 'Account';
				link.classList.remove('nav-cta');
				link.removeAttribute('data-account-link');
			});
			profileLinks.forEach((link) => {
				link.removeAttribute('data-profile-link');
			});
		}
	}).catch(() => {
		// Keep the sign-up link when auth state cannot be checked.
	});

	const menuToggle = document.querySelector('.menu-toggle');
	const navLinks = document.querySelector('#nav-links');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		navLinks?.classList.toggle('open', !expanded);
	});
	navLinks?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menuToggle?.setAttribute('aria-expanded', 'false');
		navLinks.classList.remove('open');
	}));
</script>
