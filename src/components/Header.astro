---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="mark" aria-hidden="true">
				<span></span><span></span><span></span><span></span>
			</span>
			{SITE_TITLE}
		</a>
		<div class="internal-links">
			<HeaderLink href="/#modes">Modes</HeaderLink>
			<HeaderLink href="/#systems">Systems</HeaderLink>
			<HeaderLink href="/#play">Play</HeaderLink>
			<HeaderLink href="/account/">Account</HeaderLink>
			<HeaderLink href="/profile/">Profile</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0 1.5em;
		background: rgba(10, 12, 16, 0.85);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.2em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
		font-family: "Rubik", sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text);
		letter-spacing: -0.01em;
	}
	.brand:hover { color: var(--text); }

	/* O-piece mark: a tight 2x2 block grid, matching the actual tetromino */
	.mark {
		display: grid;
		grid-template-columns: 7px 7px;
		grid-template-rows: 7px 7px;
		gap: 2px;
	}
	.mark span {
		background: var(--o);
		border-radius: 1.5px;
	}

	.internal-links {
		display: flex;
		gap: 0.4em;
	}
	.internal-links :global(a) {
		padding: 0.6em 0.9em;
		color: var(--dim);
		font-size: 0.92rem;
		font-weight: 500;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: var(--text);
		background: var(--panel);
	}
	@media (max-width: 720px) {
		header { padding: 0 0.8em; }
		nav { height: auto; min-height: 4.2em; }
		.internal-links { gap: 0; }
		.internal-links :global(a) { padding: 0.55em 0.45em; font-size: 0.8rem; }
	}
</style>
