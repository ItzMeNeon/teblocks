---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand" aria-label={SITE_TITLE}>
			<Logo size={30} />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<div class="nav-links" id="nav-links">
			<a href="/leaderboards/">Leaderboards</a>
			<a href="/skins/">Skins</a>
			<a href="/wiki/">Wiki</a>
			<span class="nav-divider" aria-hidden="true"></span>
			
			<button class="theme-toggle" aria-label="Toggle theme">
				<svg xmlns="http://www.w3.org/2000/svg" class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<svg xmlns="http://www.w3.org/2000/svg" class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>

			<a href="/login/" id="nav-account" class="nav-cta" data-account-toggle>Account</a>
		</div>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
			<span></span><span></span><span></span>
		</button>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: 0 1.4rem;
		background: var(--neu-bg);
		box-shadow: 0 4px 8px rgba(0,0,0,0.3);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 1120px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4rem;
		gap: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55em;
		font-weight: 800;
		font-size: 1.1rem;
		color: var(--text);
		letter-spacing: -0.01em;
		flex-shrink: 0;
	}
	.brand:hover {
		color: var(--text);
	}
	.brand-name {
		background: linear-gradient(120deg, #ffffff, var(--accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.nav-links a {
		padding: 0.55em 0.85em;
		color: var(--text-dim);
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 999px;
		transition: color 0.15s ease, background 0.15s ease;
		text-decoration: none;
	}
	.nav-links a:hover {
		color: var(--text);
		background: rgba(255, 255, 255, 0.05);
	}
	.nav-links a.active {
		color: var(--text);
	}
	.nav-links a.active::after {
		content: '';
		display: block;
		width: 20px;
		height: 2px;
		margin: 0.3em auto 0;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
	}

	.nav-divider {
		width: 1px;
		height: 1.4em;
		background: var(--border);
		margin: 0 0.35em;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		margin: 0 0.25em;
		border-radius: 50%;
		background: var(--neu-bg);
		border: 1px solid var(--border);
		box-shadow: 4px 4px 10px rgba(0,0,0,0.4), -4px -4px 10px rgba(255,255,255,0.05);
		cursor: pointer;
		color: var(--text);
		transition: all 0.2s ease;
	}
	:global([data-theme="light"]) .theme-toggle {
		box-shadow: 4px 4px 10px rgba(0,0,0,0.1), -4px -4px 10px rgba(255,255,255,0.8);
	}
	.theme-toggle:hover {
		box-shadow: inset 4px 4px 10px rgba(0,0,0,0.4), inset -4px -4px 10px rgba(255,255,255,0.05);
	}
	:global([data-theme="light"]) .theme-toggle:hover {
		box-shadow: inset 4px 4px 10px rgba(0,0,0,0.1), inset -4px -4px 10px rgba(255,255,255,0.8);
	}
	.theme-toggle .moon-icon { display: none; }
	.theme-toggle .sun-icon { display: block; }
	:global([data-theme="light"]) .theme-toggle .sun-icon { display: none; }
	:global([data-theme="light"]) .theme-toggle .moon-icon { display: block; }

	.nav-cta {
		background: var(--neu-bg);
		color: var(--accent) !important;
		font-weight: 700;
		border: 1px solid var(--border);
		box-shadow: 4px 4px 10px rgba(0,0,0,0.4), -4px -4px 10px rgba(255,255,255,0.05);
		margin-left: 0.25em;
	}
	:global([data-theme="light"]) .nav-cta {
		box-shadow: 4px 4px 10px rgba(0,0,0,0.1), -4px -4px 10px rgba(255,255,255,0.8);
	}
	.nav-cta:hover {
		filter: brightness(1.05);
		box-shadow: inset 4px 4px 10px rgba(0,0,0,0.4), inset -4px -4px 10px rgba(255,255,255,0.05);
	}
	:global([data-theme="light"]) .nav-cta:hover {
		box-shadow: inset 4px 4px 10px rgba(0,0,0,0.1), inset -4px -4px 10px rgba(255,255,255,0.8);
	}
	.nav-pill {
		border: 1px solid var(--border);
	}
	.nav-pill:hover {
		border-color: var(--border-bright);
		background: rgba(255, 255, 255, 0.05);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		gap: 4px;
		padding: 0.5em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: transparent;
		cursor: pointer;
	}
	.menu-toggle span {
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
	}

	@media (max-width: 760px) {
		header {
			padding: 0 0.9rem;
		}
		nav {
			position: relative;
			height: 4rem;
		}
		.menu-toggle {
			display: flex;
		}
		.nav-links {
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.6em 0.7em 0.8em;
			border-bottom: 1px solid var(--border);
			background: var(--neu-bg);
			box-shadow: 0 8px 16px rgba(0,0,0,0.3);
		}
		.nav-links.open {
			display: flex;
		}
		.nav-links a {
			padding: 0.7em 0.6em;
			font-size: 0.95rem;
			border-radius: 8px;
		}
		.nav-links a.active::after {
			display: none;
		}
		.nav-divider {
			width: 100%;
			height: 1px;
			margin: 0.4em 0;
		}
		.nav-cta {
			text-align: center;
			margin-left: 0;
			margin-top: 0.5em;
		}
		.theme-toggle {
			align-self: flex-start;
			margin: 0.4em 0;
		}
	}
</style>

<script>
	const accountToggle = document.getElementById('nav-account');
	const token = localStorage.getItem('teblocks_token');
	const headers = { 'Content-Type': 'application/json' };
	if (token) headers['Authorization'] = `Bearer ${token}`;

	fetch('https://backend.teblocks.my.id/api/auth/me', { headers })
		.then((response) => {
			if (response.ok && accountToggle) {
				accountToggle.textContent = 'Profile';
				accountToggle.setAttribute('href', '/profile/');
				accountToggle.classList.remove('nav-cta');
				accountToggle.classList.add('nav-pill');
				accountToggle.removeAttribute('data-account-toggle');
			}
		})
		.catch(() => {});

	const menuToggle = document.querySelector('.menu-toggle');
	const navLinks = document.querySelector('#nav-links');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		navLinks?.classList.toggle('open', !expanded);
	});
	navLinks?.querySelectorAll('a').forEach((link) =>
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			navLinks.classList.remove('open');
		})
	);

	// Theme Toggle
	const themeToggle = document.querySelector('.theme-toggle');
	const root = document.documentElement;
	const savedTheme = localStorage.getItem('teblocks_theme');
	const defaultTheme = savedTheme ? savedTheme : 'dark';
	
	root.setAttribute('data-theme', defaultTheme);

	themeToggle?.addEventListener('click', () => {
		const currentTheme = root.getAttribute('data-theme') || 'dark';
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', newTheme);
		localStorage.setItem('teblocks_theme', newTheme);
	});
</script>
