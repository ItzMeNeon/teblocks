---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand" aria-label={SITE_TITLE}>
			<Logo size={32} />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<div class="nav-links" id="nav-links">
			<a href="/leaderboards/">Leaderboards</a>
			<a href="/skins/">Skins</a>
			<a href="/wiki/">Wiki</a>
			<a href="/about/">About</a>
			<span class="nav-divider" aria-hidden="true"></span>
			
			<button class="theme-toggle" type="button" aria-label="Toggle theme">
				<svg xmlns="http://www.w3.org/2000/svg" class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<svg xmlns="http://www.w3.org/2000/svg" class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>

			<a href="/login/" id="nav-account" class="nav-cta" data-account-toggle>Account</a>
		</div>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation menu">
			<span></span><span></span><span></span>
		</button>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0 1.5rem;
		background: rgba(3, 7, 11, 0.82);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--border);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}
	:global([data-theme="light"]) header {
		background: rgba(255, 255, 255, 0.88);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	}
	nav {
		max-width: 1140px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.2rem;
		gap: 1.2em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--text);
		letter-spacing: -0.015em;
		flex-shrink: 0;
		text-decoration: none;
		transition: opacity var(--transition-fast);
	}
	.brand:hover {
		opacity: 0.9;
	}
	.brand-name {
		background: linear-gradient(120deg, var(--h1-grad-start) 20%, var(--accent) 90%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.35em;
	}
	.nav-links a {
		padding: 0.5em 0.9em;
		color: var(--text-dim);
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 999px;
		transition: all var(--transition-fast);
		text-decoration: none;
	}
	.nav-links a:hover {
		color: var(--text);
		background: rgba(62, 166, 195, 0.08);
	}
	:global([data-theme="light"]) .nav-links a:hover {
		background: rgba(2, 132, 199, 0.08);
	}

	.nav-divider {
		width: 1px;
		height: 1.4em;
		background: var(--border);
		margin: 0 0.4em;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		margin: 0 0.25em;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border);
		cursor: pointer;
		color: var(--text-dim);
		transition: all var(--transition-fast);
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--border-bright);
		background: rgba(62, 166, 195, 0.1);
		transform: scale(1.05);
	}
	.theme-toggle .moon-icon { display: none; }
	.theme-toggle .sun-icon { display: block; }
	:global([data-theme="light"]) .theme-toggle .sun-icon { display: none; }
	:global([data-theme="light"]) .theme-toggle .moon-icon { display: block; }

	.nav-cta {
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #00191c !important;
		font-weight: 700;
		padding: 0.48em 1.15em !important;
		border-radius: 999px;
		box-shadow: 0 2px 12px var(--accent-glow);
		margin-left: 0.35em;
		transition: all var(--transition-fast);
	}
	.nav-cta:hover {
		filter: brightness(1.08);
		box-shadow: 0 4px 18px var(--accent-glow-strong);
		transform: translateY(-1px);
	}

	.nav-pill {
		background: rgba(62, 166, 195, 0.1);
		color: var(--accent) !important;
		font-weight: 700;
		border: 1px solid var(--border);
		padding: 0.45em 1.1em !important;
	}
	.nav-pill:hover {
		background: rgba(62, 166, 195, 0.18);
		border-color: var(--border-bright);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 38px;
		height: 38px;
		padding: 0.5em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.04);
		cursor: pointer;
	}
	.menu-toggle span {
		display: block;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	@media (max-width: 760px) {
		header {
			padding: 0 1rem;
		}
		nav {
			position: relative;
			height: 4rem;
		}
		.menu-toggle {
			display: flex;
		}
		.nav-links {
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			right: 0;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0.3em;
			padding: 1rem;
			border-bottom: 1px solid var(--border);
			background: var(--bg-elevated);
			box-shadow: var(--shadow-lg);
			border-radius: 0 0 var(--radius) var(--radius);
		}
		.nav-links.open {
			display: flex;
		}
		.nav-links a {
			padding: 0.75em 1em;
			font-size: 0.95rem;
			border-radius: var(--radius-sm);
		}
		.nav-divider {
			width: 100%;
			height: 1px;
			margin: 0.5em 0;
		}
		.nav-cta {
			text-align: center;
			margin-left: 0;
			margin-top: 0.3em;
		}
		.theme-toggle {
			align-self: flex-start;
			margin: 0.3em 0;
		}
	}
</style>

<script>
	const accountToggle = document.getElementById('nav-account');
	const token = localStorage.getItem('teblocks_token');
	const headers = { 'Content-Type': 'application/json' };
	if (token) headers['Authorization'] = `Bearer ${token}`;

	fetch('https://backend.teblocks.my.id/api/auth/me', { headers })
		.then((response) => {
			if (response.ok && accountToggle) {
				accountToggle.textContent = 'Profile';
				accountToggle.setAttribute('href', '/profile/');
				accountToggle.classList.remove('nav-cta');
				accountToggle.classList.add('nav-pill');
				accountToggle.removeAttribute('data-account-toggle');
			}
		})
		.catch(() => {});

	const menuToggle = document.querySelector('.menu-toggle');
	const navLinks = document.querySelector('#nav-links');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		navLinks?.classList.toggle('open', !expanded);
	});
	navLinks?.querySelectorAll('a').forEach((link) =>
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			navLinks?.classList.remove('open');
		})
	);

	// Theme Toggle
	const themeToggle = document.querySelector('.theme-toggle');
	const root = document.documentElement;
	const savedTheme = localStorage.getItem('teblocks_theme');
	const defaultTheme = savedTheme ? savedTheme : 'dark';
	
	root.setAttribute('data-theme', defaultTheme);

	themeToggle?.addEventListener('click', () => {
		const currentTheme = root.getAttribute('data-theme') || 'dark';
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', newTheme);
		localStorage.setItem('teblocks_theme', newTheme);
	});
</script>
