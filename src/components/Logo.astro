---
interface Props {
	size?: number;
	class?: string;
}
const { size = 30, class: className = '' } = Astro.props;
---

<svg
	class:list={['logo-mark', className]}
	width={size}
	height={size}
	viewBox="0 0 32 32"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<defs>
		<linearGradient id="tb-block-top" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color="#38d3ff" />
			<stop offset="100%" stop-color="#00c2ff" />
		</linearGradient>
	</defs>
	<g class="logo-blocks">
		<!-- T-tetromino with clean arcade borders -->
		<rect x="3" y="6" width="8" height="8" rx="1.5" fill="url(#tb-block-top)" stroke="#0099cc" stroke-width="1" />
		<rect x="12" y="6" width="8" height="8" rx="1.5" fill="url(#tb-block-top)" stroke="#0099cc" stroke-width="1" />
		<rect x="21" y="6" width="8" height="8" rx="1.5" fill="url(#tb-block-top)" stroke="#0099cc" stroke-width="1" />
		<rect x="12" y="15" width="8" height="8" rx="1.5" fill="url(#tb-block-top)" stroke="#0099cc" stroke-width="1" />
	</g>
</svg>

<style>
	.logo-mark {
		display: block;
		flex-shrink: 0;
	}
	.logo-blocks {
		transition: transform 0.15s ease;
	}
	.logo-mark:hover .logo-blocks {
		transform: scale(1.05);
	}
</style>
