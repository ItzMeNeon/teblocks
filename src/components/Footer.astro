---
const today = new Date();
---

<footer>
	<div class="row">
		<span class="mark" aria-hidden="true">
			<span></span><span></span><span></span><span></span>
		</span>
		<p>&copy; {today.getFullYear()} TeBlocks. Built solo.</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1.5em 5em;
		border-top: 1px solid var(--line);
	}
	.row {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 0.7em;
	}
	.mark {
		display: grid;
		grid-template-columns: 6px 6px;
		grid-template-rows: 6px 6px;
		gap: 2px;
		opacity: 0.6;
	}
	.mark span {
		background: var(--dim-2);
		border-radius: 1.5px;
	}
	p {
		margin: 0;
		font-size: 0.85rem;
		color: var(--dim-2);
		font-family: "JetBrains Mono", monospace;
	}
</style>
