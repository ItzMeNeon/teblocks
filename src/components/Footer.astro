---
const today = new Date();
---

<footer>
	<div class="row">
		<span class="mark" aria-hidden="true">
			<span></span><span></span><span></span><span></span>
		</span>
		<p>&copy; {today.getFullYear()} TeBlocks. Built solo.</p>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1.5em 4em;
		border-top: 1px solid var(--border);
	}
	.row {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.mark {
		display: grid;
		grid-template-columns: 5px 5px;
		grid-template-rows: 5px 5px;
		gap: 1.5px;
		opacity: 0.5;
	}
	.mark span {
		background: var(--accent);
		border-radius: 1px;
	}
	p {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}
</style>
