---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Wiki | ${SITE_TITLE}`} description="Rules, controls, and how to play TeBlocks." />
		<style>
			.wiki-panel { max-width: 820px; margin: 3em auto 0; }
			.wiki-panel h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.6rem); }
			.wiki-panel > p { margin: .4rem 0 1.6rem; color: var(--text-muted); }
			.wiki-section {
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--panel);
				padding: 1.6em;
				margin-bottom: 1em;
			}
			.wiki-section h2 { margin: 0 0 .6rem; font-size: 1.25rem; }
			.wiki-section p { margin: .4rem 0; color: var(--text-dim); line-height: 1.7; }
			.wiki-section ul { margin: .4rem 0; padding-left: 1.4rem; color: var(--text-dim); }
			.wiki-section li { margin: .25rem 0; }
			.coming-soon { color: var(--text-muted); font-style: italic; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="wiki-panel" aria-labelledby="wiki-title">
				<h1 id="wiki-title">Wiki</h1>
				<p>Rules, controls, and everything you need to know about TeBlocks.</p>

				<article class="wiki-section" aria-labelledby="how-to-play">
					<h2 id="how-to-play">How to play</h2>
					<p class="coming-soon">This section is being written. Check back soon.</p>
				</article>

				<article class="wiki-section" aria-labelledby="controls">
					<h2 id="controls">Controls</h2>
					<p class="coming-soon">Key bindings and control customization will be documented here.</p>
				</article>

				<article class="wiki-section" aria-labelledby="rules">
					<h2 id="rules">Rules</h2>
					<p class="coming-soon">Mode rules, scoring, and competitive formats will be explained here.</p>
				</article>

				<article class="wiki-section" aria-labelledby="modes">
					<h2 id="modes">Modes</h2>
					<p class="coming-soon">A breakdown of each game mode will be added later.</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
