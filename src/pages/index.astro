---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — competitive block stacking`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero" id="play" aria-labelledby="hero-title">
				<div class="hero-content">
				<p class="eyebrow" style="--accent-color: var(--accent)">Built on Techmino · Server-authoritative · SRS</p>
				<h1 id="hero-title">Stack fast.<br />Play fair.</h1>
				<p class="lede">
					A competitive block-stacking game built on Techmino — real SRS rotation and wall kicks,
					a fair 7-bag randomizer, and a server that never trusts the client. Climb the ranked
					ladder, drop into Casual MP rooms, or chase records in Minigames.
				</p>
					<div class="hero-cta">
						<a class="btn btn-primary btn-lg" href="#download">Download client</a>
						<a class="btn btn-secondary btn-lg" href="/leaderboards/">Leaderboards</a>
					</div>
				</div>
			<div class="hero-board">
				<div class="hero-glow"></div>
				<div class="hero-video-frame">
					<video
						id="hero-video"
						class="hero-video"
						autoplay
						loop
						muted
						playsinline
						preload="auto"
						aria-label="TeBlocks gameplay preview"
					>
						<source src="/media/teblockspreview.webm" type="video/webm" />
					</video>
				</div>
			</div>
			</section>

			<!-- PLAYERS ONLINE NOW -->
			<section class="section online" id="online" aria-labelledby="online-title">
				<div class="section-header">
					<p class="eyebrow" style="--accent-color: var(--accent)">Live</p>
					<h2 id="online-title">Players online now</h2>
					<p>Who's stacking right this second — updated in real time.</p>
				</div>
				<div class="online-grid">
					<div class="online-stat panel">
						<div class="online-count" id="online-count">—</div>
						<div class="online-count-label">players playing</div>
						<svg id="online-graph" viewBox="0 0 600 160" preserveAspectRatio="none" role="img" aria-label="Players online over time">
							<defs>
								<linearGradient id="graph-fill" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0" stop-color="rgba(46,230,255,0.35)" />
									<stop offset="1" stop-color="rgba(46,230,255,0)" />
								</linearGradient>
							</defs>
							<path id="online-area" fill="url(#graph-fill)" stroke="none" d="" />
							<polyline id="online-line" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" points="" />
							<circle id="online-dot" r="4" fill="var(--accent)" cx="0" cy="0" />
						</svg>
					</div>
					<div class="online-list panel" aria-label="Online players">
						<div class="online-list-head">In the lobby</div>
						<ul id="online-players" class="online-players">
							<li class="online-empty">No one online right now — be the first.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- MODES -->
			<section class="section" id="modes" aria-labelledby="modes-title">
				<div class="section-header">
					<p class="eyebrow" style="--accent-color: var(--accent-2)">Modes</p>
					<h2 id="modes-title">Ways to play</h2>
				</div>
				<div class="mode-grid">
					<article class="mode-card panel panel-hover">
						<div class="mode-icon" style="--mode-color: var(--z)"></div>
						<h3>Ranked</h3>
						<p>Strict 1v1 matchmaking with rating stakes. Climb the competitive ladder with promotion, demotion, and a leaderboard that means something.</p>
						<span class="mode-tag">Competitive</span>
					</article>
					<article class="mode-card panel panel-hover">
						<div class="mode-icon" style="--mode-color: var(--i)"></div>
						<h3>Casual MP</h3>
						<p>Make a room or jump into someone else's. Play with everyone — no rating pressure, just drop in and stack together.</p>
						<span class="mode-tag">Multiplayer</span>
					</article>
					<article class="mode-card panel panel-hover">
						<div class="mode-icon" style="--mode-color: var(--o)"></div>
						<h3>Minigames</h3>
						<p>Bite-sized challenges: 40 Lines, Sprint, and Missions. Chase your best time and high score at your own pace.</p>
						<span class="mode-tag">Single-player</span>
					</article>
					<article class="mode-card panel panel-hover">
						<div class="mode-icon" style="--mode-color: var(--t)"></div>
						<h3>Battle Royale</h3>
						<p>100 players, one board each, elimination targeting. Last stack standing wins.</p>
						<span class="mode-tag">Survival</span>
					</article>
				</div>
			</section>

			<!-- DOWNLOAD -->
			<section class="section download" id="download" aria-labelledby="download-title">
				<div class="download-card panel">
					<div class="download-copy">
						<p class="eyebrow" style="--accent-color: var(--accent)">Get the game</p>
						<h2 id="download-title">Download TeBlocks</h2>
						<p>Grab the client and jump into ranked. Free, cross-platform, and light enough to run anywhere.</p>
						<a class="btn btn-primary btn-lg" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener">Download for free</a>
					</div>
					<div class="download-platforms">
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener">
							<span class="platform-name">Windows</span><span class="platform-meta">.exe · 64-bit</span>
						</a>
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener">
							<span class="platform-name">macOS</span><span class="platform-meta">.app · Universal</span>
						</a>
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener">
							<span class="platform-name">Linux</span><span class="platform-meta">.AppImage · 64-bit</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// ----- Live "players online" graph + list -----
			const onlineCount = document.getElementById('online-count');
			const onlineLine = document.getElementById('online-line');
			const onlineArea = document.getElementById('online-area');
			const onlineDot = document.getElementById('online-dot');
			const onlineList = document.getElementById('online-players');

			const GRAPH_W = 600;
			const GRAPH_H = 160;
			const GRAPH_PAD = 10;
			const GRAPH_MAX_POINTS = 120;
			let graphHistory = [];

			function renderGraph(series) {
				if (!onlineLine || !onlineArea || !onlineDot) return;
				const data = series && series.length ? series : [0];
				const max = Math.max(5, ...data);
				const min = Math.min(...data, 0);
				const n = data.length;
				const x = (i) => GRAPH_PAD + (n === 1 ? (GRAPH_W - 2 * GRAPH_PAD) / 2 : (i / (n - 1)) * (GRAPH_W - 2 * GRAPH_PAD));
				const y = (v) => GRAPH_H - GRAPH_PAD - ((v - min) / ((max - min) || 1)) * (GRAPH_H - 2 * GRAPH_PAD);
				const pts = data.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
				if (n === 1) {
					const yy = y(data[0]).toFixed(1);
					onlineLine.setAttribute('points', `${GRAPH_PAD},${yy} ${GRAPH_W - GRAPH_PAD},${yy}`);
					onlineArea.setAttribute('d', `M ${GRAPH_PAD},${GRAPH_H - GRAPH_PAD} L ${GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', String((GRAPH_W) / 2));
					onlineDot.setAttribute('cy', yy);
				} else {
					onlineLine.setAttribute('points', pts);
					onlineArea.setAttribute('d', `M ${x(0).toFixed(1)},${GRAPH_H - GRAPH_PAD} L ${pts.replace(/ /g, ' L ')} L ${x(n - 1).toFixed(1)},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', x(n - 1).toFixed(1));
					onlineDot.setAttribute('cy', y(data[n - 1]).toFixed(1));
				}
			}

			function renderList(players) {
				if (!onlineList) return;
				if (!players || !players.length) {
					onlineList.innerHTML = '<li class="online-empty">No one online right now — be the first.</li>';
					return;
				}
				const hue = (s) => {
					let h = 0;
					for (let i = 0; i < s.length; i += 1) h = (h * 31 + s.charCodeAt(i)) % 360;
					return h;
				};
				onlineList.replaceChildren(
					...players.slice(0, 12).map((p) => {
						const li = document.createElement('li');
						li.className = 'online-player';
						const h = hue(p.username || p.id || 'x');
						li.innerHTML = `<span class="online-avatar" style="background:linear-gradient(135deg,hsl(${h} 80% 60%),hsl(${(h + 40) % 360} 80% 55%))">${(p.username || '?').slice(0, 1).toUpperCase()}</span><span class="online-name">${p.username || 'Unknown'}</span><span class="online-rating">${p.rating || 0}</span>`;
						return li;
					})
				);
			}

			async function loadOnline() {
				try {
					const res = await fetch('/api/players/online', { cache: 'no-store' });
					if (!res.ok) return;
					const body = await res.json();
					const count = body.count ?? 0;
					if (onlineCount) onlineCount.textContent = count.toLocaleString();
					const serverHistory = Array.isArray(body.history) ? body.history : [];
					if (!graphHistory.length && serverHistory.length) {
						graphHistory = serverHistory.slice(-GRAPH_MAX_POINTS);
					}
					graphHistory.push(count);
					if (graphHistory.length > GRAPH_MAX_POINTS) graphHistory.shift();
					renderGraph(graphHistory);
					renderList(body.players);
				} catch {
					/* keep last good values */
				}
			}
			loadOnline();
			setInterval(loadOnline, 15000);
		</script>


		<style>
			/* ---------- HERO ---------- */
			.hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				align-items: center;
				gap: 3rem;
				padding: 5rem 0 4rem;
				min-height: 64vh;
			}
			.hero-content { max-width: 60ch; }
			.hero-content .lede {
				font-size: 1.12rem;
				color: var(--text-dim);
				line-height: 1.7;
				margin: 1.5rem 0 2rem;
			}
			.hero-cta {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.hero-board {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.hero-glow {
				position: absolute;
				inset: -10% 10% 10% -10%;
				background: radial-gradient(closest-side, rgba(46, 230, 255, 0.22), transparent 70%);
				filter: blur(20px);
				z-index: 0;
			}
			.hero-video-frame {
				position: relative;
				z-index: 1;
				width: auto;
				max-width: 100%;
				border-radius: 18px;
				overflow: hidden;
				border: 1px solid var(--border-bright);
				background: rgba(8, 12, 22, 0.7);
				box-shadow: var(--shadow), 0 0 0 1px rgba(46, 230, 255, 0.08);
			}
			.hero-video {
				display: block;
				width: auto;
				height: auto;
				max-width: 100%;
				max-height: 70vh;
				object-fit: contain;
			}
			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
					padding: 3rem 0 2.5rem;
					min-height: auto;
					text-align: center;
				}
				.hero-content { max-width: 100%; }
				.hero-cta { justify-content: center; }
				.hero-board { order: -1; }
			}

			/* ---------- SECTION HEADER ---------- */
			.section-header { text-align: center; max-width: 60ch; margin: 0 auto 3rem; }
			.section-header .eyebrow { justify-content: center; }
			.section-header h2 { margin-bottom: 0.5rem; }
			.section-header p { color: var(--text-muted); font-size: 1.05rem; }

			/* ---------- PLAYERS ONLINE ---------- */
			.online-grid {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 1.5rem;
				align-items: stretch;
			}
			.online-stat {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			.online-count {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(3rem, 8vw, 5rem);
				line-height: 1;
				background: linear-gradient(120deg, #ffffff, var(--accent));
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.online-count-label {
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				margin-bottom: 1rem;
			}
			#online-graph {
				width: 100%;
				height: 160px;
				display: block;
				margin-top: auto;
			}
			.online-list {
				padding: 1.4rem 1.5rem;
				display: flex;
				flex-direction: column;
			}
			.online-list-head {
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-muted);
				font-family: var(--font-mono);
				margin-bottom: 1rem;
			}
			.online-players {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				overflow-y: auto;
				max-height: 240px;
			}
			.online-player {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.4rem 0.5rem;
				border-radius: 10px;
				transition: background var(--transition-fast);
			}
			.online-player:hover { background: rgba(255, 255, 255, 0.04); }
			.online-avatar {
				width: 32px;
				height: 32px;
				border-radius: 9px;
				display: grid;
				place-items: center;
				font-weight: 800;
				color: #04121a;
				font-size: 0.85rem;
				flex-shrink: 0;
			}
			.online-name {
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				font-weight: 600;
				font-size: 0.92rem;
			}
			.online-rating {
				font-family: var(--font-mono);
				font-weight: 700;
				font-size: 0.82rem;
				color: var(--accent);
			}
			.online-empty {
				color: var(--text-muted);
				font-size: 0.9rem;
				padding: 0.5rem;
			}
			@media (max-width: 820px) {
				.online-grid { grid-template-columns: 1fr; }
			}

			/* ---------- MODES ---------- */
			.mode-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.5rem;
			}
			.mode-card {
				display: flex;
				flex-direction: column;
				padding: 2rem;
				gap: 1rem;
			}
			.mode-icon {
				width: 50px;
				height: 50px;
				border-radius: 14px;
				background: linear-gradient(135deg, var(--mode-color), color-mix(in srgb, var(--mode-color) 65%, #000));
				box-shadow: 0 0 26px color-mix(in srgb, var(--mode-color) 45%, transparent);
				flex-shrink: 0;
			}
			.mode-card h3 { font-size: 1.3rem; margin: 0.25rem 0 0; }
			.mode-card p {
				margin: 0;
				font-size: 0.95rem;
				color: var(--text-dim);
				line-height: 1.6;
				flex: 1;
			}
			.mode-tag {
				align-self: flex-start;
				padding: 0.35rem 0.75rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid var(--border);
				font-family: var(--font-mono);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--text-muted);
			}
			@media (max-width: 820px) {
				.mode-grid { grid-template-columns: 1fr; }
			}

			/* ---------- DOWNLOAD ---------- */
			.download-card {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 2rem;
				padding: 2.5rem;
				align-items: center;
				background:
					radial-gradient(600px 300px at 100% 0%, rgba(79, 140, 255, 0.14), transparent 60%),
					var(--panel);
			}
			.download-copy h2 { margin-bottom: 0.5rem; }
			.download-copy p { color: var(--text-dim); margin: 0 0 1.5rem; max-width: 42ch; }
			.download-platforms {
				display: flex;
				flex-direction: column;
				gap: 0.7rem;
			}
			.platform {
				display: flex;
				flex-direction: column;
				padding: 0.9rem 1.1rem;
				border-radius: 12px;
				border: 1px solid var(--border);
				transition: all var(--transition-fast);
			}
			.platform:hover {
				border-color: var(--border-bright);
				background: rgba(255, 255, 255, 0.04);
				transform: translateX(2px);
			}
			.platform-name { font-weight: 700; font-size: 1rem; }
			.platform-meta { color: var(--text-muted); font-size: 0.8rem; font-family: var(--font-mono); }
			@media (max-width: 820px) {
				.download-card { grid-template-columns: 1fr; }
			}
		</style>
	</body>
</html>
