---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — competitive block stacking`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero" id="play" aria-labelledby="hero-title">
				<div class="tetromino-particles" aria-hidden="true">
					<i style="--c: var(--i); left: 10%; animation-duration: 15s; animation-delay: -2s;"></i>
					<i style="--c: var(--o); left: 25%; animation-duration: 22s; animation-delay: -5s;"></i>
					<i style="--c: var(--t); left: 40%; animation-duration: 18s; animation-delay: -1s;"></i>
					<i style="--c: var(--s); left: 55%; animation-duration: 25s; animation-delay: -8s;"></i>
					<i style="--c: var(--z); left: 70%; animation-duration: 19s; animation-delay: -4s;"></i>
					<i style="--c: var(--j); left: 85%; animation-duration: 21s; animation-delay: -10s;"></i>
					<i style="--c: var(--l); left: 95%; animation-duration: 16s; animation-delay: -6s;"></i>
				</div>
				<div class="hero-content">
					<p class="eyebrow" style="--accent-color: var(--accent)">Built on Techmino · Real-Time SRS · 7-Bag</p>
					<h1 id="hero-title">Stack fast.<br />Play fair.</h1>
					<p class="lede">
						A competitive block-stacking game built on Techmino — real SRS rotation and wall kicks,
						a fair 7-bag randomizer, and fast responsive multiplayer. Climb the ranked
						ladder, drop into casual rooms, take on the Daily Challenge, or chase personal records in minigames.
					</p>
					<div class="hero-cta">
						<a class="btn btn-primary btn-lg" href="#download">Download client</a>
						<a class="btn btn-secondary btn-lg" href="/leaderboards/">View leaderboards</a>
					</div>
				</div>
				<div class="hero-board">
					<div class="hero-glow"></div>
					<div class="hero-video-frame">
						<video
							id="hero-video"
							class="hero-video"
							autoplay
							loop
							muted
							playsinline
							preload="metadata"
							aria-label="TeBlocks gameplay preview"
						>
							<source src="/media/teblockspreview.webm" type="video/webm" />
						</video>
					</div>
				</div>
			</section>

			<!-- COMMUNITY STATS -->
			<section class="section stats-banner">
				<div class="stats-panel panel">
					<div class="stat-item">
						<span class="stat-icon">🎮</span>
						<div class="stat-text">
							<span class="stat-value" id="stat-registered">—</span>
							<span class="stat-label">Players Registered</span>
						</div>
					</div>
					<div class="stat-item">
						<span class="stat-icon">⚔️</span>
						<div class="stat-text">
							<span class="stat-value" id="stat-matches">—</span>
							<span class="stat-label">Matches Played</span>
						</div>
					</div>
					<div class="stat-item">
						<span class="stat-icon">📊</span>
						<div class="stat-text">
							<span class="stat-value" id="stat-online">—</span>
							<span class="stat-label">Online Now</span>
						</div>
					</div>
				</div>
			</section>

			<!-- PLAYERS ONLINE NOW -->
			<section class="section online" id="online" aria-labelledby="online-title">
				<div class="section-header">
					<p class="eyebrow" style="--accent-color: var(--accent)">Live</p>
					<h2 id="online-title">Players online now</h2>
					<p>Who's stacking right this second — updated in real time.</p>
				</div>
				<div class="online-grid">
					<div class="online-stat panel">
						<div class="online-stat-top">
							<div>
								<div class="online-count" id="online-count">—</div>
								<div class="online-count-label">players playing</div>
							</div>
							<div class="online-live-badge">
								<span class="live-pulse"></span>
								<span>LIVE</span>
							</div>
						</div>
						<div class="online-graph-frame">
							<svg id="online-graph" viewBox="0 0 600 160" preserveAspectRatio="none" role="img" aria-label="Players online over time">
								<defs>
									<linearGradient id="graph-fill" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35" />
										<stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0" />
									</linearGradient>
								</defs>
								<path id="online-area" fill="url(#graph-fill)" stroke="none" d="" />
								<polyline id="online-line" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" points="" />
								<circle id="online-dot" r="4.5" fill="var(--accent-2)" stroke="var(--bg)" stroke-width="2" cx="0" cy="0" />
							</svg>
						</div>
					</div>
					<div class="online-list panel" aria-label="Online players">
						<div class="online-list-head">
							<span>In the lobby</span>
							<span class="online-badge-count" id="online-lobby-count">0</span>
						</div>
						<ul id="online-players" class="online-players">
							<li class="online-empty">No one online right now — be the first to jump in.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- MODES -->
			<section class="section" id="modes" aria-labelledby="modes-title">
				<div class="section-header">
					<p class="eyebrow" style="--accent-color: var(--accent-2)">Modes</p>
					<h2 id="modes-title">Ways to play</h2>
					<p>Engineered for casual speedruns and high-stakes 1v1 duels alike.</p>
				</div>
				<div class="mode-grid">
					<article class="mode-card panel">
						<div class="mode-accent-bar" style="--card-color: var(--z)"></div>
						<div class="mode-icon" style="--mode-color: var(--z)">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
						</div>
						<h3>Ranked 1v1</h3>
						<p>Strict 1v1 matchmaking with rating stakes. Climb the competitive ladder with promotion, demotion, and an ELO leaderboard that rewards mastery.</p>
						<span class="mode-tag" style="--tag-color: var(--z)">Competitive · ELO</span>
					</article>
					<article class="mode-card panel">
						<div class="mode-accent-bar" style="--card-color: var(--i)"></div>
						<div class="mode-icon" style="--mode-color: var(--i)">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
							</svg>
						</div>
						<h3>Casual MP</h3>
						<p>Host custom rooms or drop into an open lobby. Play with friends without rating pressure, test out custom rulesets, or practice together.</p>
						<span class="mode-tag" style="--tag-color: var(--i)">Multiplayer · Free</span>
					</article>
					<article class="mode-card panel">
						<div class="mode-accent-bar" style="--card-color: var(--s)"></div>
						<div class="mode-icon" style="--mode-color: var(--s)">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
						</div>
						<h3>Daily Challenge</h3>
						<p>A fresh seeded puzzle challenge every single day. Everyone plays the exact same seed on global daily leaderboards to test their optimal stacking.</p>
						<span class="mode-tag" style="--tag-color: var(--s)">Daily · Global Seed</span>
					</article>
					<article class="mode-card panel">
						<div class="mode-accent-bar" style="--card-color: var(--o)"></div>
						<div class="mode-icon" style="--mode-color: var(--o)">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
						</div>
						<h3>Minigames</h3>
						<p>Speedrun modes to hone your mechanics: Sprint 40 Lines, Sprint 100L, Ultra 2-minute score attack, and custom handling practice rooms.</p>
						<span class="mode-tag" style="--tag-color: var(--o)">Single-player · Sprint</span>
					</article>
				</div>
			</section>

			<!-- LATEST NEWS -->
			<section class="section news" id="news" aria-labelledby="news-title">
				<div class="section-header">
					<p class="eyebrow" style="--accent-color: var(--accent)">Updates</p>
					<h2 id="news-title">Latest news</h2>
				</div>
				<div class="news-strip">
					{posts.map((post) => (
						<a href={`/blog/${post.slug}/`} class="news-card panel">
							<div class="news-card-content">
								<h3>{post.data.title}</h3>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric'
									})}
								</time>
							</div>
							<span class="news-read-more">Read more &rarr;</span>
						</a>
					))}
				</div>
			</section>

			<!-- DOWNLOAD -->
			<section class="section download" id="download" aria-labelledby="download-title">
				<div class="download-card panel">
					<div class="download-copy">
						<p class="eyebrow" style="--accent-color: var(--accent)">Get the client</p>
						<h2 id="download-title">Ready to play?</h2>
						<p>Free, lightweight, and cross-platform. Download TeBlocks for your system and start stacking in seconds.</p>
						<a class="btn btn-primary btn-lg" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Download for free
						</a>
					</div>
					<div class="download-platforms">
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-info">
								<span class="platform-name">Windows</span>
								<span class="platform-meta">64-bit installer & portable (.exe)</span>
							</div>
							<span class="platform-arrow">→</span>
						</a>
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-info">
								<span class="platform-name">Android</span>
								<span class="platform-meta">APK package & mobile build (.apk)</span>
							</div>
							<span class="platform-arrow">→</span>
						</a>
						<a class="platform" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-info">
								<span class="platform-name">Linux</span>
								<span class="platform-meta">AppImage & tarball (x86_64)</span>
							</div>
							<span class="platform-arrow">→</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// ----- Live "players online" graph + list -----
			const onlineCount = document.getElementById('online-count');
			const onlineLine = document.getElementById('online-line');
			const onlineArea = document.getElementById('online-area');
			const onlineDot = document.getElementById('online-dot');
			const onlineList = document.getElementById('online-players');
			const onlineLobbyCount = document.getElementById('online-lobby-count');

			const GRAPH_W = 600;
			const GRAPH_H = 160;
			const GRAPH_PAD = 12;
			const GRAPH_MAX_POINTS = 120;
			let graphHistory = [];

			function renderGraph(series) {
				if (!onlineLine || !onlineArea || !onlineDot) return;
				const data = series && series.length ? series : [0];
				const max = Math.max(5, ...data);
				const min = Math.min(...data, 0);
				const n = data.length;
				const x = (i) => GRAPH_PAD + (n === 1 ? (GRAPH_W - 2 * GRAPH_PAD) / 2 : (i / (n - 1)) * (GRAPH_W - 2 * GRAPH_PAD));
				const y = (v) => GRAPH_H - GRAPH_PAD - ((v - min) / ((max - min) || 1)) * (GRAPH_H - 2 * GRAPH_PAD);
				const pts = data.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
				if (n === 1) {
					const yy = y(data[0]).toFixed(1);
					onlineLine.setAttribute('points', `${GRAPH_PAD},${yy} ${GRAPH_W - GRAPH_PAD},${yy}`);
					onlineArea.setAttribute('d', `M ${GRAPH_PAD},${GRAPH_H - GRAPH_PAD} L ${GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', String((GRAPH_W) / 2));
					onlineDot.setAttribute('cy', yy);
				} else {
					onlineLine.setAttribute('points', pts);
					onlineArea.setAttribute('d', `M ${x(0).toFixed(1)},${GRAPH_H - GRAPH_PAD} L ${pts.replace(/ /g, ' L ')} L ${x(n - 1).toFixed(1)},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', x(n - 1).toFixed(1));
					onlineDot.setAttribute('cy', y(data[n - 1]).toFixed(1));
				}
			}

			function renderList(players) {
				if (!onlineList) return;
				if (!players || !players.length) {
					onlineList.innerHTML = '<li class="online-empty">No one online right now — be the first to jump in.</li>';
					if (onlineLobbyCount) onlineLobbyCount.textContent = '0';
					return;
				}
				if (onlineLobbyCount) onlineLobbyCount.textContent = String(players.length);
				const hue = (s) => {
					let h = 0;
					for (let i = 0; i < s.length; i += 1) h = (h * 31 + s.charCodeAt(i)) % 360;
					return h;
				};
				onlineList.replaceChildren(
					...players.slice(0, 12).map((p) => {
						const li = document.createElement('li');
						li.className = 'online-player';
						const h = hue(p.username || p.id || 'x');
						li.innerHTML = `
							<span class="online-avatar" style="background:linear-gradient(135deg,hsl(${h} 80% 60%),hsl(${(h + 40) % 360} 80% 55%))">
								${(p.username || '?').slice(0, 1).toUpperCase()}
							</span>
							<span class="online-name">${p.username || 'Unknown'}</span>
							<span class="online-rating">${p.rating || 0}</span>
						`;
						return li;
					})
				);
			}

			async function loadOnline() {
				try {
					const res = await fetch('/api/players/online', { cache: 'no-store' });
					if (!res.ok) return;
					const body = await res.json();
					const count = body.count ?? 0;
					if (onlineCount) onlineCount.textContent = count.toLocaleString();
					const serverHistory = Array.isArray(body.history) ? body.history : [];
					if (!graphHistory.length && serverHistory.length) {
						graphHistory = serverHistory.slice(-GRAPH_MAX_POINTS);
					}
					graphHistory.push(count);
					if (graphHistory.length > GRAPH_MAX_POINTS) graphHistory.shift();
					renderGraph(graphHistory);
					renderList(body.players);
				} catch {
					/* keep last good values */
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					loadOnline();
					setInterval(loadOnline, 15000);
				});
			} else {
				loadOnline();
				setInterval(loadOnline, 15000);
			}

			function animateValue(id, start, end, duration) {
				if (start === end) return;
				const obj = document.getElementById(id);
				if (!obj) return;
				let startTimestamp = null;
				const step = (timestamp) => {
					if (!startTimestamp) startTimestamp = timestamp;
					const progress = Math.min((timestamp - startTimestamp) / duration, 1);
					obj.textContent = Math.floor(progress * (end - start) + start).toLocaleString();
					if (progress < 1) {
						window.requestAnimationFrame(step);
					}
				};
				window.requestAnimationFrame(step);
			}

			async function loadCommunityStats() {
				try {
					const [onlineRes, lbRes] = await Promise.all([
						fetch('/api/players/online', { cache: 'no-store' }).catch(() => null),
						fetch('/api/leaderboards', { cache: 'no-store' }).catch(() => null)
					]);

					let onlineCount = 0;
					let registeredCount = 0;
					let matchesCount = 0;

					if (onlineRes && onlineRes.ok) {
						const data = await onlineRes.json();
						if (data.count !== undefined) onlineCount = data.count;
						if (data.totalRegistered !== undefined) registeredCount = data.totalRegistered;
						if (data.totalMatches !== undefined) matchesCount = data.totalMatches;
					}
					
					if (lbRes && lbRes.ok) {
						const data = await lbRes.json();
						if (data.totalPlayers !== undefined) registeredCount = data.totalPlayers;
						if (data.totalMatches !== undefined) matchesCount = data.totalMatches;
					}

					if (document.getElementById('stat-registered') && registeredCount > 0) {
						animateValue('stat-registered', 0, registeredCount, 2000);
					}
					if (document.getElementById('stat-matches') && matchesCount > 0) {
						animateValue('stat-matches', 0, matchesCount, 2000);
					}
					if (document.getElementById('stat-online') && onlineCount >= 0) {
						animateValue('stat-online', 0, onlineCount, 2000);
					}
				} catch (e) {}
			}
			
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', loadCommunityStats);
			} else {
				loadCommunityStats();
			}
		</script>

		<style>
			/* ---------- HERO ---------- */
			.hero {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				align-items: center;
				gap: 3.5rem;
				padding: 5rem 0 4.5rem;
				min-height: 64vh;
			}
			.hero-content { max-width: 60ch; }
			.hero-content .lede {
				font-size: 1.12rem;
				color: var(--text-dim);
				line-height: 1.7;
				margin: 1.5rem 0 2.2rem;
			}
			.hero-cta {
				display: flex;
				gap: 1.1rem;
				flex-wrap: wrap;
			}
			.hero-board {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.hero-glow {
				position: absolute;
				inset: -15% -10% -10% -15%;
				background: radial-gradient(closest-side, rgba(62, 166, 195, 0.22), transparent 75%);
				filter: blur(35px);
				z-index: 0;
				pointer-events: none;
			}
			.hero-video-frame {
				position: relative;
				z-index: 1;
				width: 100%;
				max-width: 520px;
				border-radius: 20px;
				overflow: hidden;
				border: 1px solid var(--border-bright);
				background: var(--bg-elevated);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), 0 0 35px var(--accent-glow);
				aspect-ratio: 4 / 3;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.hero-video {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
					padding: 3rem 0 2.5rem;
					min-height: auto;
					text-align: center;
					gap: 2.5rem;
				}
				.hero-content { max-width: 100%; }
				.hero-cta { justify-content: center; }
				.hero-board { order: -1; }
				.hero-video-frame { max-width: 440px; margin: 0 auto; }
			}

			/* ---------- SECTION HEADER ---------- */
			.section-header { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
			.section-header .eyebrow { justify-content: center; }
			.section-header h2 { margin-bottom: 0.5rem; }
			.section-header p { color: var(--text-muted); font-size: 1.05rem; }

			/* ---------- PLAYERS ONLINE ---------- */
			.online-grid {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 1.8rem;
				align-items: stretch;
			}
			.online-stat {
				padding: 2.2rem;
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				border-radius: var(--radius-lg);
				position: relative;
				overflow: hidden;
			}
			.online-stat-top {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
			}
			.online-count {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(3rem, 7vw, 4.8rem);
				line-height: 1;
				background: linear-gradient(120deg, var(--h1-grad-start), var(--accent));
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.online-count-label {
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				margin-top: 0.4rem;
			}
			.online-live-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.3em 0.75em;
				border-radius: 999px;
				background: rgba(91, 250, 128, 0.1);
				border: 1px solid rgba(91, 250, 128, 0.3);
				color: var(--success);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.08em;
			}
			.live-pulse {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--success);
				box-shadow: 0 0 0 3px var(--success-glow);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0% { transform: scale(0.95); opacity: 0.8; }
				50% { transform: scale(1.15); opacity: 1; }
				100% { transform: scale(0.95); opacity: 0.8; }
			}
			.online-graph-frame {
				width: 100%;
				height: 160px;
				margin-top: auto;
				border-radius: 12px;
				background: rgba(0, 0, 0, 0.25);
				border: 1px solid var(--border);
				padding: 10px;
				display: flex;
				align-items: center;
			}
			#online-graph {
				width: 100%;
				height: 100%;
				display: block;
			}
			.online-list {
				padding: 1.8rem;
				display: flex;
				flex-direction: column;
				border-radius: var(--radius-lg);
			}
			.online-list-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-muted);
				font-family: var(--font-mono);
				margin-bottom: 1.1rem;
			}
			.online-badge-count {
				background: rgba(62, 166, 195, 0.12);
				color: var(--accent);
				padding: 0.15em 0.55em;
				border-radius: 999px;
				font-weight: 700;
			}
			.online-players {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				overflow-y: auto;
				max-height: 250px;
			}
			.online-player {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.55rem 0.85rem;
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid var(--border);
				transition: all var(--transition-fast);
			}
			.online-player:hover {
				background: var(--panel-hover);
				border-color: var(--border-bright);
				transform: translateX(2px);
			}
			.online-avatar {
				width: 32px;
				height: 32px;
				border-radius: 8px;
				display: grid;
				place-items: center;
				font-weight: 800;
				color: #000000;
				font-size: 0.82rem;
				flex-shrink: 0;
			}
			.online-name {
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				font-weight: 600;
				font-size: 0.92rem;
			}
			.online-rating {
				font-family: var(--font-mono);
				font-weight: 700;
				font-size: 0.82rem;
				color: var(--accent);
			}
			.online-empty {
				color: var(--text-muted);
				font-size: 0.9rem;
				padding: 1.5rem 0.5rem;
				text-align: center;
			}
			@media (max-width: 820px) {
				.online-grid { grid-template-columns: 1fr; }
			}

			/* ---------- MODES ---------- */
			.mode-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.6rem;
			}
			.mode-card {
				position: relative;
				display: flex;
				flex-direction: column;
				padding: 2.2rem 1.8rem;
				gap: 1.1rem;
				border-radius: var(--radius-lg);
				transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
				overflow: hidden;
			}
			.mode-accent-bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: var(--card-color);
				opacity: 0.8;
			}
			.mode-card:hover {
				transform: translateY(-4px);
				border-color: var(--border-bright);
				box-shadow: var(--shadow-lg);
			}
			.mode-icon {
				width: 48px;
				height: 48px;
				border-radius: 12px;
				background: linear-gradient(135deg, var(--mode-color), color-mix(in srgb, var(--mode-color) 40%, #000));
				display: grid;
				place-items: center;
				color: #000000;
				box-shadow: 0 4px 18px color-mix(in srgb, var(--mode-color) 40%, transparent);
				flex-shrink: 0;
			}
			.mode-card h3 { font-size: 1.28rem; margin: 0.2rem 0 0; }
			.mode-card p {
				margin: 0;
				font-size: 0.93rem;
				color: var(--text-dim);
				line-height: 1.65;
				flex: 1;
			}
			.mode-tag {
				align-self: flex-start;
				padding: 0.3em 0.8em;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid var(--border);
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--tag-color, var(--accent));
			}

			/* ---------- DOWNLOAD ---------- */
			.download-card {
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 2.8rem;
				padding: 3.2rem;
				align-items: center;
				border-radius: var(--radius-xl);
				position: relative;
				overflow: hidden;
				background:
					radial-gradient(600px 300px at 100% 0%, rgba(62, 166, 195, 0.12), transparent 70%),
					var(--panel);
			}
			.download-copy h2 { margin-bottom: 0.6rem; font-size: 2.2rem; }
			.download-copy p { color: var(--text-dim); margin: 0 0 1.8rem; max-width: 44ch; font-size: 1.05rem; }
			.download-platforms {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}
			.platform {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.1rem 1.4rem;
				border-radius: var(--radius);
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid var(--border);
				transition: all var(--transition-fast);
				text-decoration: none;
			}
			.platform:hover {
				border-color: var(--border-bright);
				background: var(--panel-hover);
				transform: translateX(4px);
				box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
			}
			.platform-info {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
			}
			.platform-name { font-weight: 700; font-size: 1.05rem; color: var(--text); }
			.platform-meta { color: var(--text-muted); font-size: 0.8rem; font-family: var(--font-mono); }
			.platform-arrow {
				font-size: 1.2rem;
				color: var(--accent);
				transition: transform var(--transition-fast);
			}
			.platform:hover .platform-arrow {
				transform: translateX(3px);
			}
			@media (max-width: 860px) {
				.download-card { grid-template-columns: 1fr; padding: 2.2rem; }
			}

			/* ---------- PARTICLES ---------- */
			.hero {
				position: relative;
				overflow: hidden;
			}
			.hero-content, .hero-board {
				position: relative;
				z-index: 1;
			}
			.tetromino-particles {
				position: absolute;
				inset: 0;
				z-index: 0;
				pointer-events: none;
			}
			.tetromino-particles i {
				position: absolute;
				top: -50px;
				width: 20px;
				height: 20px;
				background: var(--c);
				opacity: 0.06;
				animation: fall linear infinite;
			}
			.tetromino-particles i:nth-child(1) { box-shadow: 0 20px 0 var(--c), 0 40px 0 var(--c), 0 60px 0 var(--c); height: 20px; }
			.tetromino-particles i:nth-child(2) { box-shadow: 20px 0 0 var(--c), 0 20px 0 var(--c), 20px 20px 0 var(--c); }
			.tetromino-particles i:nth-child(3) { box-shadow: -20px 20px 0 var(--c), 0 20px 0 var(--c), 20px 20px 0 var(--c); }
			.tetromino-particles i:nth-child(4) { box-shadow: 20px 0 0 var(--c), 0 20px 0 var(--c), -20px 20px 0 var(--c); }
			.tetromino-particles i:nth-child(5) { box-shadow: -20px 0 0 var(--c), 0 20px 0 var(--c), 20px 20px 0 var(--c); }
			.tetromino-particles i:nth-child(6) { box-shadow: 0 20px 0 var(--c), 0 40px 0 var(--c), -20px 40px 0 var(--c); }
			.tetromino-particles i:nth-child(7) { box-shadow: 0 20px 0 var(--c), 0 40px 0 var(--c), 20px 40px 0 var(--c); }
			
			@keyframes fall {
				0% { transform: translateY(-100px) rotate(0deg); }
				100% { transform: translateY(120vh) rotate(360deg); }
			}

			/* ---------- COMMUNITY STATS ---------- */
			.stats-banner {
				padding: 0 0 2rem;
			}
			.stats-panel {
				display: flex;
				justify-content: space-around;
				align-items: center;
				padding: 2rem;
				border-radius: var(--radius-lg);
				background: rgba(255, 255, 255, 0.02);
				backdrop-filter: blur(10px);
				border: 1px solid var(--border);
			}
			.stat-item {
				display: flex;
				align-items: center;
				gap: 1.2rem;
			}
			.stat-icon {
				font-size: 2.5rem;
			}
			.stat-text {
				display: flex;
				flex-direction: column;
			}
			.stat-value {
				font-size: 2.2rem;
				font-weight: 800;
				font-family: var(--font-display);
				line-height: 1.1;
				color: var(--text);
			}
			.stat-label {
				font-size: 0.85rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-family: var(--font-mono);
				margin-top: 0.2rem;
			}
			@media (max-width: 768px) {
				.stats-panel {
					flex-direction: column;
					gap: 2rem;
					align-items: flex-start;
				}
			}

			/* ---------- NEWS STRIP ---------- */
			.news-strip {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			.news-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 1.5rem;
				border-radius: var(--radius-lg);
				text-decoration: none;
				transition: all var(--transition-fast);
				background: rgba(255, 255, 255, 0.02);
				border: 1px solid var(--border);
				gap: 1rem;
			}
			.news-card:hover {
				transform: translateY(-2px);
				border-color: var(--border-bright);
				background: var(--panel-hover);
			}
			.news-card-content h3 {
				font-size: 1.1rem;
				margin: 0 0 0.5rem;
				color: var(--text);
			}
			.news-card-content time {
				font-size: 0.85rem;
				color: var(--text-muted);
				font-family: var(--font-mono);
			}
			.news-read-more {
				font-size: 0.9rem;
				color: var(--accent);
				font-weight: 600;
			}
		</style>
	</body>
</html>
