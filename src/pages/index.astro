---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Competitive Block Stacking`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- GAME HERO / PORTAL HEADER -->
			<section class="game-hero" id="play" aria-labelledby="hero-title">
				<div class="hero-left">
					<div class="game-badge-strip">
						<span class="badge-tech">Techmino Engine</span>
						<span class="badge-srs">SRS Rotation</span>
						<span class="badge-bag">7-Bag System</span>
					</div>
					<h1 id="hero-title">Te<span class="text-accent">blocks</span></h1>
					<p class="hero-desc">
						Fast, cheat-resistant, multiplayer block-stacking. Ranked 1v1 duels with server replay verification, 40-line speedruns, daily challenges, and custom lobbies.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary btn-lg" href="#download">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Download Client
						</a>
						<a class="btn btn-secondary btn-lg" href="/leaderboards/">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
								<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
								<path d="M4 22h16"/>
								<path d="M10 14.66V17c0 .55-.45 1-1 1H7c-.55 0-1 .45-1 1v3h12v-3c0-.55-.45-1-1-1h-2c-.55 0-1-.45-1-1v-2.34"/>
								<path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>
							</svg>
							Leaderboards
						</a>
					</div>
				</div>

				<div class="hero-right">
					<div class="preview-cabinet">
						<div class="cabinet-header">
							<span class="cabinet-dot red"></span>
							<span class="cabinet-dot yellow"></span>
							<span class="cabinet-dot green"></span>
							<span class="cabinet-title">LIVE PREVIEW</span>
						</div>
						<div class="cabinet-video-wrap">
							<video
								id="hero-video"
								class="hero-video"
								autoplay
								loop
								muted
								playsinline
								preload="metadata"
								aria-label="TeBlocks gameplay preview"
							>
								<source src="/media/teblockspreview.webm" type="video/webm" />
							</video>
						</div>
					</div>
				</div>
			</section>

			<!-- COMMUNITY STATS RACK (TETR.IO / osu! style) -->
			<section class="stats-bar">
				<div class="stat-rack panel">
					<div class="stat-item">
						<span class="stat-num" id="stat-online">—</span>
						<span class="stat-label"><span class="pulse-dot"></span> Online Now</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-num" id="stat-matches">—</span>
						<span class="stat-label">Matches Played</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-num" id="stat-registered">—</span>
						<span class="stat-label">Registered Players</span>
					</div>
				</div>
			</section>

			<!-- LIVE PLAYERS ONLINE MONITOR -->
			<section class="section" id="online" aria-labelledby="online-title">
				<div class="section-title-row">
					<div>
						<h2 id="online-title">Server Activity</h2>
						<p>Real-time player traffic and current lobby occupants</p>
					</div>
					<div class="live-indicator-tag">
						<span class="live-pulse"></span>
						<span>LIVE SERVER</span>
					</div>
				</div>

				<div class="online-monitor-grid">
					<div class="graph-card panel">
						<div class="graph-meta">
							<div class="online-stat-val">
								<span class="count-big" id="online-count">—</span>
								<span class="count-sub">active stackers</span>
							</div>
							<span class="graph-legend">Activity graph (last 30m)</span>
						</div>
						<div class="graph-svg-container">
							<svg id="online-graph" viewBox="0 0 600 160" preserveAspectRatio="none" role="img" aria-label="Players online over time">
								<defs>
									<linearGradient id="graph-fill" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color="#00c2ff" stop-opacity="0.3" />
										<stop offset="100%" stop-color="#00c2ff" stop-opacity="0.0" />
									</linearGradient>
								</defs>
								<path id="online-area" fill="url(#graph-fill)" stroke="none" d="" />
								<polyline id="online-line" fill="none" stroke="#00c2ff" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="" />
								<circle id="online-dot" r="4" fill="#ffffff" stroke="#00c2ff" stroke-width="2" cx="0" cy="0" />
							</svg>
						</div>
					</div>

					<div class="lobby-card panel">
						<div class="lobby-header">
							<span>In Lobby</span>
							<span class="badge-count" id="online-lobby-count">0</span>
						</div>
						<ul id="online-players" class="online-players-list">
							<li class="online-empty">No one online right now — be the first to jump in.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- GAME MODES -->
			<section class="section" id="modes" aria-labelledby="modes-title">
				<div class="section-title-row">
					<div>
						<h2 id="modes-title">Game Modes</h2>
						<p>Built for precision competitive duels, casual practice, and global speedruns</p>
					</div>
				</div>

				<div class="modes-grid">
					<article class="mode-slab" style="--mode-color: var(--z);">
						<div class="mode-top-bar"></div>
						<div class="mode-header-row">
							<h3>Ranked 1v1</h3>
							<span class="mode-badge">ELO Competitive</span>
						</div>
						<p>Strict 1v1 matchmaking with server-side replay verification. Climb the tiers from Bronze to Grandmaster.</p>
						<div class="mode-footer">
							<span class="mode-meta">Client-side physics · Zero lag</span>
						</div>
					</article>

					<article class="mode-slab" style="--mode-color: var(--i);">
						<div class="mode-top-bar"></div>
						<div class="mode-header-row">
							<h3>Casual MP</h3>
							<span class="mode-badge">Custom Rooms</span>
						</div>
						<p>Open lobbies and password-protected rooms. Play with friends, customize garbage mechanics, or spectate.</p>
						<div class="mode-footer">
							<span class="mode-meta">Free-for-all · Spectator mode</span>
						</div>
					</article>

					<article class="mode-slab" style="--mode-color: var(--s);">
						<div class="mode-top-bar"></div>
						<div class="mode-header-row">
							<h3>Daily Challenge</h3>
							<span class="mode-badge">Global Seed</span>
						</div>
						<p>A fresh synchronized puzzle challenge every 24 hours. Everyone stacks the identical seed to find optimal routing.</p>
						<div class="mode-footer">
							<span class="mode-meta">Daily reset · Leaderboard</span>
						</div>
					</article>

					<article class="mode-slab" style="--mode-color: var(--o);">
						<div class="mode-top-bar"></div>
						<div class="mode-header-row">
							<h3>Sprint & Solo</h3>
							<span class="mode-badge">Speedrun</span>
						</div>
						<p>Precision single-player speedruns: 40 Lines, 100 Lines sprint, and 2-minute Ultra score attack with millisecond timers.</p>
						<div class="mode-footer">
							<span class="mode-meta">40L Sprint · Ultra · Handling practice</span>
						</div>
					</article>
				</div>
			</section>

			<!-- COMMUNITY NEWS / CHANGELOG -->
			<section class="section" id="news" aria-labelledby="news-title">
				<div class="section-title-row">
					<div>
						<h2 id="news-title">News & Updates</h2>
						<p>Recent client updates, balance notes, and community announcements</p>
					</div>
					<a href="/blog/" class="view-all-link">Browse all news &rarr;</a>
				</div>

				<div class="news-list">
					{posts.map((post) => (
						<a href={`/blog/${post.slug}/`} class="news-item panel">
							<div class="news-info">
								<span class="news-tag">Announcement</span>
								<h3 class="news-headline">{post.data.title}</h3>
							</div>
							<div class="news-right">
								<time class="news-date" datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric'
									})}
								</time>
								<span class="news-arrow">&rarr;</span>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- DOWNLOAD STATION -->
			<section class="section download-section" id="download" aria-labelledby="download-title">
				<div class="download-container panel">
					<div class="download-text">
						<h2 id="download-title">Download Client</h2>
						<p>Free, lightweight, and cross-platform. No ads, no telemetry, no pay-to-win.</p>
						<a class="btn btn-primary btn-lg" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Latest Release on GitHub
						</a>
					</div>

					<div class="download-cards">
						<a class="platform-card" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-icon"><i class="fa-brands fa-windows"></i></div>
							<div class="platform-details">
								<span class="platform-title">Windows</span>
								<span class="platform-sub">Installer & Portable .exe</span>
							</div>
							<span class="platform-link-tag">Download</span>
						</a>
						<a class="platform-card" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-icon"><i class="fa-brands fa-android"></i></div>
							<div class="platform-details">
								<span class="platform-title">Android</span>
								<span class="platform-sub">Touch-optimized .apk</span>
							</div>
							<span class="platform-link-tag">Download</span>
						</a>
						<a class="platform-card" href="https://github.com/ItzMeNeon/teblocks/releases" rel="noopener" target="_blank">
							<div class="platform-icon"><i class="fa-brands fa-linux"></i></div>
							<div class="platform-details">
								<span class="platform-title">Linux</span>
								<span class="platform-sub">AppImage & Tarball x86_64</span>
							</div>
							<span class="platform-link-tag">Download</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// ----- Live "players online" graph + list -----
			const onlineCount = document.getElementById('online-count');
			const onlineLine = document.getElementById('online-line');
			const onlineArea = document.getElementById('online-area');
			const onlineDot = document.getElementById('online-dot');
			const onlineList = document.getElementById('online-players');
			const onlineLobbyCount = document.getElementById('online-lobby-count');

			const GRAPH_W = 600;
			const GRAPH_H = 160;
			const GRAPH_PAD = 12;
			const GRAPH_MAX_POINTS = 120;
			let graphHistory: number[] = [];

			function renderGraph(series: number[]) {
				if (!onlineLine || !onlineArea || !onlineDot) return;
				const data = series && series.length ? series : [0];
				const max = Math.max(5, ...data);
				const min = Math.min(...data, 0);
				const n = data.length;
				const x = (i: number) => GRAPH_PAD + (n === 1 ? (GRAPH_W - 2 * GRAPH_PAD) / 2 : (i / (n - 1)) * (GRAPH_W - 2 * GRAPH_PAD));
				const y = (v: number) => GRAPH_H - GRAPH_PAD - ((v - min) / ((max - min) || 1)) * (GRAPH_H - 2 * GRAPH_PAD);
				const pts = data.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
				if (n === 1) {
					const yy = y(data[0]).toFixed(1);
					onlineLine.setAttribute('points', `${GRAPH_PAD},${yy} ${GRAPH_W - GRAPH_PAD},${yy}`);
					onlineArea.setAttribute('d', `M ${GRAPH_PAD},${GRAPH_H - GRAPH_PAD} L ${GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${yy} L ${GRAPH_W - GRAPH_PAD},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', String((GRAPH_W) / 2));
					onlineDot.setAttribute('cy', yy);
				} else {
					onlineLine.setAttribute('points', pts);
					onlineArea.setAttribute('d', `M ${x(0).toFixed(1)},${GRAPH_H - GRAPH_PAD} L ${pts.replace(/ /g, ' L ')} L ${x(n - 1).toFixed(1)},${GRAPH_H - GRAPH_PAD} Z`);
					onlineDot.setAttribute('cx', x(n - 1).toFixed(1));
					onlineDot.setAttribute('cy', y(data[n - 1]).toFixed(1));
				}
			}

			function renderList(players: any[]) {
				if (!onlineList) return;
				if (!players || !players.length) {
					onlineList.innerHTML = '<li class="online-empty">No one online right now — be the first to jump in.</li>';
					if (onlineLobbyCount) onlineLobbyCount.textContent = '0';
					return;
				}
				if (onlineLobbyCount) onlineLobbyCount.textContent = String(players.length);
				onlineList.replaceChildren(
					...players.slice(0, 12).map((p) => {
						const li = document.createElement('li');
						li.className = 'online-player-row';
						const initial = (p.username || '?').slice(0, 1).toUpperCase();
						li.innerHTML = `
							<span class="player-avatar-mini">${initial}</span>
							<span class="player-name-mini">${p.username || 'Unknown'}</span>
							<span class="player-rating-mini">${p.rating || 0}</span>
						`;
						return li;
					})
				);
			}

			async function loadOnline() {
				try {
					const res = await fetch('/api/players/online', { cache: 'no-store' });
					if (!res.ok) return;
					const body = await res.json();
					const count = body.count ?? 0;
					if (onlineCount) onlineCount.textContent = count.toLocaleString();
					const serverHistory = Array.isArray(body.history) ? body.history : [];
					if (!graphHistory.length && serverHistory.length) {
						graphHistory = serverHistory.slice(-GRAPH_MAX_POINTS);
					}
					graphHistory.push(count);
					if (graphHistory.length > GRAPH_MAX_POINTS) graphHistory.shift();
					renderGraph(graphHistory);
					renderList(body.players);
				} catch {
					/* keep last good values */
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					loadOnline();
					setInterval(loadOnline, 15000);
				});
			} else {
				loadOnline();
				setInterval(loadOnline, 15000);
			}

			function animateValue(id: string, start: number, end: number, duration: number) {
				if (start === end) return;
				const obj = document.getElementById(id);
				if (!obj) return;
				let startTimestamp: number | null = null;
				const step = (timestamp: number) => {
					if (!startTimestamp) startTimestamp = timestamp;
					const progress = Math.min((timestamp - startTimestamp) / duration, 1);
					obj.textContent = Math.floor(progress * (end - start) + start).toLocaleString();
					if (progress < 1) {
						window.requestAnimationFrame(step);
					}
				};
				window.requestAnimationFrame(step);
			}

			async function loadCommunityStats() {
				try {
					const [onlineRes, lbRes] = await Promise.all([
						fetch('/api/players/online', { cache: 'no-store' }).catch(() => null),
						fetch('/api/leaderboards', { cache: 'no-store' }).catch(() => null)
					]);

					let onlineCount = 0;
					let registeredCount = 0;
					let matchesCount = 0;

					if (onlineRes && onlineRes.ok) {
						const data = await onlineRes.json();
						if (data.count !== undefined) onlineCount = data.count;
						if (data.totalRegistered !== undefined) registeredCount = data.totalRegistered;
						if (data.totalMatches !== undefined) matchesCount = data.totalMatches;
					}
					
					if (lbRes && lbRes.ok) {
						const data = await lbRes.json();
						if (data.totalPlayers !== undefined) registeredCount = data.totalPlayers;
						if (data.totalMatches !== undefined) matchesCount = data.totalMatches;
					}

					if (document.getElementById('stat-registered') && registeredCount > 0) {
						animateValue('stat-registered', 0, registeredCount, 1500);
					}
					if (document.getElementById('stat-matches') && matchesCount > 0) {
						animateValue('stat-matches', 0, matchesCount, 1500);
					}
					if (document.getElementById('stat-online') && onlineCount >= 0) {
						animateValue('stat-online', 0, onlineCount, 1500);
					}
				} catch (e) {}
			}
			
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', loadCommunityStats);
			} else {
				loadCommunityStats();
			}
		</script>

		<style>
			/* ---------- GAME HERO / PORTAL HEADER ---------- */
			.game-hero {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				align-items: center;
				gap: 3rem;
				padding: 3rem 0 2rem;
			}
			.game-badge-strip {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-bottom: 0.8rem;
			}
			.game-badge-strip span {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 0.2em 0.6em;
				border-radius: var(--radius-sm);
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				color: var(--text-dim);
			}
			.badge-tech {
				border-color: rgba(0, 194, 255, 0.4) !important;
				color: var(--accent) !important;
			}
			.badge-srs {
				border-color: rgba(85, 204, 221, 0.4) !important;
				color: var(--i) !important;
			}
			.badge-bag {
				border-color: rgba(255, 204, 34, 0.4) !important;
				color: var(--gold) !important;
			}
			.game-hero h1 {
				font-size: clamp(2.6rem, 6vw, 4.4rem);
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				margin: 0 0 0.8rem;
				line-height: 1;
			}
			.text-accent {
				color: var(--accent);
			}
			.hero-desc {
				font-size: 1.05rem;
				line-height: 1.6;
				color: var(--text-dim);
				max-width: 52ch;
				margin: 0 0 1.8rem;
			}
			.hero-actions {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
			}

			/* Preview Cabinet */
			.preview-cabinet {
				background: #14141e;
				border: 1px solid var(--border-bright);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
			}
			.cabinet-header {
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 0.6rem 0.9rem;
				background: #0d0d14;
				border-bottom: 1px solid var(--border);
			}
			.cabinet-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
			}
			.cabinet-dot.red { background: #ff5555; }
			.cabinet-dot.yellow { background: #ffcc22; }
			.cabinet-dot.green { background: #44dd88; }
			.cabinet-title {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				color: var(--text-muted);
				margin-left: 0.4rem;
			}
			.cabinet-video-wrap {
				aspect-ratio: 4 / 3;
				background: #000000;
			}
			.hero-video {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			@media (max-width: 860px) {
				.game-hero {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding: 2rem 0 1rem;
				}
				.hero-right {
					order: -1;
					max-width: 460px;
				}
			}

			/* ---------- STATS BAR ---------- */
			.stats-bar {
				margin: 1.5rem 0 2.5rem;
			}
			.stat-rack {
				display: flex;
				justify-content: space-around;
				align-items: center;
				padding: 1.2rem 1.8rem;
				background: #14141e;
				border: 1px solid var(--border);
			}
			.stat-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.2rem;
			}
			.stat-num {
				font-family: var(--font-mono);
				font-size: 1.8rem;
				font-weight: 700;
				color: #ffffff;
				line-height: 1;
			}
			.stat-label {
				font-size: 0.78rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}
			.stat-divider {
				width: 1px;
				height: 36px;
				background: var(--border);
			}
			.pulse-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--success);
				box-shadow: 0 0 6px var(--success);
				animation: pulse 1.5s infinite;
			}
			@keyframes pulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(1.2); }
			}

			@media (max-width: 640px) {
				.stat-rack {
					flex-direction: column;
					gap: 1.2rem;
					align-items: stretch;
				}
				.stat-divider { display: none; }
			}

			/* ---------- SECTION TITLE ROW ---------- */
			.section-title-row {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				margin-bottom: 1.5rem;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.section-title-row h2 {
				margin: 0 0 0.2rem;
				font-size: 1.5rem;
			}
			.section-title-row p {
				margin: 0;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.live-indicator-tag {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.3em 0.7em;
				border-radius: var(--radius-sm);
				background: rgba(68, 221, 136, 0.1);
				border: 1px solid rgba(68, 221, 136, 0.25);
				color: var(--success);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.08em;
			}
			.live-pulse {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--success);
			}

			/* ---------- ONLINE MONITOR ---------- */
			.online-monitor-grid {
				display: grid;
				grid-template-columns: 1.3fr 0.7fr;
				gap: 1.2rem;
			}
			.graph-card {
				padding: 1.4rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.graph-meta {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
			}
			.online-stat-val {
				display: flex;
				align-items: baseline;
				gap: 0.5rem;
			}
			.count-big {
				font-family: var(--font-mono);
				font-size: 2.6rem;
				font-weight: 800;
				color: var(--accent);
				line-height: 1;
			}
			.count-sub {
				color: var(--text-muted);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.graph-legend {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-muted);
			}
			.graph-svg-container {
				width: 100%;
				height: 130px;
				background: #111118;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				padding: 6px;
			}
			#online-graph {
				width: 100%;
				height: 100%;
			}

			.lobby-card {
				padding: 1.2rem;
				display: flex;
				flex-direction: column;
			}
			.lobby-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-muted);
				margin-bottom: 0.8rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--border);
			}
			.badge-count {
				background: rgba(0, 194, 255, 0.15);
				color: var(--accent);
				padding: 0.1em 0.5em;
				border-radius: var(--radius-sm);
			}
			.online-players-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				overflow-y: auto;
				max-height: 160px;
			}
			.online-player-row {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.4rem 0.6rem;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				font-size: 0.86rem;
			}
			.player-avatar-mini {
				width: 22px;
				height: 22px;
				border-radius: 3px;
				background: var(--panel-hover);
				color: var(--accent);
				font-weight: 800;
				font-size: 0.72rem;
				display: grid;
				place-items: center;
			}
			.player-name-mini {
				flex: 1;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				font-weight: 600;
			}
			.player-rating-mini {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--text-muted);
			}
			.online-empty {
				color: var(--text-muted);
				font-size: 0.82rem;
				padding: 1.5rem 0.5rem;
				text-align: center;
			}

			@media (max-width: 820px) {
				.online-monitor-grid { grid-template-columns: 1fr; }
			}

			/* ---------- GAME MODES GRID ---------- */
			.modes-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1rem;
			}
			.mode-slab {
				position: relative;
				background: #161622;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.4rem;
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				transition: border-color var(--transition-fast);
			}
			.mode-slab:hover {
				border-color: var(--border-bright);
			}
			.mode-top-bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: var(--mode-color);
				border-radius: var(--radius) var(--radius) 0 0;
			}
			.mode-header-row {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 0.5rem;
			}
			.mode-header-row h3 {
				margin: 0;
				font-size: 1.15rem;
			}
			.mode-badge {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 0.2em 0.5em;
				border-radius: 3px;
				background: rgba(255, 255, 255, 0.05);
				color: var(--mode-color);
				border: 1px solid var(--border);
				white-space: nowrap;
			}
			.mode-slab p {
				margin: 0;
				font-size: 0.88rem;
				line-height: 1.5;
				color: var(--text-dim);
				flex: 1;
			}
			.mode-footer {
				padding-top: 0.6rem;
				border-top: 1px solid var(--border);
			}
			.mode-meta {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-muted);
			}

			/* ---------- NEWS LIST (osu! style) ---------- */
			.news-list {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}
			.news-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1rem 1.4rem;
				text-decoration: none;
				gap: 1rem;
				transition: border-color var(--transition-fast), background-color var(--transition-fast);
			}
			.news-item:hover {
				border-color: var(--border-bright);
				background: var(--panel-hover);
			}
			.news-info {
				display: flex;
				align-items: center;
				gap: 1rem;
				min-width: 0;
			}
			.news-tag {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				background: rgba(0, 194, 255, 0.12);
				color: var(--accent);
				padding: 0.2em 0.6em;
				border-radius: var(--radius-sm);
				flex-shrink: 0;
			}
			.news-headline {
				margin: 0;
				font-size: 1rem;
				color: #ffffff;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.news-right {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-shrink: 0;
			}
			.news-date {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-muted);
			}
			.news-arrow {
				color: var(--accent);
				font-weight: 700;
			}
			.view-all-link {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
			}
			.view-all-link:hover {
				text-decoration: underline;
			}

			@media (max-width: 640px) {
				.news-item {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.5rem;
				}
				.news-info {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.4rem;
				}
				.news-headline {
					white-space: normal;
				}
			}

			/* ---------- DOWNLOAD STATION ---------- */
			.download-section {
				margin-top: 1rem;
			}
			.download-container {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2.5rem;
				padding: 2.2rem;
				align-items: center;
				background: #14141e;
			}
			.download-text h2 {
				margin: 0 0 0.5rem;
				font-size: 1.8rem;
			}
			.download-text p {
				color: var(--text-dim);
				margin: 0 0 1.5rem;
				max-width: 40ch;
				font-size: 0.95rem;
			}
			.download-cards {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}
			.platform-card {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 0.85rem 1.1rem;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				text-decoration: none;
				transition: border-color var(--transition-fast), background-color var(--transition-fast);
			}
			.platform-card:hover {
				border-color: var(--border-bright);
				background: var(--panel-hover);
			}
			.platform-icon {
				font-size: 1.5rem;
				flex-shrink: 0;
			}
			.platform-details {
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.platform-title {
				font-weight: 700;
				color: #ffffff;
				font-size: 0.95rem;
			}
			.platform-sub {
				font-family: var(--font-mono);
				font-size: 0.74rem;
				color: var(--text-muted);
			}
			.platform-link-tag {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--accent);
				padding: 0.2em 0.6em;
				border-radius: var(--radius-sm);
				background: rgba(0, 194, 255, 0.1);
			}

			@media (max-width: 760px) {
				.download-container {
					grid-template-columns: 1fr;
					gap: 1.8rem;
					padding: 1.5rem;
				}
			}
		</style>
	</body>
</html>
