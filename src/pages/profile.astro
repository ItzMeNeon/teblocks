---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Profile | ${SITE_TITLE}`} description="Your TeBlocks player profile." />
	</head>
	<body>
		<Header />
		<main>
			<p id="profile-status" class="loading" role="status" aria-live="polite">Loading player profile...</p>
			<section id="profile" class="profile" hidden aria-labelledby="profile-name">
				<div class="profile-banner" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
				<div class="profile-card">
					<div class="identity-row">
						<div class="avatar" aria-hidden="true"><span id="avatar-initial">T</span></div>
						<div class="identity">
							<p class="eyebrow" style="--accent-color: var(--i)"><span class="presence"></span> Online profile</p>
							<h1 id="profile-name">Player</h1>
							<p class="player-meta"><span id="verification-badge" class="verification-badge">Unverified</span><span>TeBlocks player</span></p>
						</div>
						<div class="profile-actions">
							<button id="share-button" class="button secondary" type="button">Share profile</button>
							<button id="logout-button" class="button danger" type="button">Log out</button>
						</div>
					</div>

					<div class="profile-grid">
						<section class="about-card" aria-labelledby="about-title">
							<div class="section-heading"><p class="eyebrow" style="--accent-color: var(--t)">Player card</p><h2 id="about-title">About</h2></div>
							<p id="player-note" class="player-note">This player has not added a profile note yet.</p>
							<form id="note-form" class="note-form">
								<label class="sr-only" for="profile-note">Profile note</label>
								<input id="profile-note" maxlength="120" placeholder="Add a short profile note" />
								<button class="button compact" type="submit">Save</button>
							</form>
							<p class="local-note">Stored in this browser until profiles support custom bios.</p>
						</section>

						<section class="rank-card" aria-labelledby="rank-title">
							<div class="section-heading"><p class="eyebrow" style="--accent-color: var(--o)">Competitive</p><h2 id="rank-title">Rank progress</h2></div>
							<div class="rank-display"><span class="rank-glyph">?</span><div><strong>Unranked</strong><p>Play your first ranked match to place.</p></div></div>
							<div class="progress-label"><span>Placement status</span><span>0 / 5</span></div><div class="progress-track"><span></span></div>
						</section>
					</div>

					<section class="stats-section" aria-labelledby="stats-title">
						<div class="section-heading"><p class="eyebrow" style="--accent-color: var(--s)">Performance</p><h2 id="stats-title">Player statistics</h2></div>
						<div class="stats-grid">
							<div class="stat"><span class="stat-label">Rating</span><strong>--</strong><span class="stat-detail">No rating yet</span></div>
							<div class="stat"><span class="stat-label">Matches</span><strong>0</strong><span class="stat-detail">Start your first game</span></div>
							<div class="stat"><span class="stat-label">Win rate</span><strong>--</strong><span class="stat-detail">Pending matches</span></div>
							<div class="stat"><span class="stat-label">Best streak</span><strong>0</strong><span class="stat-detail">Build a run</span></div>
						</div>
					</section>

					<div class="lower-grid">
						<section class="activity-card" aria-labelledby="activity-title">
							<div class="section-heading"><p class="eyebrow" style="--accent-color: var(--z)">Timeline</p><h2 id="activity-title">Recent activity</h2></div>
							<div class="empty-activity"><span class="activity-icon" aria-hidden="true">+</span><div><strong>Your match history will appear here.</strong><p>Once gameplay tracking is connected, this will show results, rating movement, and milestones.</p></div></div>
						</section>
						<aside class="account-card" aria-labelledby="account-title">
							<p class="eyebrow" style="--accent-color: var(--j)">Account</p><h2 id="account-title">Player details</h2>
							<dl><div><dt>Email</dt><dd id="profile-email"></dd></div><div><dt>Account ID</dt><dd><button id="copy-id" class="copy-id" type="button" title="Copy account ID"><span id="profile-id"></span> <b>Copy</b></button></dd></div><div><dt>Session</dt><dd id="session-time">Active now</dd></div></dl>
						</aside>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.loading { margin: 5em auto; max-width: 760px; color: var(--dim); }
	.profile { max-width: 920px; margin: 3.5em auto 0; }
	.profile-card, .stats-section, .activity-card, .account-card { border: 1px solid var(--line); background: linear-gradient(145deg, rgba(22, 26, 33, .98), rgba(14, 17, 23, .98)); box-shadow: var(--shadow); }
	.profile-card { position: relative; overflow: hidden; border-radius: var(--radius); }
	.profile-banner { height: 104px; display: flex; gap: 8px; align-items: end; padding: 0 8%; overflow: hidden; background: radial-gradient(circle at 70% 15%, rgba(61, 219, 217, .26), transparent 32%), linear-gradient(110deg, #101925 0%, #1e1830 54%, #19130e 100%); }
	.profile-banner span { width: 54px; height: 54px; margin-bottom: -13px; border: 1px solid rgba(236,239,243,.15); background: rgba(236,239,243,.09); transform: rotate(45deg); }
	.profile-banner span:nth-child(2) { height: 82px; background: rgba(176,132,245,.25); } .profile-banner span:nth-child(3) { height: 42px; background: rgba(245,213,71,.22); } .profile-banner span:nth-child(4) { height: 70px; background: rgba(111,224,122,.18); }
	.identity-row { display: flex; align-items: flex-end; gap: 1.25em; padding: 0 2em 1.8em; margin-top: -38px; }
	.avatar { width: 100px; height: 100px; flex: 0 0 auto; display: grid; place-items: center; border: 5px solid var(--panel); border-radius: 18px; background: linear-gradient(135deg, var(--i), var(--j)); box-shadow: 0 10px 26px rgba(0,0,0,.4); color: var(--board); font: 800 3.1rem "Rubik", sans-serif; }
	.identity { min-width: 0; flex: 1; } .identity .eyebrow { margin: 0 0 .3em; } .presence { width: 7px; height: 7px; display: inline-block; border-radius: 99px; background: var(--s); box-shadow: 0 0 0 3px rgba(111,224,122,.14); } .identity h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin: 0; overflow-wrap: anywhere; }
	.player-meta { display: flex; gap: .7em; align-items: center; margin: .25em 0 0; font-size: .88rem; } .verification-badge { padding: .14em .55em; border-radius: 20px; background: rgba(245,99,122,.13); color: var(--z); font-weight: 700; } .verification-badge.verified { background: rgba(111,224,122,.13); color: var(--s); }
	.profile-actions { display: flex; gap: .6em; } .button { padding: .72em 1em; border: 1px solid var(--i); border-radius: 7px; background: var(--i); color: var(--board); font: 700 .86rem "Atkinson", sans-serif; cursor: pointer; } .button:hover { filter: brightness(1.1); color: var(--board); } .button.secondary { background: transparent; color: var(--text); border-color: var(--line); } .button.danger { background: transparent; color: var(--z); border-color: rgba(245,99,122,.35); } .button.compact { padding: .55em .8em; }
	.profile-grid, .lower-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 1em; margin-top: 1em; } .about-card, .rank-card { min-height: 185px; padding: 1.6em; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); } .section-heading .eyebrow { margin-bottom: .35em; } .section-heading h2 { font-size: 1.35rem; } .player-note { min-height: 2.3em; margin: 1.1em 0 .8em; color: var(--text); } .note-form { display: flex; gap: .55em; } .note-form input { min-width: 0; flex: 1; padding: .56em .7em; border: 1px solid var(--line); border-radius: 6px; background: var(--board); color: var(--text); font: inherit; } .local-note { margin: .55em 0 0; font-size: .73rem; color: var(--dim-2); }
	.rank-display { display: flex; gap: 1em; align-items: center; margin: 1.2em 0; } .rank-glyph { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid rgba(245,213,71,.35); border-radius: 50%; background: rgba(245,213,71,.07); color: var(--o); font: 800 1.6rem "Rubik", sans-serif; } .rank-display strong { font-size: 1.1rem; } .rank-display p { margin: 0; font-size: .82rem; } .progress-label { display: flex; justify-content: space-between; color: var(--dim); font-size: .75rem; } .progress-track { height: 5px; margin-top: .35em; overflow: hidden; border-radius: 99px; background: var(--board); } .progress-track span { display: block; width: 0%; height: 100%; background: var(--o); }
	.stats-section, .activity-card, .account-card { padding: 1.6em; border-radius: var(--radius); } .stats-section { margin-top: 1em; } .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 1.2em; border-top: 1px solid var(--line); border-left: 1px solid var(--line); } .stat { padding: 1em; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); } .stat-label, .stat-detail { display: block; } .stat-label { color: var(--dim); font: .72rem "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .06em; } .stat strong { display: block; margin: .18em 0; font: 700 1.8rem "Rubik", sans-serif; } .stat-detail { color: var(--dim-2); font-size: .76rem; }
	.empty-activity { display: flex; gap: 1em; align-items: center; padding: 1.4em 0 .2em; } .activity-icon { display: grid; place-items: center; width: 42px; height: 42px; flex: 0 0 auto; border: 1px solid var(--line); border-radius: 50%; color: var(--z); font-size: 1.4rem; } .empty-activity strong { font-size: .93rem; } .empty-activity p { margin: .2em 0 0; font-size: .82rem; }
	.account-card dl { margin: 1.05em 0 0; } .account-card dl div { padding: .7em 0; border-top: 1px solid var(--line); } dt { color: var(--dim-2); font: .7rem "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .07em; } dd { margin: .15em 0 0; color: var(--text); overflow-wrap: anywhere; font-size: .86rem; } .copy-id { padding: 0; border: 0; background: transparent; color: var(--text); cursor: pointer; font: inherit; text-align: left; } .copy-id b { color: var(--i); font-size: .77rem; }
	@media (max-width: 720px) { .profile { margin-top: 2em; } .identity-row { flex-wrap: wrap; padding: 0 1.15em 1.2em; } .avatar { width: 78px; height: 78px; font-size: 2.3rem; } .profile-actions { width: 100%; } .profile-actions .button { flex: 1; } .profile-grid, .lower-grid { grid-template-columns: 1fr; } .stats-section, .activity-card, .account-card, .about-card, .rank-card { padding: 1.25em; } .stats-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
	const status = document.querySelector('#profile-status');
	const profile = document.querySelector('#profile');
	const logoutButton = document.querySelector('#logout-button');
	const shareButton = document.querySelector('#share-button');
	const copyIdButton = document.querySelector('#copy-id');
	const noteForm = document.querySelector('#note-form');
	const noteInput = document.querySelector('#profile-note');
	const playerNote = document.querySelector('#player-note');
	let userId = '';

	function profileNoteKey() { return `teblocks-profile-note-${userId}`; }
	function refreshSessionTime() { document.querySelector('#session-time').textContent = `Active at ${new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' }).format(new Date())}`; }
	async function copyText(value, button, label) { try { await navigator.clipboard.writeText(value); const original = button.textContent; button.textContent = label; window.setTimeout(() => { button.textContent = original; }, 1600); } catch { window.prompt('Copy this value:', value); } }

	async function loadProfile() {
		const response = await fetch('/api/auth/me');
		if (response.status === 401) { window.location.replace('/login/'); return; }
		const body = await response.json().catch(() => ({}));
		if (!response.ok) { status.textContent = body.error || 'Unable to load your profile.'; return; }
		userId = body.user_id || body.username;
		document.querySelector('#profile-name').textContent = body.username;
		document.querySelector('#avatar-initial').textContent = body.username.slice(0, 1).toUpperCase();
		document.querySelector('#profile-email').textContent = body.email;
		document.querySelector('#profile-id').textContent = userId;
		const badge = document.querySelector('#verification-badge');
		badge.textContent = body.email_verified ? 'Verified account' : 'Email not verified';
		badge.classList.toggle('verified', Boolean(body.email_verified));
		const savedNote = localStorage.getItem(profileNoteKey());
		if (savedNote) { playerNote.textContent = savedNote; noteInput.value = savedNote; }
		refreshSessionTime();
		status.hidden = true; profile.hidden = false;
	}

	shareButton.addEventListener('click', () => copyText(window.location.href, shareButton, 'Link copied'));
	copyIdButton.addEventListener('click', () => copyText(userId, copyIdButton, 'Copied'));
	noteForm.addEventListener('submit', (event) => { event.preventDefault(); const note = noteInput.value.trim(); if (!note) { localStorage.removeItem(profileNoteKey()); playerNote.textContent = 'This player has not added a profile note yet.'; return; } localStorage.setItem(profileNoteKey(), note); playerNote.textContent = note; });
	logoutButton.addEventListener('click', async () => { await fetch('/api/auth/logout', { method: 'POST' }); window.location.assign('/'); });
	loadProfile();
</script>
