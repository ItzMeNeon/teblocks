---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Profile | ${SITE_TITLE}`} description="Your TeBlocks player profile." />
		<style>
			.loading { max-width: 920px; margin: 5em auto; color: var(--dim); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div id="profile-redirect" class="loading" role="status" aria-live="polite">Redirecting to your profile...</div>
		</main>
		<Footer />
		<script>
			(async function() {
				const status = document.getElementById('profile-redirect');
				try {
					const response = await fetch('/api/auth/me', { credentials: 'include' });
					if (!response.ok) {
						status.innerHTML = 'Please <a href="/login/">log in</a> to view your profile.';
						return;
					}
					const body = await response.json();
					if (!body.user_id) {
						status.textContent = 'Unable to load your profile.';
						return;
					}
					window.location.replace(`/profile/${body.user_id}`);
				} catch {
					status.textContent = 'Unable to load your profile. Please try again.';
				}
			})();
		</script>
	</body>
</html>
