---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Create account | ${SITE_TITLE}`} description="Create a TeBlocks account for competitive play." />
	</head>
	<body>
		<Header />
		<main>
			<section class="account-panel" aria-labelledby="account-title">
				<p class="eyebrow" style="--accent-color: var(--o)">Player account</p>
				<h1 id="account-title">Create your account</h1>
				<p class="intro">Your account will be used for ranked progress, matchmaking, and player identity.</p>

				<form id="registration-form">
					<label for="username">Username</label>
					<input id="username" name="username" type="text" autocomplete="username" minlength="3" maxlength="24" required />

					<label for="email">Email address</label>
					<input id="email" name="email" type="email" autocomplete="email" required />

					<label for="password">Password</label>
					<input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />

					<button type="submit">Create account</button>
					<p class="notice">Use at least 8 characters with uppercase, lowercase, a number, and a special character.</p>
				</form>
				<p id="form-status" class="status" role="status" aria-live="polite"></p>

				<section id="verification-panel" class="verification-panel" aria-labelledby="verification-title" hidden>
					<h2 id="verification-title">Verify your email</h2>
					<p>Enter the 6-digit code sent to your email address.</p>
					<form id="verification-form">
						<label for="verification-code">Verification code</label>
						<input id="verification-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
						<button type="submit">Verify account</button>
					</form>
				</section>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.account-panel {
		max-width: 560px;
		margin: 5em auto 0;
		padding: 2em;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--panel);
	}
	.intro { margin-bottom: 2em; }
	form { display: grid; gap: 0.55em; }
	label { color: var(--text); font-size: 0.92rem; font-weight: 600; }
	input {
		width: 100%;
		box-sizing: border-box;
		margin-bottom: 0.8em;
		padding: 0.75em 0.85em;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--board);
		color: var(--text);
		font: inherit;
	}
	input:focus { outline: 2px solid var(--i); outline-offset: 2px; }
	button {
		margin-top: 0.5em;
		padding: 0.85em 1.2em;
		border: 0;
		border-radius: 8px;
		background: var(--i);
		color: var(--board);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	button:disabled { cursor: wait; opacity: 0.7; }
	.notice, .status { margin: 0.8em 0 0; font-size: 0.86rem; }
	.status { color: var(--text); min-height: 1.65em; }
	.verification-panel { margin-top: 2em; padding-top: 1.5em; border-top: 1px solid var(--line); }
	.verification-panel h2 { font-size: 1.3rem; }
	@media (max-width: 720px) {
		.account-panel { margin-top: 3em; padding: 1.4em; }
	}
</style>

<script>
	const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8080';
	const registrationForm = document.querySelector('#registration-form');
	const verificationForm = document.querySelector('#verification-form');
	const verificationPanel = document.querySelector('#verification-panel');
	const status = document.querySelector('#form-status');
	let userId = '';

	function setStatus(message) {
		status.textContent = message;
	}

	async function post(path, body) {
		const response = await fetch(`${apiBaseUrl.replace(/\/$/, '')}${path}`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		const responseBody = await response.json().catch(() => ({}));
		if (!response.ok) {
			throw new Error(responseBody.error || 'Something went wrong. Please try again.');
		}
		return responseBody;
	}

	registrationForm.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!registrationForm.reportValidity()) return;

		const submitButton = registrationForm.querySelector('button');
		const formData = new FormData(registrationForm);
		submitButton.disabled = true;
		setStatus('Creating account…');

		try {
			const response = await post('/register', Object.fromEntries(formData));
			if (!response.user_id) throw new Error('The server returned an invalid registration response.');
			userId = response.user_id;
			registrationForm.reset();
			verificationPanel.hidden = false;
			setStatus('Account created. Check your email for the verification code.');
			document.querySelector('#verification-code').focus();
		} catch (error) {
			setStatus(error instanceof Error ? error.message : 'Unable to create account.');
		} finally {
			submitButton.disabled = false;
		}
	});

	verificationForm.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!verificationForm.reportValidity() || !userId) return;

		const submitButton = verificationForm.querySelector('button');
		const code = new FormData(verificationForm).get('code');
		submitButton.disabled = true;
		setStatus('Verifying email…');

		try {
			await post('/verify', { user_id: userId, code });
			verificationForm.reset();
			verificationPanel.hidden = true;
			setStatus('Email verified. Your TeBlocks account is ready.');
		} catch (error) {
			setStatus(error instanceof Error ? error.message : 'Unable to verify the code.');
		} finally {
			submitButton.disabled = false;
		}
	});
</script>
