---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { COUNTRIES } from '../lib/countries';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Create account | ${SITE_TITLE}`} description="Create a TeBlocks account for competitive play." />
		<style>
			.account-container {
				max-width: 520px;
				margin: 4rem auto 0;
			}
			.account-panel {
				padding: 2.5rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: var(--panel);
				box-shadow: var(--shadow);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
			}
			.account-panel h1 {
				margin: 0 0 0.5rem;
				font-size: 2.1rem;
			}
			.intro {
				color: var(--text-dim);
				font-size: 0.96rem;
				line-height: 1.6;
				margin-bottom: 1.8rem;
			}
			form {
				display: grid;
				gap: 1.1rem;
			}
			.form-field {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			label {
				color: var(--text);
				font-size: 0.9rem;
				font-weight: 600;
			}
			input, select {
				width: 100%;
				padding: 0.8rem 1rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font-family: var(--font-ui);
				font-size: 0.95rem;
				transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
			}
			input:focus, select:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: var(--focus-ring);
			}
			.field-hint {
				font-size: 0.8rem;
				color: var(--text-muted);
				line-height: 1.4;
			}
			button[type="submit"] {
				width: 100%;
				margin-top: 0.5rem;
				padding: 0.85rem 1.4rem;
				border: 0;
				border-radius: 999px;
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				color: #001a1c;
				font-family: var(--font-ui);
				font-size: 0.95rem;
				font-weight: 700;
				cursor: pointer;
				box-shadow: 0 4px 18px var(--accent-glow);
				transition: all var(--transition-fast);
			}
			button[type="submit"]:hover:not(:disabled) {
				filter: brightness(1.08);
				box-shadow: 0 6px 24px var(--accent-glow-strong);
				transform: translateY(-1px);
			}
			button[type="submit"]:disabled {
				cursor: wait;
				opacity: 0.6;
			}
			.notice {
				color: var(--text-muted);
				font-size: 0.82rem;
				line-height: 1.5;
				margin: 0.2rem 0 0;
			}
			.status {
				color: var(--text);
				min-height: 1.5em;
				margin: 1rem 0 0;
				font-size: 0.9rem;
				text-align: center;
			}
			.login-link {
				margin: 1.5rem 0 0;
				text-align: center;
				color: var(--text-muted);
				font-size: 0.92rem;
			}
			.verification-panel {
				margin-top: 2rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
			}
			.verification-panel h2 {
				font-size: 1.35rem;
				margin-bottom: 0.4rem;
			}
			.verification-panel p {
				color: var(--text-dim);
				font-size: 0.92rem;
				margin-bottom: 1.2rem;
			}
			@media (max-width: 600px) {
				.account-container { margin-top: 2rem; }
				.account-panel { padding: 1.8rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="account-container">
				<section class="account-panel" aria-labelledby="account-title">
					<p class="eyebrow" style="--accent-color: var(--o)">Player account</p>
					<h1 id="account-title">Create your account</h1>
					<p class="intro">Your account tracks ranked rating progress, matchmaking, and player customizations.</p>

					<form id="registration-form">
						<div class="form-field">
							<label for="username">Username</label>
							<input id="username" name="username" type="text" autocomplete="username" minlength="3" maxlength="24" placeholder="3-24 characters" required />
						</div>

						<div class="form-field">
							<label for="email">Email address</label>
							<input id="email" name="email" type="email" autocomplete="email" placeholder="name@example.com" required />
						</div>

						<div class="form-field">
							<label for="password">Password</label>
							<input id="password" name="password" type="password" autocomplete="new-password" minlength="8" placeholder="••••••••" required />
						</div>

						<div class="form-field">
							<label for="country">Country / Region</label>
							<select id="country" name="country" required>
								<option value="" disabled selected>Select your region…</option>
								{COUNTRIES.map((c) => (
									<option value={c.code}>{c.flag} {c.name}</option>
								))}
							</select>
							<p class="field-hint">🔒 <strong>Region is locked once set.</strong> It determines your regional banner and leaderboard flag, and cannot be changed without contacting support or opening a Discord ticket.</p>
						</div>

						<button type="submit">Create account</button>
						<p class="notice">Password must be at least 8 characters with uppercase, lowercase, numbers, and symbols.</p>
					</form>
					<p id="form-status" class="status" role="status" aria-live="polite"></p>
					<p class="login-link">Already registered? <a href="/login/">Log in here</a></p>

					<section id="verification-panel" class="verification-panel" aria-labelledby="verification-title" hidden>
						<h2 id="verification-title">Verify your email</h2>
						<p>Enter the 6-digit code sent to your email address.</p>
						<form id="verification-form">
							<div class="form-field">
								<label for="verification-code">Verification code</label>
								<input id="verification-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required />
							</div>
							<button type="submit">Verify account</button>
						</form>
					</section>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const registrationForm = document.querySelector('#registration-form');
			const verificationForm = document.querySelector('#verification-form');
			const verificationPanel = document.querySelector('#verification-panel');
			const status = document.querySelector('#form-status');
			let userId = sessionStorage.getItem('pending_verify_uid') || '';
			if (userId && verificationPanel) {
				verificationPanel.hidden = false;
				setStatus('Pending email verification. Enter the 6-digit code sent to your email.');
			}

			function setStatus(message) {
				if (status) status.textContent = message;
			}

			async function post(path, body) {
				const response = await fetch(path, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				const responseBody = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(responseBody.message || responseBody.error || 'Something went wrong. Please try again.');
				}
				return responseBody;
			}

			registrationForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!registrationForm.reportValidity()) return;

				const submitButton = registrationForm.querySelector('button');
				const formData = new FormData(registrationForm);
				if (submitButton) submitButton.disabled = true;
				setStatus('Creating account…');

				try {
					const response = await post('/api/auth/register', Object.fromEntries(formData));
					if (!response.user_id) throw new Error('The server returned an invalid registration response.');
					userId = response.user_id;
					sessionStorage.setItem('pending_verify_uid', userId);
					registrationForm.reset();
					if (verificationPanel) verificationPanel.hidden = false;
					setStatus('Account created! Check your email for the verification code.');
					document.querySelector('#verification-code')?.focus();
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Unable to create account.');
				} finally {
					if (submitButton) submitButton.disabled = false;
				}
			});

			verificationForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!verificationForm.reportValidity() || !userId) return;

				const submitButton = verificationForm.querySelector('button');
				const code = new FormData(verificationForm).get('code');
				if (submitButton) submitButton.disabled = true;
				setStatus('Verifying email…');

				try {
					await post('/api/auth/verify', { user_id: userId, code });
					sessionStorage.removeItem('pending_verify_uid');
					verificationForm.reset();
					if (verificationPanel) verificationPanel.hidden = true;
					setStatus('Email verified! Your TeBlocks account is ready. Redirecting to login…');
					setTimeout(() => {
						window.location.assign('/login/');
					}, 1500);
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Unable to verify the code.');
				} finally {
					if (submitButton) submitButton.disabled = false;
				}
			});
		</script>
	</body>
</html>
