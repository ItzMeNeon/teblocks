---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Create account | ${SITE_TITLE}`} description="Create a TeBlocks account for competitive play." />
		<style>
			.account-container {
				max-width: 480px;
				margin: 3.5rem auto 0;
			}
			.account-panel {
				padding: 2.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: #14141e;
				box-shadow: var(--shadow);
			}
			.account-panel h1 {
				margin: 0 0 0.4rem;
				font-size: 1.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.intro {
				color: var(--text-dim);
				font-size: 0.92rem;
				line-height: 1.5;
				margin-bottom: 1.5rem;
			}
			form {
				display: grid;
				gap: 1rem;
			}
			.form-field {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}
			label {
				color: var(--text-dim);
				font-size: 0.82rem;
				font-weight: 700;
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			input {
				width: 100%;
				padding: 0.7rem 0.9rem;
				border: 1px solid var(--border-bright);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font-family: var(--font-ui);
				font-size: 0.92rem;
				transition: border-color var(--transition-fast);
			}
			input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: var(--focus-ring);
			}
			button[type="submit"] {
				width: 100%;
				margin-top: 0.4rem;
				padding: 0.75rem 1.2rem;
				border: 0;
				border-radius: var(--radius);
				background: var(--accent);
				color: #ffffff;
				font-family: var(--font-ui);
				font-size: 0.92rem;
				font-weight: 700;
				cursor: pointer;
				transition: background-color var(--transition-fast);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			button[type="submit"]:hover:not(:disabled) {
				background: #ff88be;
			}
			button[type="submit"]:disabled {
				cursor: wait;
				opacity: 0.6;
			}
			.notice {
				color: var(--text-muted);
				font-size: 0.78rem;
				line-height: 1.4;
				margin: 0.2rem 0 0;
			}
			.network-hint {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0.75rem 0.9rem;
				font-size: 0.82rem;
				color: var(--text-dim);
				line-height: 1.4;
			}
			.network-hint-icon {
				font-size: 1.2rem;
				flex-shrink: 0;
			}
			.status {
				color: var(--text);
				min-height: 1.5em;
				margin: 0.8rem 0 0;
				font-size: 0.88rem;
				text-align: center;
			}
			.login-link {
				margin: 1.2rem 0 0;
				text-align: center;
				color: var(--text-muted);
				font-size: 0.88rem;
			}
			.verification-panel {
				margin-top: 1.8rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
			}
			.verification-panel h2 {
				font-size: 1.25rem;
				margin-bottom: 0.3rem;
			}
			.verification-panel p {
				color: var(--text-dim);
				font-size: 0.88rem;
				margin-bottom: 1rem;
			}
			@media (max-width: 600px) {
				.account-container { margin-top: 2rem; }
				.account-panel { padding: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="account-container">
				<section class="account-panel" aria-labelledby="account-title">
					<h1 id="account-title">Create Account</h1>
					<p class="intro">Register to track ranked rating progress, matchmaking, and player customizations.</p>

					<form id="registration-form">
						<div class="form-field">
							<label for="username">Username</label>
							<input id="username" name="username" type="text" autocomplete="username" minlength="3" maxlength="24" placeholder="3-24 characters" required />
						</div>

						<div class="form-field">
							<label for="email">Email address</label>
							<input id="email" name="email" type="email" autocomplete="email" placeholder="name@example.com" required />
						</div>

						<div class="form-field">
							<label for="password">Password</label>
							<input id="password" name="password" type="password" autocomplete="new-password" minlength="8" placeholder="••••••••" required />
						</div>

						<div class="network-hint">
							<span class="network-hint-icon">🌐</span>
							<span>Your country flag is automatically detected upon registration (osu!-style) and displayed on your profile.</span>
						</div>

						<button type="submit">Register Account</button>
						<p class="notice">Password must be at least 8 characters with uppercase, lowercase, numbers, and symbols.</p>
					</form>
					<p id="form-status" class="status" role="status" aria-live="polite"></p>
					<p class="login-link">Already registered? <a href="/login/">Log in here</a></p>

					<section id="verification-panel" class="verification-panel" aria-labelledby="verification-title" hidden>
						<h2 id="verification-title">Verify your email</h2>
						<p>Enter the 6-digit code sent to your email address.</p>
						<form id="verification-form">
							<div class="form-field">
								<label for="verification-code">Verification code</label>
								<input id="verification-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required />
							</div>
							<div style="display: flex; gap: 0.6rem; margin-top: 0.8rem;">
								<button type="submit" style="flex: 2;">Verify account</button>
								<button type="button" id="resend-code-btn" class="btn btn-secondary" style="flex: 1;">Resend</button>
							</div>
						</form>
					</section>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const registrationForm = document.querySelector('#registration-form');
			const verificationForm = document.querySelector('#verification-form');
			const verificationPanel = document.querySelector('#verification-panel');
			const status = document.querySelector('#form-status');
			let userId = sessionStorage.getItem('pending_verify_uid') || '';
			if (userId && verificationPanel) {
				(verificationPanel as HTMLElement).hidden = false;
				setStatus('Pending email verification. Enter the 6-digit code sent to your email.');
			}

			function setStatus(message: string) {
				if (status) status.textContent = message;
			}

			async function post(path: string, body: any) {
				const response = await fetch(path, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				const responseBody = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(responseBody.message || responseBody.error || 'Something went wrong. Please try again.');
				}
				return responseBody;
			}

			registrationForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(registrationForm as HTMLFormElement).reportValidity()) return;

				const submitButton = registrationForm.querySelector('button');
				const formData = new FormData(registrationForm as HTMLFormElement);
				if (submitButton) submitButton.disabled = true;
				setStatus('Creating account…');

				try {
					const response = await post('/api/auth/register', Object.fromEntries(formData));
					if (!response.user_id) throw new Error('The server returned an invalid registration response.');
					userId = response.user_id;
					sessionStorage.setItem('pending_verify_uid', userId);
					(registrationForm as HTMLFormElement).reset();
					if (verificationPanel) (verificationPanel as HTMLElement).hidden = false;
					setStatus('Account created! Check your email for the verification code.');
					(document.querySelector('#verification-code') as HTMLElement)?.focus();
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Unable to create account.');
				} finally {
					if (submitButton) submitButton.disabled = false;
				}
			});

			verificationForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(verificationForm as HTMLFormElement).reportValidity() || !userId) return;

				const submitButton = verificationForm.querySelector('button');
				const code = new FormData(verificationForm as HTMLFormElement).get('code');
				if (submitButton) submitButton.disabled = true;
				setStatus('Verifying email…');

				try {
					await post('/api/auth/verify', { user_id: userId, code });
					sessionStorage.removeItem('pending_verify_uid');
					(verificationForm as HTMLFormElement).reset();
					if (verificationPanel) (verificationPanel as HTMLElement).hidden = true;
					setStatus('Email verified! Your TeBlocks account is ready. Redirecting to login…');
					setTimeout(() => {
						window.location.assign('/login/');
					}, 1500);
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Unable to verify the code.');
				} finally {
					if (submitButton) submitButton.disabled = false;
				}
			});

			const resendBtn = document.querySelector('#resend-code-btn') as HTMLButtonElement | null;
			resendBtn?.addEventListener('click', async () => {
				if (!userId) {
					setStatus('No pending verification found. Please register first.');
					return;
				}
				if (resendBtn) resendBtn.disabled = true;
				setStatus('Sending new verification code…');
				try {
					await post('/api/auth/send-verification', { user_id: userId });
					setStatus('A new verification code has been sent to your email!');
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Failed to resend code.');
				} finally {
					setTimeout(() => {
						if (resendBtn) resendBtn.disabled = false;
					}, 5000);
				}
			});
		</script>
	</body>
</html>
