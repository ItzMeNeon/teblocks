---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Find players | ${SITE_TITLE}`} description="Search for TeBlocks players by username." />
		<style>
			.search-panel {
				max-width: 760px;
				margin: 2.5rem auto 0;
				padding: 2.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: #14141e;
				box-shadow: var(--shadow);
			}
			.search-panel h1 {
				margin: 0 0 0.3rem;
				font-size: 1.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.search-panel .subtitle {
				margin: 0 0 1.5rem;
				color: var(--text-dim);
				font-size: 0.92rem;
			}
			.search-form {
				display: flex;
				gap: 0.6rem;
			}
			.search-input {
				flex: 1;
				padding: 0.7rem 1rem;
				border: 1px solid var(--border-bright);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font-family: var(--font-ui);
				font-size: 0.95rem;
				transition: border-color var(--transition-fast);
			}
			.search-input::placeholder { color: var(--text-muted); }
			.search-input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: var(--focus-ring);
			}
			.search-btn {
				padding: 0.7rem 1.4rem;
				border: 0;
				border-radius: var(--radius);
				background: var(--accent);
				color: #ffffff;
				font-family: var(--font-ui);
				font-weight: 700;
				font-size: 0.88rem;
				cursor: pointer;
				white-space: nowrap;
				transition: background-color var(--transition-fast);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			.search-btn:hover {
				background: #ff88be;
			}
			.search-btn:disabled { opacity: 0.6; cursor: wait; }
			.results-area {
				margin-top: 1.5rem;
			}

			:global(.result-list) {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			:global(.result-item) {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				padding: 0.8rem 1.1rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				text-decoration: none;
				transition: border-color var(--transition-fast), background-color var(--transition-fast);
			}
			:global(.result-item:hover) {
				border-color: var(--border-bright);
				background: var(--panel-hover);
			}
			:global(.result-avatar) {
				width: 36px;
				height: 36px;
				border-radius: var(--radius-sm);
				background: #1f1f2e;
				display: grid;
				place-items: center;
				color: var(--accent);
				font-family: var(--font-display);
				font-weight: 800;
				font-size: 0.9rem;
				flex-shrink: 0;
				overflow: hidden;
				border: 1px solid var(--border);
			}
			:global(.result-avatar img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			:global(.result-info) {
				flex: 1;
				min-width: 0;
			}
			:global(.result-name) {
				font-weight: 700;
				color: #ffffff;
				font-size: 0.95rem;
			}
			:global(.result-meta) {
				font-size: 0.78rem;
				color: var(--text-muted);
				margin-top: 0.1em;
				font-family: var(--font-mono);
			}
			:global(.result-rank) {
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.2em 0.6em;
				border-radius: var(--radius-sm);
				background: rgba(255, 102, 171, 0.1);
				border: 1px solid rgba(255, 102, 171, 0.25);
				color: var(--accent);
				flex-shrink: 0;
				font-family: var(--font-mono);
			}
			:global(.state) {
				text-align: center;
				padding: 2.2rem 1rem;
				color: var(--text-muted);
				font-size: 0.9rem;
			}
			:global(.state.error) { color: var(--danger); }
			:global(.retry-btn) {
				margin-top: 0.8rem;
				padding: 0.5rem 1.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font: inherit;
				font-weight: 700;
				cursor: pointer;
			}
			:global(.retry-btn:hover) {
				background: var(--panel-hover);
			}
			@media (max-width: 640px) {
				.search-panel { margin-top: 1.5rem; padding: 1.2rem; }
				.search-form { flex-direction: column; }
				.search-btn { width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="search-panel" aria-labelledby="search-title">
				<h1 id="search-title">Find Players</h1>
				<p class="subtitle">Search for TeBlocks players to inspect stats, ratings, and match history.</p>
				<form class="search-form" id="search-form" role="search">
					<label class="sr-only" for="search-query">Username</label>
					<input
						id="search-query"
						class="search-input"
						type="text"
						placeholder="Enter username..."
						autocomplete="off"
						minlength="2"
						maxlength="24"
						required
					/>
					<button class="search-btn" type="submit">Search</button>
				</form>
				<div class="results-area" id="results-area"></div>
			</section>
		</main>
		<Footer />
		<script>
			const form = document.getElementById('search-form');
			const input = document.getElementById('search-query') as HTMLInputElement | null;
			const resultsArea = document.getElementById('results-area');

			function escapeHtml(str: string) {
				return String(str || '').replace(/[&<>"']/g, (c) => ({
					'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
				}[c as keyof { '&': string; '<': string; '>': string; '"': string; "'": string }]));
			}

			function avatarLetter(name: string) {
				return escapeHtml((name || '?').slice(0, 1).toUpperCase());
			}

			function renderResults(entries: any[]) {
				if (!resultsArea) return;
				if (!entries || !entries.length) {
					resultsArea.innerHTML = '<p class="state">No players found. Try a different search term.</p>';
					return;
				}
				resultsArea.innerHTML = `
					<ul class="result-list">
						${entries.map((entry) => `
							<li>
								<a class="result-item" href="/profile/${encodeURIComponent(entry.user_id || entry.id || '')}">
									<div class="result-avatar">
										${entry.avatar_url ? `<img src="${encodeURI(entry.avatar_url)}" alt="">` : avatarLetter(entry.username)}
									</div>
									<div class="result-info">
										<div class="result-name">${escapeHtml(entry.username || 'Unknown')}</div>
										<div class="result-meta">${escapeHtml(entry.rank || 'Unranked')}${entry.rating != null ? ` · ${Number(entry.rating)} rating` : ''}</div>
									</div>
									${entry.rank && entry.rank !== 'Unranked' ? `<span class="result-rank">${escapeHtml(entry.rank)}</span>` : ''}
								</a>
							</li>
						`).join('')}
					</ul>
				`;
			}

			async function searchUsers(query: string, attempts = 2) {
				if (!resultsArea) return;
				resultsArea.innerHTML = '<p class="state" role="status">Searching...</p>';
				for (let attempt = 0; attempt < attempts; attempt += 1) {
					try {
						const controller = new AbortController();
						const timeout = window.setTimeout(() => controller.abort(), 8000);
						const response = await fetch(`/api/users?q=${encodeURIComponent(query)}&limit=10`, { signal: controller.signal });
						window.clearTimeout(timeout);
						if (response.status === 404 || response.status === 405) {
							resultsArea.innerHTML = '<p class="state">Player search is not available yet.</p>';
							return;
						}
						if (!response.ok) {
							const body = await response.json().catch(() => ({}));
							resultsArea.innerHTML = `<p class="state error">${body.error || 'Search failed.'}</p>`;
							return;
						}
						const data = await response.json();
						const entries = data.entries || data.players || data.users || data;
						renderResults(entries);
						return;
					} catch {
						if (attempt === attempts - 1) {
							resultsArea.innerHTML = `
								<p class="state error">Search is temporarily unavailable.</p>
								<button class="retry-btn" type="button">Retry</button>
							`;
							resultsArea.querySelector('.retry-btn')?.addEventListener('click', () => searchUsers(query));
						} else {
							await new Promise((resolve) => window.setTimeout(resolve, 400 * (attempt + 1)));
						}
					}
				}
			}

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const query = input?.value.trim();
				if (!query || query.length < 2) return;
				searchUsers(query);
			});

			const urlParams = new URLSearchParams(window.location.search);
			const initialQuery = urlParams.get('q');
			if (initialQuery && input) {
				input.value = initialQuery;
				searchUsers(initialQuery);
			}
		</script>
	</body>
</html>
