---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Find players | ${SITE_TITLE}`} description="Search for TeBlocks players by username." />
		<style>
			.search-panel {
				max-width: 760px;
				margin: 3.5rem auto 0;
				padding: 2.5rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: var(--panel);
				box-shadow: var(--shadow);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
			}
			.search-panel h1 {
				margin: 0 0 0.4rem;
				font-size: 2rem;
			}
			.search-panel .subtitle {
				margin: 0 0 1.8rem;
				color: var(--text-dim);
				font-size: 1rem;
			}
			.search-form {
				display: flex;
				gap: 0.75rem;
			}
			.search-input {
				flex: 1;
				padding: 0.8rem 1.1rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font-family: var(--font-ui);
				font-size: 1rem;
				transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
			}
			.search-input::placeholder { color: var(--text-muted); }
			.search-input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: var(--focus-ring);
			}
			.search-btn {
				padding: 0.8rem 1.6rem;
				border: 0;
				border-radius: 999px;
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				color: #001a1c;
				font-family: var(--font-ui);
				font-weight: 700;
				font-size: 0.95rem;
				cursor: pointer;
				white-space: nowrap;
				box-shadow: 0 4px 16px var(--accent-glow);
				transition: all var(--transition-fast);
			}
			.search-btn:hover {
				filter: brightness(1.08);
				box-shadow: 0 6px 20px var(--accent-glow-strong);
				transform: translateY(-1px);
			}
			.search-btn:disabled { opacity: 0.6; cursor: wait; }
			.results-area {
				margin-top: 1.8rem;
			}

			:global(.result-list) {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}
			:global(.result-item) {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 0.9rem 1.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: rgba(255, 255, 255, 0.03);
				text-decoration: none;
				transition: all var(--transition-fast);
			}
			:global(.result-item:hover) {
				border-color: var(--border-bright);
				background: var(--panel-hover);
				transform: translateX(4px);
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
			}
			:global(.result-avatar) {
				width: 40px;
				height: 40px;
				border-radius: 10px;
				background: linear-gradient(135deg, var(--i), var(--j));
				display: grid;
				place-items: center;
				color: #001a1c;
				font-family: var(--font-display);
				font-weight: 800;
				font-size: 0.95rem;
				flex-shrink: 0;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.15);
			}
			:global(.result-avatar img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			:global(.result-info) {
				flex: 1;
				min-width: 0;
			}
			:global(.result-name) {
				font-weight: 700;
				color: var(--text);
				font-size: 1rem;
			}
			:global(.result-meta) {
				font-size: 0.82rem;
				color: var(--text-muted);
				margin-top: 0.2em;
				font-family: var(--font-mono);
			}
			:global(.result-rank) {
				font-size: 0.74rem;
				font-weight: 700;
				padding: 0.25em 0.7em;
				border-radius: 6px;
				background: rgba(62, 166, 195, 0.1);
				border: 1px solid var(--border);
				color: var(--accent);
				flex-shrink: 0;
			}
			:global(.state) {
				text-align: center;
				padding: 2.5rem 1rem;
				color: var(--text-muted);
			}
			:global(.state.error) { color: var(--danger); }
			:global(.retry-btn) {
				margin-top: 1rem;
				padding: 0.6rem 1.3rem;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.05);
				color: var(--text);
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}
			:global(.retry-btn:hover) {
				background: var(--panel-hover);
				border-color: var(--border-bright);
			}
			@media (max-width: 640px) {
				.search-panel { margin-top: 2rem; padding: 1.5rem; }
				.search-form { flex-direction: column; }
				.search-btn { width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="search-panel" aria-labelledby="search-title">
				<p class="eyebrow" style="--accent-color: var(--j)">Community</p>
				<h1 id="search-title">Find players</h1>
				<p class="subtitle">Search for TeBlocks players by username to view stats, ratings, and match history.</p>
				<form class="search-form" id="search-form" role="search">
					<label class="sr-only" for="search-query">Username</label>
					<input
						id="search-query"
						class="search-input"
						type="text"
						placeholder="Search username..."
						autocomplete="off"
						minlength="2"
						maxlength="24"
						required
					/>
					<button class="search-btn" type="submit">Search</button>
				</form>
				<div class="results-area" id="results-area"></div>
			</section>
		</main>
		<Footer />
		<script>
			const form = document.getElementById('search-form');
			const input = document.getElementById('search-query');
			const resultsArea = document.getElementById('results-area');

			function escapeHtml(str) {
				return String(str || '').replace(/[&<>"']/g, (c) => ({
					'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
				}[c]));
			}

			function avatarLetter(name) {
				return escapeHtml((name || '?').slice(0, 1).toUpperCase());
			}

			function renderResults(entries) {
				if (!entries || !entries.length) {
					resultsArea.innerHTML = '<p class="state">No players found. Try a different search term.</p>';
					return;
				}
				resultsArea.innerHTML = `
					<ul class="result-list">
						${entries.map((entry) => `
							<li>
								<a class="result-item" href="/profile/${encodeURIComponent(entry.user_id || entry.id || '')}">
									<div class="result-avatar">
										${entry.avatar_url ? `<img src="${encodeURI(entry.avatar_url)}" alt="">` : avatarLetter(entry.username)}
									</div>
									<div class="result-info">
										<div class="result-name">${escapeHtml(entry.username || 'Unknown')}</div>
										<div class="result-meta">${escapeHtml(entry.rank || 'Unranked')}${entry.rating != null ? ` · ${Number(entry.rating)} rating` : ''}</div>
									</div>
									${entry.rank && entry.rank !== 'Unranked' ? `<span class="result-rank">${escapeHtml(entry.rank)}</span>` : ''}
								</a>
							</li>
						`).join('')}
					</ul>
				`;
			}

			async function searchUsers(query, attempts = 2) {
				resultsArea.innerHTML = '<p class="state" role="status">Searching...</p>';
				for (let attempt = 0; attempt < attempts; attempt += 1) {
					try {
						const controller = new AbortController();
						const timeout = window.setTimeout(() => controller.abort(), 8000);
						const response = await fetch(`/api/users?q=${encodeURIComponent(query)}&limit=10`, { signal: controller.signal });
						window.clearTimeout(timeout);
						if (response.status === 404 || response.status === 405) {
							resultsArea.innerHTML = '<p class="state">Player search is not available yet.</p>';
							return;
						}
						if (!response.ok) {
							const body = await response.json().catch(() => ({}));
							resultsArea.innerHTML = `<p class="state error">${body.error || 'Search failed.'}</p>`;
							return;
						}
						const data = await response.json();
						const entries = data.entries || data.players || data.users || data;
						renderResults(entries);
						return;
					} catch {
						if (attempt === attempts - 1) {
							resultsArea.innerHTML = `
								<p class="state error">Search is temporarily unavailable.</p>
								<button class="retry-btn" type="button">Retry</button>
							`;
							resultsArea.querySelector('.retry-btn')?.addEventListener('click', () => searchUsers(query));
						} else {
							await new Promise((resolve) => window.setTimeout(resolve, 400 * (attempt + 1)));
						}
					}
				}
			}

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				const query = input?.value.trim();
				if (!query || query.length < 2) return;
				searchUsers(query);
			});

			const urlParams = new URLSearchParams(window.location.search);
			const initialQuery = urlParams.get('q');
			if (initialQuery && input) {
				input.value = initialQuery;
				searchUsers(initialQuery);
			}
		</script>
	</body>
</html>
