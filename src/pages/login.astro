---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Log in | ${SITE_TITLE}`} description="Log in to your TeBlocks account." />
		<style>
			.login-container {
				max-width: 420px;
				margin: 3.5rem auto 0;
			}
			.login-panel {
				padding: 2.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: #14141e;
				box-shadow: var(--shadow);
			}
			.login-panel h1 {
				margin: 0 0 1.2rem;
				font-size: 1.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			form {
				display: grid;
				gap: 1rem;
			}
			.form-field {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}
			label {
				color: var(--text-dim);
				font-size: 0.82rem;
				font-weight: 700;
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			input {
				width: 100%;
				padding: 0.7rem 0.9rem;
				border: 1px solid var(--border-bright);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font-family: var(--font-ui);
				font-size: 0.92rem;
				transition: border-color var(--transition-fast);
			}
			input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: var(--focus-ring);
			}
			button[type="submit"] {
				width: 100%;
				margin-top: 0.4rem;
				padding: 0.75rem 1.2rem;
				border: 0;
				border-radius: var(--radius);
				background: var(--accent);
				color: #ffffff;
				font-family: var(--font-ui);
				font-size: 0.92rem;
				font-weight: 700;
				cursor: pointer;
				transition: background-color var(--transition-fast);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			button[type="submit"]:hover:not(:disabled) {
				background: #ff88be;
			}
			button[type="submit"]:disabled {
				cursor: wait;
				opacity: 0.6;
			}
			#form-status {
				min-height: 1.5em;
				margin: 0.8rem 0 0;
				color: var(--text-dim);
				font-size: 0.85rem;
				text-align: center;
			}
			.footer-hint {
				margin: 1.2rem 0 0;
				text-align: center;
				color: var(--text-muted);
				font-size: 0.88rem;
			}
			@media (max-width: 600px) {
				.login-container { margin-top: 2rem; }
				.login-panel { padding: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="login-container">
				<section class="login-panel" aria-labelledby="login-title">
					<h1 id="login-title">Player Log In</h1>
					<form id="login-form">
						<div class="form-field">
							<label for="username">Username</label>
							<input id="username" name="username" type="text" autocomplete="username" placeholder="Your username" required />
						</div>
						<div class="form-field">
							<label for="password">Password</label>
							<input id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required />
						</div>
						<button type="submit">Log in</button>
					</form>
					<p id="form-status" role="status" aria-live="polite"></p>
					<p class="footer-hint">Need an account? <a href="/account/">Register here</a>.</p>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const form = document.querySelector('#login-form');
			const status = document.querySelector('#form-status');

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!(form as HTMLFormElement).reportValidity()) return;

				const submitButton = form.querySelector('button');
				if (submitButton) submitButton.disabled = true;
				if (status) status.textContent = 'Logging in…';
				try {
					const response = await fetch('/api/auth/login', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(Object.fromEntries(new FormData(form as HTMLFormElement))),
					});
					const body = await response.json().catch(() => ({}));
					if (!response.ok) throw new Error(body.message || body.error || 'Unable to log in.');
					if (body.token) localStorage.setItem('teblocks_token', body.token);
					if (body.user_id) localStorage.setItem('teblocks_user_id', body.user_id);
					if (body.username) localStorage.setItem('teblocks_username', body.username);
					(form as HTMLFormElement).reset();
					window.location.assign(body.user_id ? `/profile/${body.user_id}` : '/profile/');
				} catch (error) {
					if (status) status.textContent = error instanceof Error ? error.message : 'Unable to log in.';
					if (submitButton) submitButton.disabled = false;
				}
			});
		</script>
	</body>
</html>
