---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Learn about TeBlocks, the open source competitive tetromino stacking game." />
		<style>
			.about-container {
				max-width: 860px;
				margin: 3.5rem auto 0;
			}
			.about-header {
				margin-bottom: 2.5rem;
			}
			.about-header h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2.2rem, 5vw, 3rem);
			}
			.about-header p {
				color: var(--text-dim);
				font-size: 1.15rem;
				line-height: 1.6;
			}
			.about-card {
				padding: 2.5rem;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				background: var(--panel);
				box-shadow: var(--shadow);
				margin-bottom: 2rem;
			}
			.about-card h2 {
				font-size: 1.5rem;
				margin: 2rem 0 1rem;
				color: var(--text);
			}
			.about-card h2:first-of-type {
				margin-top: 0;
			}
			.about-card p {
				color: var(--text-dim);
				line-height: 1.75;
				font-size: 1.02rem;
				margin-bottom: 1.2rem;
			}
			.feature-list {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 2rem;
				display: grid;
				grid-template-columns: 1fr;
				gap: 1rem;
			}
			.feature-item {
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
				padding: 1rem 1.2rem;
				border-radius: var(--radius-sm);
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid var(--border);
			}
			.feature-icon {
				display: grid;
				place-items: center;
				width: 32px;
				height: 32px;
				border-radius: 8px;
				background: rgba(62, 166, 195, 0.15);
				color: var(--accent);
				flex-shrink: 0;
				margin-top: 0.1rem;
			}
			.feature-text strong {
				display: block;
				color: var(--text);
				font-size: 0.98rem;
				margin-bottom: 0.2rem;
			}
			.feature-text span {
				color: var(--text-dim);
				font-size: 0.88rem;
				line-height: 1.5;
			}
			.actions-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin-top: 2rem;
			}
			@media (max-width: 680px) {
				.about-container { margin-top: 2rem; }
				.about-card { padding: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-container">
				<header class="about-header">
					<p class="eyebrow" style="--accent-color: var(--accent)">Project & Mission</p>
					<h1>About TeBlocks</h1>
					<p>A competitive, open source block stacking game engineered for responsive gameplay, fair multiplayer, and community competition.</p>
				</header>

				<article class="about-card">
					<h2>The Vision</h2>
					<p>
						<strong>TeBlocks</strong> is a modern, fast-paced tetromino stacking game built with Lua and LÖVE 11.5, forked and evolved from the legendary <a href="https://github.com/26f-studio/Techmino" target="_blank" rel="noopener noreferrer">Techmino</a> project.
					</p>
					<p>
						We believe block stacking competition should be accessible, lightweight, transparent, and completely free from pay-to-win mechanics or proprietary lock-in. Whether you're a casual player looking to speedrun 40 Lines or a competitive veteran climbing the 1v1 ELO ladder, TeBlocks is designed to provide the cleanest stacking experience possible.
					</p>

					<h2>Key Architecture & Highlights</h2>
					<ul class="feature-list">
						<li class="feature-item">
							<div class="feature-icon">⚡</div>
							<div class="feature-text">
								<strong>Client-Simulated Physics (Zero Input Lag)</strong>
								<span>Piece movement, SRS rotation, and handling are simulated locally on the client for instantaneous, sub-frame response times, while WebSocket streams relay live attack and garbage events.</span>
							</div>
						</li>
						<li class="feature-item">
							<div class="feature-icon">🛡️</div>
							<div class="feature-text">
								<strong>Server-Side Replay Verification</strong>
								<span>Ranked match outcomes are verified server-side against the match seed and replay event streams before ELO rating is awarded, preventing falsified match results.</span>
							</div>
						</li>
						<li class="feature-item">
							<div class="feature-icon">🏆</div>
							<div class="feature-text">
								<strong>Competitive Ranked & Casual Modes</strong>
								<span>Skill-based ELO matchmaking with placement tiers, detailed match history, custom casual rooms, and single-player speedruns.</span>
							</div>
						</li>
						<li class="feature-item">
							<div class="feature-icon">🎨</div>
							<div class="feature-text">
								<strong>Open Skinning & Community Hub</strong>
								<span>Customize your board, tetromino blocks, ghost piece, and sound effects with full community skin repository support.</span>
							</div>
						</li>
						<li class="feature-item">
							<div class="feature-icon">💻</div>
							<div class="feature-text">
								<strong>Lightweight & Cross-Platform</strong>
								<span>Native packages for Windows, Android, and Linux that run smoothly on modern rigs, mobile devices, and modest hardware alike.</span>
							</div>
						</li>
					</ul>

					<h2>Open Source & Community</h2>
					<p>
						TeBlocks is distributed under the GNU Lesser General Public License (LGPLv3). We actively welcome community contributions, bug reports, skins, and documentation improvements.
					</p>
					<div class="actions-row">
						<a class="btn btn-primary" href="https://github.com/ItzMeNeon/teblocks" target="_blank" rel="noopener noreferrer">
							View GitHub Repository
						</a>
						<a class="btn btn-secondary" href="https://discord.gg/BzAVavk54B" target="_blank" rel="noopener noreferrer">
							Join the Discord
						</a>
					</div>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>
