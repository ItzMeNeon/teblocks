---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { ACHIEVEMENTS, getTierColor } from '../lib/achievements';

const totalPoints = ACHIEVEMENTS.reduce((sum, a) => sum + a.points, 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Achievements | ${SITE_TITLE}`}
			description="Explore TeBlocks player achievements, milestones, and competitive badges."
		/>
		<style>
			.achievements-hero {
				padding: 2.5rem 0 1.8rem;
				text-align: center;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2rem;
			}
			.achievements-hero h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin: 0 0 0.5rem;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.achievements-hero p {
				color: var(--text-dim);
				max-width: 600px;
				margin: 0 auto;
				font-size: 0.95rem;
				line-height: 1.5;
			}

			/* Player Summary Card */
			.player-progress-card {
				background: #14141e;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.4rem 1.8rem;
				margin-bottom: 2rem;
				box-shadow: var(--shadow);
			}
			.progress-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.8rem;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.progress-header h2 {
				font-size: 1.2rem;
				margin: 0;
			}
			.progress-stats {
				display: flex;
				gap: 1.5rem;
				font-size: 0.88rem;
			}
			.progress-stat strong {
				color: var(--accent);
				font-size: 1.05rem;
				font-family: var(--font-mono);
			}
			.progress-bar-bg {
				width: 100%;
				height: 8px;
				background: var(--bg-elevated);
				border-radius: var(--radius-sm);
				overflow: hidden;
				border: 1px solid var(--border);
			}
			.progress-bar-fill {
				height: 100%;
				width: 0%;
				background: var(--accent);
				transition: width 0.6s ease;
			}

			/* Category Filters */
			.filter-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1.8rem;
				flex-wrap: wrap;
			}
			.filter-tabs {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			.filter-btn {
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				color: var(--text-dim);
				padding: 0.4rem 0.9rem;
				border-radius: var(--radius-sm);
				font-family: var(--font-ui);
				font-size: 0.82rem;
				font-weight: 700;
				cursor: pointer;
				transition: all var(--transition-fast);
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}
			.filter-btn:hover {
				color: #ffffff;
				border-color: var(--border-bright);
			}
			.filter-btn.active {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
			}

			/* Achievements Grid */
			.achievements-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1rem;
				margin-bottom: 3.5rem;
			}
			.achievement-card {
				background: #14141e;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.2rem;
				display: flex;
				gap: 1rem;
				position: relative;
				overflow: hidden;
				box-shadow: var(--shadow);
				transition: border-color var(--transition-fast);
			}
			.achievement-card:hover {
				border-color: var(--border-bright);
			}
			.achievement-card.unlocked {
				border-color: var(--card-border, var(--border));
				background: #171724;
			}
			.achievement-card.locked {
				opacity: 0.6;
			}
			.achievement-icon-wrap {
				width: 44px;
				height: 44px;
				border-radius: var(--radius-sm);
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				flex-shrink: 0;
			}
			.achievement-card.unlocked .achievement-icon-wrap {
				border-color: var(--card-border);
			}
			.achievement-body {
				flex: 1;
				min-width: 0;
			}
			.achievement-top {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 0.25rem;
				gap: 0.4rem;
			}
			.achievement-title {
				margin: 0;
				font-size: 0.98rem;
				font-weight: 700;
				color: #ffffff;
			}
			.tier-badge {
				font-size: 0.65rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 2px 6px;
				border-radius: var(--radius-sm);
				border: 1px solid currentColor;
				font-family: var(--font-mono);
			}
			.achievement-desc {
				color: var(--text-dim);
				font-size: 0.84rem;
				line-height: 1.4;
				margin: 0 0 0.6rem;
			}
			.achievement-progress-info {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.76rem;
				color: var(--text-muted);
				font-family: var(--font-mono);
			}
			.achievement-pts {
				font-weight: 700;
				color: var(--accent);
			}
			.achievement-status-tag {
				font-weight: 600;
			}
			.achievement-card.unlocked .achievement-status-tag {
				color: var(--success);
			}

			@media (max-width: 600px) {
				.achievements-hero h1 { font-size: 1.8rem; }
				.player-progress-card { padding: 1.1rem; }
				.progress-header { flex-direction: column; align-items: flex-start; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="achievements-hero">
				<h1>TeBlocks Badges</h1>
				<p>
					Unlock badges across speed, competitive duels, milestones, and community participation. Earn points and showcase your legacy.
				</p>
			</section>

			<!-- Player Progress Card (populated dynamically for logged in users) -->
			<section id="player-progress-section" class="player-progress-card" hidden>
				<div class="progress-header">
					<div>
						<h2 id="player-greeting">Your Achievements</h2>
						<span id="player-rank-sub" style="font-size: 0.8rem; color: var(--text-dim);">Live profile tracker</span>
					</div>
					<div class="progress-stats">
						<div class="progress-stat">
							<span>Unlocked: </span>
							<strong id="unlocked-count">0</strong> / {ACHIEVEMENTS.length}
						</div>
						<div class="progress-stat">
							<span>Points: </span>
							<strong id="points-count">0</strong> / {totalPoints}
						</div>
					</div>
				</div>
				<div class="progress-bar-bg">
					<div id="overall-progress-bar" class="progress-bar-fill"></div>
				</div>
			</section>

			<!-- Filter Navigation -->
			<div class="filter-bar">
				<div class="filter-tabs" role="tablist">
					<button class="filter-btn active" data-filter="all">All ({ACHIEVEMENTS.length})</button>
					<button class="filter-btn" data-filter="sprint">Sprint 40L</button>
					<button class="filter-btn" data-filter="ranked">Ranked Duels</button>
					<button class="filter-btn" data-filter="dedication">Dedication</button>
					<button class="filter-btn" data-filter="identity">Identity & Region</button>
				</div>
				<span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">{totalPoints} Total Points Available</span>
			</div>

			<!-- Achievements Grid -->
			<div class="achievements-grid" id="achievements-grid">
				{ACHIEVEMENTS.map((ach) => {
					const colors = getTierColor(ach.tier);
					return (
						<article
							class="achievement-card"
							id={`ach-${ach.id}`}
							data-category={ach.category}
							data-id={ach.id}
							data-tier={ach.tier}
							style={`--card-border: ${colors.border}; --card-bg: ${colors.bg}; --card-text: ${colors.text};`}
						>
							<div class="achievement-icon-wrap" aria-hidden="true">
								<i class={ach.icon}></i>
							</div>
							<div class="achievement-body">
								<div class="achievement-top">
									<h3 class="achievement-title">{ach.title}</h3>
									<span class="tier-badge" style={`color: ${colors.text}; border-color: ${colors.border};`}>
										{ach.tier}
									</span>
								</div>
								<p class="achievement-desc">{ach.description}</p>
								<div class="achievement-progress-info">
									<span class="achievement-pts">+{ach.points} pts</span>
									<span class="achievement-status-tag" id={`status-${ach.id}`}>
										Locked
									</span>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</main>
		<Footer />

		<script>
			import { evaluatePlayerAchievements } from '../lib/achievements';

			const progressSection = document.getElementById('player-progress-section');
			const unlockedCountEl = document.getElementById('unlocked-count');
			const pointsCountEl = document.getElementById('points-count');
			const progressBar = document.getElementById('overall-progress-bar');
			const greeting = document.getElementById('player-greeting');

			// Category filter logic
			const filterBtns = document.querySelectorAll('.filter-btn');
			const cards = document.querySelectorAll('.achievement-card');

			filterBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					filterBtns.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					const category = btn.getAttribute('data-filter');

					cards.forEach((card) => {
						const cardCategory = card.getAttribute('data-category');
						if (category === 'all' || cardCategory === category) {
							(card as HTMLElement).style.display = 'flex';
						} else {
							(card as HTMLElement).style.display = 'none';
						}
					});
				});
			});

			// Fetch player stats if logged in to evaluate achievement progress
			async function loadPlayerAchievements() {
				const token = localStorage.getItem('teblocks_token');
				if (!token) return;

				try {
					const res = await fetch('/api/profile/me', {
						headers: { Authorization: `Bearer ${token}` },
					});
					if (!res.ok) return;

					const profile = await res.json();
					if (!profile || !profile.user_id) return;

					// Evaluate achievements against profile data
					const result = evaluatePlayerAchievements(profile);

					if (progressSection) progressSection.hidden = false;
					if (greeting) greeting.textContent = `${profile.username}'s Achievements`;
					if (unlockedCountEl) unlockedCountEl.textContent = result.unlockedCount.toString();
					if (pointsCountEl) pointsCountEl.textContent = result.totalPoints.toString();
					if (progressBar) progressBar.style.width = `${result.completionPercentage}%`;

					result.achievements.forEach((ach) => {
						const card = document.getElementById(`ach-${ach.id}`);
						const statusEl = document.getElementById(`status-${ach.id}`);

						if (card && statusEl) {
							if (ach.unlocked) {
								card.classList.add('unlocked');
								card.classList.remove('locked');
								statusEl.textContent = '✓ Unlocked';
							} else {
								card.classList.add('locked');
								card.classList.remove('unlocked');
								statusEl.textContent = ach.progressText || 'In Progress';
							}
						}
					});
				} catch {}
			}

			loadPlayerAchievements();
		</script>
	</body>
</html>
