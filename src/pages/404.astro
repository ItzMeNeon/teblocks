---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="The page you're looking for doesn't exist or has been moved." />
		<style>
			.not-found {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 60vh;
				text-align: center;
				padding: 3rem 1.5rem;
				gap: 1rem;
			}
			.not-found-code {
				font-family: var(--font-display);
				font-weight: 900;
				font-size: clamp(5rem, 14vw, 8rem);
				line-height: 1;
				color: var(--accent);
				margin: 0;
			}
			.not-found h1 {
				font-size: clamp(1.5rem, 3.5vw, 2.2rem);
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				margin: 0;
			}
			.not-found p {
				max-width: 44ch;
				color: var(--text-dim);
				font-size: 1rem;
				line-height: 1.6;
			}
			.not-found-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				justify-content: center;
				margin-top: 0.5rem;
			}
			@media (max-width: 640px) {
				.not-found { min-height: 50vh; padding: 2rem 1rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="not-found" aria-labelledby="not-found-title">
				<p class="not-found-code" aria-hidden="true">404</p>
				<h1 id="not-found-title">Piece Out of Bounds</h1>
				<p>The page you requested doesn't exist or has been shifted off the board. Return home or check the leaderboards.</p>
				<div class="not-found-actions">
					<a class="btn btn-primary" href="/">Go Home</a>
					<a class="btn btn-secondary" href="/leaderboards/">Leaderboards</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
