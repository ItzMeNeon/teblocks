---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Leaderboards | ${SITE_TITLE}`} description="Top players and rankings across all game modes." />
		<style>
			.leaderboard-panel {
				max-width: 980px;
				margin: 2.5rem auto 0;
			}
			.leaderboard-header {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1.5rem;
				margin-bottom: 1.5rem;
				flex-wrap: wrap;
			}
			.leaderboard-header h1 {
				margin: 0;
				font-size: clamp(1.8rem, 4vw, 2.5rem);
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.leaderboard-header p {
				margin: 0.2rem 0 0;
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.mode-tabs {
				display: flex;
				gap: 0.35rem;
				padding: 0.3rem;
				border-radius: var(--radius);
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				flex-wrap: wrap;
			}
			.mode-tab {
				padding: 0.45rem 1rem;
				border-radius: var(--radius-sm);
				border: 1px solid transparent;
				background: transparent;
				color: var(--text-dim);
				font-family: var(--font-ui);
				font-weight: 700;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all var(--transition-fast);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			.mode-tab:hover {
				color: #ffffff;
				background: rgba(255, 255, 255, 0.04);
			}
			.mode-tab[aria-selected="true"] {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
			}
			.table-card {
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: #14141e;
				overflow: hidden;
				box-shadow: var(--shadow);
			}
			.mode-info-banner {
				display: flex;
				align-items: center;
				gap: 1.1rem;
				padding: 1rem 1.4rem;
				margin-bottom: 1.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: #14141e;
				box-shadow: var(--shadow-sm);
			}
			.mode-info-icon {
				width: 44px;
				height: 44px;
				background: rgba(0, 194, 255, 0.1);
				border: 1px solid rgba(0, 194, 255, 0.25);
				border-radius: var(--radius);
				display: grid;
				place-items: center;
				color: var(--accent);
				font-size: 1.25rem;
				flex-shrink: 0;
			}
			.mode-info-text {
				flex: 1;
				min-width: 0;
			}
			.mode-info-title {
				margin: 0 0 0.15rem;
				font-size: 1.05rem;
				font-weight: 800;
				color: #ffffff;
			}
			.mode-info-desc {
				margin: 0;
				font-size: 0.86rem;
				color: var(--text-dim);
				line-height: 1.4;
			}
			.mode-tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
				margin-top: 0.45rem;
			}
			.mode-tag {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 700;
				padding: 0.15em 0.55em;
				border-radius: var(--radius-sm);
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				color: var(--text-muted);
			}
			.empty-state-cell {
				text-align: center;
				padding: 3.5rem 1.5rem !important;
			}
			.empty-state-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.7rem;
				max-width: 480px;
				margin: 0 auto;
			}
			.empty-icon {
				font-size: 2.2rem;
				color: var(--accent);
				margin-bottom: 0.2rem;
			}
			.empty-title {
				font-size: 1.15rem;
				font-weight: 800;
				color: #ffffff;
			}
			.empty-desc {
				margin: 0;
				color: var(--text-dim);
				font-size: 0.88rem;
				line-height: 1.5;
			}
			.empty-actions {
				display: flex;
				gap: 0.6rem;
				margin-top: 0.6rem;
				flex-wrap: wrap;
				justify-content: center;
			}
			@media (max-width: 680px) {
				.leaderboard-panel { margin-top: 1.5rem; }
				.leaderboard-header { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
				.mode-tabs { width: 100%; }
				.mode-tab { flex: 1; text-align: center; padding: 0.4rem 0.6rem; font-size: 0.76rem; }
				.mode-info-banner { flex-direction: column; align-items: flex-start; }
			}
		</style>
		<style is:global>
			.leaderboard-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.92rem;
			}
			.leaderboard-table thead th {
				text-align: left;
				padding: 0.75rem 1.1rem;
				border-bottom: 1px solid var(--border);
				color: var(--text-muted);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: #0f0f16;
				font-family: var(--font-mono);
			}
			.leaderboard-table tbody tr {
				border-bottom: 1px solid var(--border);
				transition: background 0.12s ease;
			}
			.leaderboard-table tbody tr:hover {
				background: var(--panel-hover);
			}
			.leaderboard-table tbody tr:last-child {
				border-bottom: 0;
			}
			.leaderboard-table td {
				padding: 0.75rem 1.1rem;
				vertical-align: middle;
			}
			.rank-cell {
				font-family: var(--font-mono);
				font-weight: 800;
				font-size: 0.92rem;
				color: var(--text-muted);
				width: 3.5rem;
			}
			.rank-cell.rank-1 { color: #ffd700; font-weight: 900; }
			.rank-cell.rank-2 { color: #e0e0e0; font-weight: 900; }
			.rank-cell.rank-3 { color: #ff9f73; font-weight: 900; }
			.player-cell {
				display: flex;
				align-items: center;
				gap: 0.75em;
				min-width: 0;
			}
			.player-avatar {
				width: 32px;
				height: 32px;
				border-radius: var(--radius-sm);
				background: var(--bg-elevated);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--accent);
				font-family: var(--font-display);
				font-weight: 800;
				font-size: 0.85rem;
				flex-shrink: 0;
				overflow: hidden;
				border: 1px solid var(--border);
			}
			.player-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.player-name {
				font-weight: 700;
				color: #ffffff;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				text-decoration: none;
				transition: color 0.12s ease;
			}
			.player-name:hover { color: var(--accent); }
			.rank-badge {
				display: inline-block;
				padding: 0.2em 0.55em;
				border-radius: var(--radius-sm);
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid var(--border);
				font-size: 0.72rem;
				font-weight: 700;
				color: var(--text-dim);
				letter-spacing: 0.03em;
				font-family: var(--font-mono);
			}
			.stat-cell {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: #ffffff;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.stat-cell.dim { color: var(--text-dim); font-weight: 500; }
			.win-rate { font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
			.state {
				text-align: center;
				padding: 3rem 1.5rem;
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.state.error { color: var(--danger); }
			.retry-btn {
				margin-top: 0.8rem;
				padding: 0.5rem 1.2rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--bg-elevated);
				color: var(--text);
				font: inherit;
				font-weight: 700;
				cursor: pointer;
				transition: background 0.12s ease;
			}
			.retry-btn:hover { background: var(--panel-hover); border-color: var(--border-bright); }
			@media (max-width: 640px) {
				.leaderboard-table thead th,
				.leaderboard-table td { padding: 0.65rem 0.75rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="leaderboard-panel" aria-labelledby="leaderboard-title">
				<div class="leaderboard-header">
					<div>
						<h1 id="leaderboard-title">Leaderboards</h1>
						<p>Global rankings across ranked 1v1 and speedrun categories</p>
					</div>
					<div class="mode-tabs" role="tablist" aria-label="Leaderboard category">
						<button class="mode-tab" role="tab" aria-selected="true" data-category="ranked"><i class="fa-solid fa-trophy"></i> Ranked Elo</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="daily"><i class="fa-solid fa-calendar-day"></i> Daily Challenge</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="lines40"><i class="fa-solid fa-stopwatch"></i> 40 Lines</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="sprint"><i class="fa-solid fa-gauge-high"></i> Sprint 100L</button>
					</div>
				</div>
				<div class="mode-info-banner" id="mode-info-banner" aria-live="polite"></div>
				<div class="table-card">
					<div id="leaderboard-content">
						<div class="state" role="status">Loading leaderboard...</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const content = document.getElementById('leaderboard-content');
			const banner = document.getElementById('mode-info-banner');
			const tabs = document.querySelectorAll('.mode-tab');

			interface CategoryConfig {
				kind: 'ranked' | 'daily' | 'sprint';
				url: string;
				title: string;
				desc: string;
				icon: string;
				tags: string[];
				emptyHint: string;
			}

			const categories: Record<string, CategoryConfig> = {
				ranked: {
					kind: 'ranked',
					url: '/api/leaderboards?mode=ranked_1v1',
					title: 'Ranked 1v1 Elo Ladder',
					desc: 'Competitive duel matchmaking divisions & ELO rating. Win duel rounds to climb divisions.',
					icon: 'fa-solid fa-trophy',
					tags: ['Competitive', 'Season 0', '1v1 Matchmaking'],
					emptyHint: 'No ranked players calibrated yet. Play 10 placement matches in TeBlocks to claim rank #1!',
				},
				daily: {
					kind: 'daily',
					url: '/api/daily/leaderboard',
					title: 'Daily 40L Challenge',
					desc: 'Server-seeded daily 40L sprint speedrun with daily twists and global rankings.',
					icon: 'fa-solid fa-calendar-day',
					tags: ['Daily Seed', 'Server Twist', '40 Lines'],
					emptyHint: 'No challenge runs submitted yet for today. Be the first to set today’s speedrun benchmark!',
				},
				lines40: {
					kind: 'sprint',
					url: '/api/score/sprint_40l',
					title: '40 Lines Sprint',
					desc: 'The gold-standard block stacking speedrun. Clear 40 lines in the fastest possible time.',
					icon: 'fa-solid fa-stopwatch',
					tags: ['40 Lines', 'Speedrun', 'Singleplayer', 'SRS Rotation'],
					emptyHint: 'No 40L sprint runs recorded yet. Jump into Singleplayer > 40L Sprint in TeBlocks to set a record!',
				},
				sprint: {
					kind: 'sprint',
					url: '/api/score/sprint_100l',
					title: 'Sprint 100L Marathon',
					desc: '100 Lines endurance speedrun testing sustained APM/PPS, stacking precision, and zero error tolerance.',
					icon: 'fa-solid fa-gauge-high',
					tags: ['100 Lines', 'Marathon Sprint', 'Singleplayer', 'Endurance'],
					emptyHint: 'No 100L sprint runs recorded yet. Complete a 100 Lines run in TeBlocks to claim the #1 spot!',
				},
			};

			function escapeHtml(str: string) {
				return String(str || '').replace(/[&<>"']/g, (c) => ({
					'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
				}[c as keyof { '&': string; '<': string; '>': string; '"': string; "'": string }]));
			}

			function updateBanner(cfg: CategoryConfig) {
				if (!banner) return;
				banner.innerHTML = `
					<div class="mode-info-icon"><i class="${cfg.icon}"></i></div>
					<div class="mode-info-text">
						<h2 class="mode-info-title">${escapeHtml(cfg.title)}</h2>
						<p class="mode-info-desc">${escapeHtml(cfg.desc)}</p>
						<div class="mode-tags">
							${cfg.tags.map((t) => `<span class="mode-tag">${escapeHtml(t)}</span>`).join('')}
						</div>
					</div>
				`;
			}

			function avatarMarkup(entry: any) {
				const letter = escapeHtml((entry.username || '?').slice(0, 1).toUpperCase());
				const img = entry.avatar_url
					? `<img src="${encodeURI(entry.avatar_url)}" alt="">`
					: letter;
				return `<div class="player-avatar">${img}</div>`;
			}

			function playerName(entry: any) {
				const id = entry.id || entry.user_id;
				const name = escapeHtml(entry.username || 'Unknown');
				return id
					? `<a class="player-name" href="/profile/${encodeURIComponent(id)}">${name}</a>`
					: `<span class="player-name">${name}</span>`;
			}

			function renderRankedRow(entry: any, index: number) {
				const rank = index + 1;
				const rankClass = rank <= 3 ? `rank-${rank}` : '';
				const rankDisplay = entry.rank || entry.rank_name;
				const rankName = escapeHtml([rankDisplay, entry.rank_division].filter(Boolean).join(' ') || 'Unranked');
				const winRate = entry.win_rate != null ? `${Number(entry.win_rate).toFixed(1)}%` : '--';
				return `
					<tr>
						<td class="rank-cell ${rankClass}">#${rank}</td>
						<td><div class="player-cell">${avatarMarkup(entry)}${playerName(entry)}</div></td>
						<td><span class="rank-badge">${rankName}</span></td>
						<td class="stat-cell">${entry.rating ?? '--'}</td>
						<td class="stat-cell dim">${entry.matches_played ?? 0}</td>
						<td class="win-rate">${winRate}</td>
					</tr>`;
			}

			function formatTimeMs(ms: number) {
				if (!ms || ms <= 0) return '--';
				const totalSec = ms / 1000;
				const m = Math.floor(totalSec / 60);
				const s = (totalSec % 60).toFixed(2).padStart(5, '0');
				return `${m}:${s}`;
			}

			function renderDailyRow(entry: any, index: number) {
				const rank = entry.rank || index + 1;
				const rankClass = rank <= 3 ? `rank-${rank}` : '';
				const timeStr = formatTimeMs(entry.timeMs);
				const piecesStr = entry.pieceCount ? `${entry.pieceCount} pcs` : '--';
				return `
					<tr>
						<td class="rank-cell ${rankClass}">#${rank}</td>
						<td><div class="player-cell">${avatarMarkup(entry)}${playerName(entry)}</div></td>
						<td class="stat-cell">${timeStr}</td>
						<td class="stat-cell dim">${piecesStr}</td>
					</tr>`;
			}

			function renderSprintRow(entry: any, index: number) {
				const rank = index + 1;
				const rankClass = rank <= 3 ? `rank-${rank}` : '';
				let timeDisplay = '--';
				let paceDisplay = 'Singleplayer';
				if (entry.time != null || entry.timeMs != null || entry.time_ms != null) {
					timeDisplay = formatTimeMs(entry.time ?? entry.timeMs ?? entry.time_ms);
				} else if (entry.score != null) {
					const num = Number(entry.score);
					if (num > 500 && num < 3600000) {
						timeDisplay = formatTimeMs(num);
						paceDisplay = `${(num / 1000).toFixed(2)}s clear`;
					} else {
						timeDisplay = `${num.toLocaleString()} pts`;
					}
				}
				if (entry.pieceCount || entry.pieces) {
					paceDisplay = `${entry.pieceCount || entry.pieces} pcs`;
				}
				return `
					<tr>
						<td class="rank-cell ${rankClass}">#${rank}</td>
						<td><div class="player-cell">${avatarMarkup(entry)}${playerName(entry)}</div></td>
						<td class="stat-cell">${timeDisplay}</td>
						<td class="stat-cell dim">${paceDisplay}</td>
						<td><span class="rank-badge"><i class="fa-solid fa-circle-check"></i> Recorded</span></td>
					</tr>`;
			}

			function renderEmptyTable(cfg: CategoryConfig) {
				const colCount = cfg.kind === 'ranked' ? 6 : cfg.kind === 'daily' ? 4 : 5;
				const head =
					cfg.kind === 'ranked'
						? `<th>Rank</th><th>Player</th><th>Tier</th><th>Rating</th><th>Matches</th><th>Win rate</th>`
						: cfg.kind === 'daily'
						? `<th>Rank</th><th>Player</th><th>Clear Time</th><th>Pieces</th>`
						: `<th>Rank</th><th>Player</th><th>Clear Time</th><th>Speed / Details</th><th>Status</th>`;
				return `
					<table class="leaderboard-table">
						<thead><tr>${head}</tr></thead>
						<tbody>
							<tr>
								<td colspan="${colCount}" class="empty-state-cell">
									<div class="empty-state-card">
										<div class="empty-icon"><i class="${cfg.icon}"></i></div>
										<div class="empty-title">No ${escapeHtml(cfg.title)} records yet</div>
										<p class="empty-desc">${escapeHtml(cfg.emptyHint)}</p>
										<div class="empty-actions">
											<a href="/#download" class="btn btn-primary btn-sm"><i class="fa-solid fa-play"></i> Get TeBlocks Client</a>
											<a href="/wiki/" class="btn btn-secondary btn-sm"><i class="fa-solid fa-book"></i> Read Sprint Guide</a>
										</div>
									</div>
								</td>
							</tr>
						</tbody>
					</table>`;
			}

			function renderTable(kind: string, rows: any[]) {
				const head =
					kind === 'ranked'
						? `<th>Rank</th><th>Player</th><th>Tier</th><th>Rating</th><th>Matches</th><th>Win rate</th>`
						: kind === 'daily'
						? `<th>Rank</th><th>Player</th><th>Clear Time</th><th>Pieces</th>`
						: `<th>Rank</th><th>Player</th><th>Clear Time</th><th>Speed / Details</th><th>Status</th>`;
				const body = rows
					.map((entry, i) => (
						kind === 'ranked' ? renderRankedRow(entry, i) :
						kind === 'daily' ? renderDailyRow(entry, i) :
						renderSprintRow(entry, i)
					))
					.join('');
				return `
					<table class="leaderboard-table">
						<thead><tr>${head}</tr></thead>
						<tbody>${body}</tbody>
					</table>`;
			}

			async function loadLeaderboard(category: string, attempts = 2) {
				const cfg = categories[category];
				if (!cfg || !content) return;
				updateBanner(cfg);
				content.innerHTML = '<div class="state" role="status">Loading leaderboard...</div>';
				for (let attempt = 0; attempt < attempts; attempt += 1) {
					try {
						const controller = new AbortController();
						const timeout = window.setTimeout(() => controller.abort(), 8000);
						const response = await fetch(cfg.url, { signal: controller.signal });
						window.clearTimeout(timeout);
						if (!response.ok && response.status !== 404 && response.status !== 405) {
							const body = await response.json().catch(() => ({}));
							content.innerHTML = `<div class="state error">${body.error || body.message || 'Failed to load leaderboard.'}</div>`;
							return;
						}
						const data = response.ok ? await response.json().catch(() => ({})) : {};
						const rows = cfg.kind === 'ranked'
							? (Array.isArray(data.entries) ? data.entries : (Array.isArray(data) ? data : []))
							: (Array.isArray(data.data?.leaderboard)
								? data.data.leaderboard
								: (Array.isArray(data.data)
									? data.data
									: (Array.isArray(data.entries) ? data.entries : (Array.isArray(data) ? data : []))));
						if (!rows || !rows.length) {
							content.innerHTML = renderEmptyTable(cfg);
							return;
						}
						content.innerHTML = renderTable(cfg.kind, rows);
						return;
					} catch {
						if (attempt === attempts - 1) {
							content.innerHTML = `
								<div class="state error">
									<p>Leaderboard is temporarily unavailable.</p>
									<button class="retry-btn" type="button">Retry</button>
								</div>`;
							content.querySelector('.retry-btn')?.addEventListener('click', () => loadLeaderboard(category));
						} else {
							await new Promise((resolve) => window.setTimeout(resolve, 400 * (attempt + 1)));
						}
					}
				}
			}

			let current = 'ranked';
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const category = (tab as HTMLElement).dataset.category;
					if (!category || category === current) return;
					current = category;
					tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
					loadLeaderboard(category);
				});
			});

			loadLeaderboard(current);
		</script>
	</body>
</html>
