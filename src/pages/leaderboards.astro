---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Leaderboards | ${SITE_TITLE}`} description="Top players and rankings across all game modes." />
		<style>
			.leaderboard-panel {
				max-width: 960px;
				margin: 3em auto 0;
			}
			.leaderboard-header {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 1.5em;
				flex-wrap: wrap;
			}
			.leaderboard-header h1 {
				margin: 0;
				font-size: clamp(1.8rem, 4vw, 2.6rem);
			}
			.leaderboard-header p {
				margin: 0.4rem 0 0;
				color: var(--text-muted);
			}
			.mode-tabs {
				display: flex;
				gap: 0.35rem;
				padding: 0.3rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid var(--border);
				flex-wrap: wrap;
			}
			.mode-tab {
				padding: 0.5em 1em;
				border-radius: 999px;
				border: 0;
				background: transparent;
				color: var(--text-dim);
				font: 700 0.82rem var(--font-ui);
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.mode-tab:hover {
				color: var(--text);
			}
			.mode-tab[aria-selected="true"] {
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				color: #03121a;
				box-shadow: 0 6px 18px var(--accent-glow);
			}
			.table-card {
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--panel);
				backdrop-filter: blur(8px);
				overflow: hidden;
			}
			.leaderboard-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.92rem;
			}
			.leaderboard-table thead th {
				text-align: left;
				padding: 0.85em 1.1em;
				border-bottom: 1px solid var(--border);
				color: var(--text-muted);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: rgba(255, 255, 255, 0.02);
			}
			.leaderboard-table tbody tr {
				border-bottom: 1px solid var(--border);
				transition: background 0.15s ease;
			}
			.leaderboard-table tbody tr:hover {
				background: var(--panel-hover);
			}
			.leaderboard-table tbody tr:last-child {
				border-bottom: 0;
			}
			.leaderboard-table td {
				padding: 0.8em 1.1em;
				vertical-align: middle;
			}
			.rank-cell {
				font-family: var(--font-mono);
				font-weight: 800;
				font-size: 0.95rem;
				color: var(--text-muted);
				width: 3.5rem;
			}
			.rank-cell.rank-1 { color: #ffd166; }
			.rank-cell.rank-2 { color: #d6e2ff; }
			.rank-cell.rank-3 { color: #ff9d6e; }
			.player-cell {
				display: flex;
				align-items: center;
				gap: 0.8em;
			}
			.player-avatar {
				width: 38px;
				height: 38px;
				border-radius: 11px;
				background: linear-gradient(135deg, var(--i), var(--j));
				display: grid;
				place-items: center;
				color: #04121a;
				font: 800 0.85rem var(--font-ui);
				flex-shrink: 0;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}
			.player-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.player-name {
				font-weight: 700;
				color: var(--text);
			}
			.player-name:hover { color: var(--accent); }
			.rank-badge {
				display: inline-block;
				padding: 0.25em 0.6em;
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid var(--border);
				font-size: 0.74rem;
				font-weight: 700;
				color: var(--text-dim);
			}
			.stat-cell {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: var(--text);
				font-weight: 700;
			}
			.stat-cell.dim { color: var(--text-dim); font-weight: 500; }
			.win-rate { font-size: 0.82rem; color: var(--text-muted); }
			.state {
				text-align: center;
				padding: 3em 1em;
				color: var(--text-muted);
			}
			.state.error { color: var(--danger); }
			.retry-btn {
				margin-top: 1em;
				padding: 0.6em 1.2em;
				border: 1px solid var(--border);
				border-radius: 8px;
				background: transparent;
				color: var(--text);
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}
			.retry-btn:hover { background: var(--panel-hover); border-color: var(--border-bright); }
			@media (max-width: 640px) {
				.leaderboard-panel { margin-top: 2em; }
				.leaderboard-table thead th,
				.leaderboard-table td { padding: 0.7em 0.7em; }
				.leaderboard-header { flex-direction: column; align-items: flex-start; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="leaderboard-panel" aria-labelledby="leaderboard-title">
				<div class="leaderboard-header">
					<div>
						<h1 id="leaderboard-title">Leaderboards</h1>
						<p>Top players across every mode.</p>
					</div>
					<div class="mode-tabs" role="tablist" aria-label="Leaderboard category">
						<button class="mode-tab" role="tab" aria-selected="true" data-category="ranked">Ranked Elo</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="lines40">40 Lines</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="sprint">Sprint</button>
						<button class="mode-tab" role="tab" aria-selected="false" data-category="lonely">L Only</button>
					</div>
				</div>
				<div class="table-card">
					<div id="leaderboard-content">
						<div class="state" role="status">Loading leaderboard...</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const content = document.getElementById('leaderboard-content');
			const tabs = document.querySelectorAll('.mode-tab');

			const categories = {
				ranked: { kind: 'ranked', url: '/api/leaderboards?mode=ranked_1v1' },
				lines40: { kind: 'score', url: '/api/score/sprint_40l' },
				sprint: { kind: 'score', url: '/api/score/sprint_100l' },
				lonely: { kind: 'score', url: '/api/score/sprintLock' },
			};

			function avatarMarkup(entry) {
				const letter = (entry.username || '?').slice(0, 1).toUpperCase();
				const img = entry.avatar_url
					? `<img src="${entry.avatar_url}" alt="">`
					: letter;
				return `<div class="player-avatar">${img}</div>`;
			}

			function playerName(entry) {
				const id = entry.id || entry.user_id;
				const name = entry.username || 'Unknown';
				return id
					? `<a class="player-name" href="/profile/${encodeURIComponent(id)}">${name}</a>`
					: `<span class="player-name">${name}</span>`;
			}

			function renderRankedRow(entry, index) {
				const rank = index + 1;
				const rankClass = rank <= 3 ? `rank-${rank}` : '';
				const rankName = [entry.rank_name, entry.rank_division].filter(Boolean).join(' ') || 'Unranked';
				const winRate = entry.win_rate != null ? `${Number(entry.win_rate).toFixed(1)}%` : '--';
				return `
					<tr>
						<td class="rank-cell ${rankClass}">#${rank}</td>
						<td><div class="player-cell">${avatarMarkup(entry)}${playerName(entry)}</div></td>
						<td><span class="rank-badge">${rankName}</span></td>
						<td class="stat-cell">${entry.rating ?? '--'}</td>
						<td class="stat-cell dim">${entry.matches_played ?? 0}</td>
						<td class="win-rate">${winRate}</td>
					</tr>`;
			}

			function renderScoreRow(entry, index) {
				const rank = index + 1;
				const rankClass = rank <= 3 ? `rank-${rank}` : '';
				const score = entry.score != null ? Number(entry.score).toLocaleString() : '--';
				return `
					<tr>
						<td class="rank-cell ${rankClass}">#${rank}</td>
						<td><div class="player-cell">${avatarMarkup(entry)}${playerName(entry)}</div></td>
						<td class="stat-cell">${score}</td>
					</tr>`;
			}

			function renderTable(kind, rows) {
				const head =
					kind === 'ranked'
						? `<th>Rank</th><th>Player</th><th>Rank</th><th>Rating</th><th>Matches</th><th>Win rate</th>`
						: `<th>Rank</th><th>Player</th><th>Score</th>`;
				const body = rows
					.map((entry, i) => (kind === 'ranked' ? renderRankedRow(entry, i) : renderScoreRow(entry, i)))
					.join('');
				return `
					<table class="leaderboard-table">
						<thead><tr>${head}</tr></thead>
						<tbody>${body}</tbody>
					</table>`;
			}

			async function loadLeaderboard(category, attempts = 2) {
				const cfg = categories[category];
				if (!cfg) return;
				content.innerHTML = '<div class="state" role="status">Loading leaderboard...</div>';
				for (let attempt = 0; attempt < attempts; attempt += 1) {
					try {
						const controller = new AbortController();
						const timeout = window.setTimeout(() => controller.abort(), 8000);
						const response = await fetch(cfg.url, { signal: controller.signal, credentials: 'include' });
						window.clearTimeout(timeout);
						if (response.status === 404 || response.status === 405) {
							content.innerHTML = '<div class="state">Leaderboards aren’t available for this mode yet.</div>';
							return;
						}
						if (!response.ok) {
							const body = await response.json().catch(() => ({}));
							content.innerHTML = `<div class="state error">${body.error || 'Failed to load leaderboard.'}</div>`;
							return;
						}
						const data = await response.json();
						const rows = cfg.kind === 'ranked' ? (data.entries || []) : (data.data || []);
						if (!rows.length) {
							content.innerHTML = '<div class="state">No rankings yet — be the first to compete.</div>';
							return;
						}
						content.innerHTML = renderTable(cfg.kind, rows);
						return;
					} catch {
						if (attempt === attempts - 1) {
							content.innerHTML = `
								<div class="state error">
									<p>Leaderboard is temporarily unavailable.</p>
									<button class="retry-btn" type="button">Retry</button>
								</div>`;
							content.querySelector('.retry-btn')?.addEventListener('click', () => loadLeaderboard(category));
						} else {
							await new Promise((resolve) => window.setTimeout(resolve, 400 * (attempt + 1)));
						}
					}
				}
			}

			let current = 'ranked';
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const category = tab.dataset.category;
					if (!category || category === current) return;
					current = category;
					tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
					loadLeaderboard(category);
				});
			});

			loadLeaderboard(current);
		</script>
	</body>
</html>
