	.stat:last-child { border-right: 0; }
	.stat span, .stat small { display: block; }
	.stat span { color: var(--text-dim); font: 700 .72rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
	.stat strong { display: block; margin: .2em 0; font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; color: var(--text); }
	.stat small { color: var(--text-muted); font-size: .78rem; }

	/* ---------- TAB 3: RATING CHART ---------- */
	.rank-graph-card { position: relative; padding: 1.4em; margin-top: 1.2em; border-radius: var(--radius-sm); }
	.graph-tooltip {
		position: absolute;
		transform: translate(-50%, -125%);
		pointer-events: none;
		background: rgba(10,12,16,.94);
