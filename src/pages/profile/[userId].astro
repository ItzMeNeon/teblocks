---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Profile | ${SITE_TITLE}`} description="TeBlocks player profile." />
		<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
		<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
	</head>
	<body>
		<Header />
		<main>
			<div id="profile-status" class="loading" role="status" aria-live="polite">Loading player profile...</div>
			<section id="profile" class="profile" hidden aria-labelledby="profile-name">
				<div id="profile-banner" class="profile-banner">
					<img id="banner-image" alt="" hidden />
					<div class="banner-blocks" aria-hidden="true">
						<i></i><i></i><i></i><i></i>
					</div>
					<label id="banner-control" class="media-control banner-control" hidden>
						<span>Change banner</span>
						<input id="banner-upload" type="file" accept="image/png,image/jpeg,image/webp" />
					</label>
				</div>
			<div class="profile-card">
				<div class="identity-row">
					<div class="avatar-wrap">
						<div id="avatar" class="avatar">
							<img id="avatar-image" alt="" hidden />
							<span id="avatar-initial">?</span>
						</div>
						<label id="avatar-control" class="media-control avatar-control" hidden>
							<span>Change</span>
							<input id="avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" />
						</label>
					</div>
					<div class="identity">
						<p class="eyebrow" style="--accent-color: var(--i)">
							<span class="presence"></span> Player profile
						</p>
						<h1 id="profile-name">Player</h1>
						<p class="player-meta">
							<span id="verification-badge" class="verification-badge">Unverified</span>
							<span id="member-since"></span>
						</p>
					</div>
					<div class="profile-actions" id="profile-actions"></div>
				</div>
					<div class="profile-grid">
						<section class="about-card" aria-labelledby="about-title">
							<div class="section-heading">
								<p class="eyebrow" style="--accent-color: var(--t)">Player card</p>
								<h2 id="about-title">About</h2>
							</div>
							<p id="player-bio" class="player-bio">No profile note yet.</p>
							<form id="bio-form" class="bio-form" hidden>
							<label class="sr-only" for="profile-bio-input">Profile note</label>
							<input id="profile-bio-input" maxlength="120" placeholder="Add a short profile note" />
								<button class="button compact" type="submit">Save</button>
							</form>
							<p id="bio-status" class="form-status" role="status"></p>
						</section>
						<section class="rank-card" aria-labelledby="rank-title">
							<div class="section-heading">
								<p class="eyebrow" style="--accent-color: var(--o)">Competitive</p>
								<h2 id="rank-title">Rank</h2>
							</div>
							<div class="rank-display">
								<span id="rank-glyph" class="rank-glyph">?</span>
								<div>
									<strong id="rank-name">Unranked</strong>
									<p id="rank-copy">Play your first ranked match to place.</p>
								</div>
							</div>
						</section>
					</div>
					<section class="stats-section" aria-labelledby="stats-title">
						<div class="section-heading">
							<p class="eyebrow" style="--accent-color: var(--s)">Performance</p>
							<h2 id="stats-title">Player statistics</h2>
						</div>
						<div class="stats-grid">
							<div class="stat">
								<span>Rating</span>
								<strong id="stat-rating">--</strong>
								<small id="rating-detail">No rating yet</small>
							</div>
							<div class="stat">
								<span>Matches</span>
								<strong id="stat-matches">0</strong>
								<small id="matches-detail">Start your first game</small>
							</div>
							<div class="stat">
								<span>Win rate</span>
								<strong id="stat-win-rate">--</strong>
								<small id="win-detail">Pending matches</small>
							</div>
							<div class="stat">
								<span>Best streak</span>
								<strong id="stat-streak">0</strong>
								<small id="streak-detail">Build a run</small>
							</div>
						</div>
					</section>

					<section class="stats-section" aria-labelledby="casual-title">
						<div class="section-heading">
							<p class="eyebrow" style="--accent-color: var(--z)">Casual</p>
							<h2 id="casual-title">Casual play</h2>
						</div>
						<div class="stats-grid">
							<div class="stat">
								<span>Total plays</span>
								<strong id="casual-total">0</strong>
								<small id="casual-total-detail">Casual games</small>
							</div>
							<div class="stat">
								<span>Best 40L</span>
								<strong id="casual-40l">--</strong>
								<small>Fastest clear</small>
							</div>
							<div class="stat">
								<span>Best L survival</span>
								<strong id="casual-l">--</strong>
								<small>Longest run</small>
							</div>
							<div class="stat">
								<span>Best sprint</span>
								<strong id="casual-sprint">--</strong>
								<small>Top ultra score</small>
							</div>
						</div>
					</section>

					<section class="stats-section" aria-labelledby="rank-graph-title">
						<div class="section-heading">
							<p class="eyebrow" style="--accent-color: var(--j)">Rating</p>
							<h2 id="rank-graph-title">Rank history · 30 days</h2>
						</div>
						<div class="rank-graph-card panel">
							<svg id="rank-graph" viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label="Rating over the last 30 days"></svg>
							<div id="rank-graph-tooltip" class="graph-tooltip" hidden></div>
							<p id="rank-graph-empty" class="activity-empty">Play ranked matches to build your rating history.</p>
						</div>
					</section>

					<div class="lower-grid">
						<section class="activity-card" aria-labelledby="activity-title">
							<div class="section-heading">
								<p class="eyebrow" style="--accent-color: var(--z)">Timeline</p>
								<h2 id="activity-title">Recent activity</h2>
							</div>
							<div id="match-list" class="match-list">
								<p class="activity-empty">Loading recent matches...</p>
							</div>
						</section>
						<div class="account-card" id="account-card">
							<div class="account-card-header">
								<span class="eyebrow" style="--accent-color: var(--j)">Player</span>
								<strong id="account-card-title">Account details</strong>
							</div>
							<dl>
								<div>
									<dt>Player ID</dt>
									<dd>
										<button id="copy-id" class="copy-id" type="button">
											<span id="profile-id"></span> <b>Copy</b>
										</button>
									</dd>
								</div>
							</dl>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.loading { max-width: 920px; margin: 5em auto; padding: 0 1.25em; color: var(--dim); }
	.profile { max-width: 920px; margin: 3.5em auto 0; padding: 0 1.25em; }
	.profile-card, .stats-section, .activity-card, .account-card {
		border: 1px solid var(--line);
		background: linear-gradient(145deg, rgba(22,26,33,.98), rgba(14,17,23,.98));
		box-shadow: var(--shadow);
	}
	.profile-card { border-radius: 0 0 var(--radius) var(--radius); }
	.profile-banner {
		position: relative;
		height: 174px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-bottom: 0;
		border-radius: var(--radius) var(--radius) 0 0;
		background: radial-gradient(circle at 75% 20%, rgba(61,219,217,.27), transparent 30%), linear-gradient(112deg, #101925, #251a37 56%, #30200d);
	}
	.profile-banner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.banner-blocks {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: end;
		gap: 13px;
		padding-left: 10%;
		pointer-events: none;
	}
	.banner-blocks[hidden] { display: none; }
	.banner-blocks i {
		width: 64px;
		height: 64px;
		margin-bottom: -24px;
		transform: rotate(45deg);
		border: 1px solid rgba(236,239,243,.17);
		background: rgba(236,239,243,.08);
	}
	.banner-blocks i:nth-child(2) { height: 112px; background: rgba(176,132,245,.22); }
	.banner-blocks i:nth-child(3) { height: 50px; background: rgba(245,213,71,.18); }
	.banner-blocks i:nth-child(4) { height: 86px; background: rgba(111,224,122,.16); }
	.media-control {
		position: absolute;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		cursor: pointer;
		border: 1px solid rgba(236,239,243,.28);
		border-radius: 7px;
		background: rgba(10,12,16,.78);
		color: var(--text);
		font-size: .76rem;
		font-weight: 700;
		backdrop-filter: blur(6px);
	}
	.media-control input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.media-control[hidden] { display: none; }
	.media-control span { padding: .55em .75em; }
	.banner-control { right: 1em; top: 1em; }
	.avatar-wrap { position: relative; flex: 0 0 auto; margin-top: -64px; }
	.avatar {
		width: 112px;
		height: 112px;
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 5px solid var(--panel);
		border-radius: 22px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #000000;
		box-shadow: 0 10px 26px rgba(0,0,0,.4);
		font: 800 3.3rem "Atkinson", sans-serif;
	}
	.avatar img { width: 100%; height: 100%; object-fit: cover; }
	.avatar-control { right: -8px; bottom: -6px; }
	.identity-row { display: flex; align-items: flex-end; gap: 1.25em; padding: 0 1.6em 1.6em; }
	.identity { flex: 1; min-width: 0; }
	.identity .eyebrow { margin: 0 0 .25em; }
	.presence {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--s);
		box-shadow: 0 0 0 3px rgba(111,224,122,.14);
	}
	.identity h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.4rem); overflow-wrap: anywhere; }
	.player-meta { display: flex; gap: .7em; align-items: center; margin: .25em 0 0; font-size: .85rem; }
	.verification-badge {
		padding: .15em .55em;
		border-radius: 20px;
		background: rgba(245,99,122,.13);
		color: var(--z);
		font-weight: 700;
	}
	.verification-badge.verified { background: rgba(111,224,122,.13); color: var(--s); }
	.profile-grid, .lower-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1em; margin-top: 1em; }
	.about-card, .rank-card { min-height: 185px; padding: 1.6em; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
	.section-heading .eyebrow { margin-bottom: .35em; }
	.section-heading h2 { font-size: 1.35rem; }
	.player-bio { min-height: 2.3em; margin: 1.1em 0 .8em; color: var(--text); }
	.bio-form { display: flex; gap: .55em; }
	.bio-form[hidden] { display: none; }
	.bio-form input {
		min-width: 0;
		flex: 1;
		padding: .56em .7em;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--board);
		color: var(--text);
		font: inherit;
	}
	.form-status { min-height: 1.1em; margin: .45em 0 0; color: var(--dim); font-size: .74rem; }
	.rank-display { display: flex; gap: 1em; align-items: center; margin: 1.2em 0; }
	.rank-glyph {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		font: 800 1.6rem "Atkinson", sans-serif;
		transition: color .2s ease, border-color .2s ease, background .2s ease;
	}
	.rank-glyph.tier-bronze     { color: #ff9f73; border-color: rgba(205,127,50,.35);  background: rgba(205,127,50,.10); }
	.rank-glyph.tier-silver     { color: #e0e0e0; border-color: rgba(192,192,192,.35); background: rgba(192,192,192,.10); }
	.rank-glyph.tier-gold       { color: #ffd700; border-color: rgba(255,215,0,.35);   background: rgba(255,215,0,.10); }
	.rank-glyph.tier-platinum   { color: #4ec9b0; border-color: rgba(78,201,176,.35);  background: rgba(78,201,176,.10); }
	.rank-glyph.tier-diamond    { color: #b388ff; border-color: rgba(179,136,255,.35); background: rgba(179,136,255,.10); }
	.rank-glyph.tier-master     { color: #ff6b8b; border-color: rgba(255,107,139,.35); background: rgba(255,107,139,.10); }
	.rank-glyph.tier-grandmaster{ color: #ff9d6e; border-color: rgba(255,157,110,.35); background: rgba(255,157,110,.10); }
	.rank-name {
		font-size: 1.15rem;
		transition: color .2s ease;
	}
	.rank-name.tier-bronze     { color: #ff9f73; }
	.rank-name.tier-silver     { color: #e0e0e0; }
	.rank-name.tier-gold       { color: #ffd700; }
	.rank-name.tier-platinum   { color: #4ec9b0; }
	.rank-name.tier-diamond    { color: #b388ff; }
	.rank-name.tier-master     { color: #ff6b8b; }
	.rank-name.tier-grandmaster{ color: #ff9d6e; }
	.rank-display p { margin: 0; font-size: .8rem; }
	.stats-section, .activity-card, .account-card { padding: 1.6em; border-radius: var(--radius); }
	.stats-section { margin-top: 1em; }
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-top: 1.2em;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.stat {
		padding: 1em;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.stat span, .stat small { display: block; }
	.stat span { color: var(--dim); font: .72rem ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
	.stat strong { display: block; margin: .18em 0; font: 700 1.8rem "Atkinson", sans-serif; }
	.stat small { color: var(--dim-2); font-size: .75rem; }
	.rank-graph-card { position: relative; padding: 1.2em; }
	.graph-tooltip {
		position: absolute;
		transform: translate(-50%, -125%);
		pointer-events: none;
		background: rgba(10,12,16,.92);
		border: 1px solid var(--border-bright);
		border-radius: 6px;
		padding: .45em .65em;
		font-size: .72rem;
		white-space: nowrap;
		z-index: 3;
	}
	.graph-tooltip strong { display: block; color: var(--text); font-size: .82rem; }
	.graph-tooltip span { color: var(--dim); }
	.graph-tooltip[hidden] { display: none; }
	#rank-graph { width: 100%; height: 200px; display: block; }
	.account-card { min-width: 0; }
	.account-card-header {
		display: flex;
		flex-direction: column;
		gap: .25em;
		margin-bottom: 1em;
	}
	.account-card-header .eyebrow { display: block; }
	.account-card-header strong { font: 600 1.15rem "Rubik", sans-serif; }
	.account-card dl { margin: 1em 0 0; }
	.account-card dl div { padding: .7em 0; border-top: 1px solid var(--line); }
	dt { color: var(--dim-2); font: .7rem "JetBrains Mono", monospace; text-transform: uppercase; }
	dd { margin: .15em 0 0; overflow-wrap: anywhere; color: var(--text); font-size: .85rem; }
	@media (max-width: 720px) {
		.profile { margin-top: 2em; padding: 0 0.9em; }
		.profile-banner { height: 135px; }
		.identity-row { flex-wrap: wrap; padding: 0 1.15em 1.2em; }
		.avatar { width: 88px; height: 88px; font-size: 2.5rem; }
		.profile-actions { width: 100%; }
		.profile-grid, .lower-grid { grid-template-columns: 1fr; }
		.stats-section, .activity-card, .account-card, .about-card, .rank-card { padding: 1.25em; }
		.stats-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>

<!--
	The rules below style markup created client-side (via innerHTML / createElement)
	in the <script> at the bottom of this file: profile-actions buttons, the retry
	button, match-list rows, and the copy-id button. Astro's scoped styles only
	attach their data-astro-cid attribute to markup present in this component's
	template at build time, so a normal scoped <style> block silently fails to match
	anything inserted later by JS (this was causing the profile action buttons to
	render as unstyled native buttons). is:global is required here.
-->
<style is:global>
	.profile-actions { display: flex; gap: .6em; flex-wrap: wrap; align-items: center; }
	.button {
		padding: .65em 1.1em;
		border-radius: 7px;
		font: 600 .86rem var(--font-ui);
		cursor: pointer;
		transition: filter var(--transition-fast), background var(--transition-fast);
	}
	.button-native {
		appearance: button;
		border: 1px solid var(--border-bright);
		background: var(--panel);
		color: var(--text);
	}
	.button-native:hover {
		background: var(--panel-hover);
		filter: brightness(1.05);
	}
	.button-native.danger {
		border-color: rgba(245, 99, 122, .35);
		color: var(--danger);
	}
	.button-native.danger:hover {
		background: rgba(245, 99, 122, .08);
	}
	.button.secondary { border-color: var(--line); background: transparent; color: var(--text); }
	.button.danger { border-color: rgba(245,99,122,.35); background: transparent; color: var(--z); }
	.button.compact { padding: .55em .8em; }
	.copy-id {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text);
		cursor: pointer;
		font: inherit;
		text-align: left;
	}
	.copy-id b { color: var(--i); font-size: .77rem; }
	.match-list { margin-top: 1em; }
	.match {
		display: flex;
		align-items: center;
		gap: .8em;
		padding: .75em 0;
		border-top: 1px solid var(--line);
	}
	.result {
		min-width: 42px;
		text-align: center;
		border-radius: 5px;
		padding: .25em;
		font: 700 .7rem "JetBrains Mono", monospace;
	}
	.result.win { background: rgba(111,224,122,.15); color: var(--s); }
	.result.loss, .result.abandoned { background: rgba(245,99,122,.14); color: var(--z); }
	.result.draw { background: rgba(245,213,71,.12); color: var(--o); }
	.match strong, .match small { display: block; }
	.match small { color: var(--dim); font-size: .75rem; }
	.rating-change { margin-left: auto; font: 700 .9rem "JetBrains Mono", monospace; }
	.rating-change.positive { color: var(--s); }
	.rating-change.negative { color: var(--z); }
	.activity-empty { margin: 1.3em 0 .2em; font-size: .86rem; }
	@media (max-width: 720px) {
		.profile-actions .button { flex: 1; }
	}
</style>

<script>
	const status = document.querySelector('#profile-status');
	const profileEl = document.querySelector('#profile');
	const bioForm = document.querySelector('#bio-form');
	const bioInput = document.querySelector('#profile-bio-input');
	const bioStatus = document.querySelector('#bio-status');
	const matchList = document.querySelector('#match-list');
	const profileActions = document.querySelector('#profile-actions');
	const accountCardTitle = document.querySelector('#account-card-title');
	const userId = window.location.pathname.replace('/profile/', '').replace('/', '') || '';

	let editMode = false;

	// Rank tiers: rating 100 is the first rank. Each division spans 100 rating
	// points, 3 divisions per tier, until Grandmaster (single open-ended tier).
	// Ratings below 100 are shown as Unranked regardless of placement status.
	const RANK_START = 100;
	const RANK_STEP = 100;
	const DIVISIONS_PER_TIER = 3;
	const RANK_TIERS = [
		{ name: 'Bronze',     glyph: 'B',  tier: 'bronze' },
		{ name: 'Silver',     glyph: 'S',  tier: 'silver' },
		{ name: 'Gold',       glyph: 'G',  tier: 'gold' },
		{ name: 'Platinum',   glyph: 'P',  tier: 'platinum' },
		{ name: 'Diamond',    glyph: 'D',  tier: 'diamond' },
		{ name: 'Master',     glyph: 'M',  tier: 'master' },
		{ name: 'Grandmaster',glyph: 'GM', tier: 'grandmaster' },
	];
	const RANK_COLORS = {
		bronze:     { border: 'rgba(205,127,50,.35)',  bg: 'rgba(205,127,50,.10)' },
		silver:     { border: 'rgba(192,192,192,.35)', bg: 'rgba(192,192,192,.10)' },
		gold:       { border: 'rgba(255,215,0,.35)',   bg: 'rgba(255,215,0,.10)' },
		platinum:   { border: 'rgba(78,201,176,.35)',  bg: 'rgba(78,201,176,.10)' },
		diamond:    { border: 'rgba(179,136,255,.35)', bg: 'rgba(179,136,255,.10)' },
		master:     { border: 'rgba(255,107,139,.35)', bg: 'rgba(255,107,139,.10)' },
		grandmaster:{ border: 'rgba(255,157,110,.35)', bg: 'rgba(255,157,110,.10)' },
	};
	function getRankForRating(rating) {
		if (rating == null || rating < RANK_START) return null;
		const stepsAboveStart = Math.floor((rating - RANK_START) / RANK_STEP);
		const tierIndex = Math.min(Math.floor(stepsAboveStart / DIVISIONS_PER_TIER), RANK_TIERS.length - 1);
		const tier = RANK_TIERS[tierIndex];
		const isTopTier = tierIndex === RANK_TIERS.length - 1;
		const division = isTopTier ? null : (stepsAboveStart % DIVISIONS_PER_TIER) + 1;
		return { name: tier.name, glyph: tier.glyph, tier: tier.tier, division };
	}
	function applyRankTier(tier) {
		const glyph = document.getElementById('rank-glyph');
		const name = document.getElementById('rank-name');
		[glyph, name].forEach((el) => {
			if (!el) return;
			el.classList.remove('tier-bronze','tier-silver','tier-gold','tier-platinum','tier-diamond','tier-master','tier-grandmaster');
			if (tier) el.classList.add('tier-' + tier);
		});
		if (tier && glyph && RANK_COLORS[tier]) {
			const c = RANK_COLORS[tier];
			glyph.style.borderColor = c.border;
			glyph.style.background = c.bg;
		} else if (glyph) {
			glyph.style.borderColor = '';
			glyph.style.background = '';
		}
	}

	function setEditMode(on) {
		editMode = on;
		bioForm.hidden = !on;
		const avatarControl = document.getElementById('avatar-control');
		const bannerControl = document.getElementById('banner-control');
		if (avatarControl) avatarControl.hidden = !on;
		if (bannerControl) bannerControl.hidden = !on;
		const editBtn = document.getElementById('edit-button');
		if (editBtn) editBtn.textContent = on ? 'Done' : 'Edit profile';
	}
	function hideEditableControls() {
		const avatarControl = document.getElementById('avatar-control');
		const bannerControl = document.getElementById('banner-control');
		if (avatarControl) avatarControl.hidden = true;
		if (bannerControl) bannerControl.hidden = true;
		if (bioForm) bioForm.hidden = true;
		if (profileActions) profileActions.innerHTML = '';
	}

	const text = (selector, value) => { document.querySelector(selector).textContent = value; };
	const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { month: 'short', year: 'numeric' }).format(new Date(value)) : '';
	const formatDuration = (value) => {
		if (value === null || value === undefined) return '--';
		const total = Math.floor(Number(value));
		const s = total % 60;
		const m = Math.floor(total / 60);
		return `${m}:${String(s).padStart(2, '0')}`;
	};
	const setImage = (image, fallback, url, alt) => {
		image.hidden = !url;
		if (fallback) fallback.hidden = Boolean(url);
		if (url) { image.src = url; image.alt = alt; }
	};
	async function copyText(value, button, label) {
		try {
			await navigator.clipboard.writeText(value);
			const original = button.textContent;
			button.textContent = label;
			window.setTimeout(() => { button.textContent = original; }, 1600);
		} catch {
			window.prompt('Copy this value:', value);
		}
	}
	function setAccountCardLabel(eyebrowText, titleText) {
		const eyebrow = document.querySelector('#account-card .account-card-header .eyebrow');
		if (eyebrow) eyebrow.textContent = eyebrowText;
		accountCardTitle.textContent = titleText;
	}
	function showRetry(message) {
		status.innerHTML = '';
		const copy = document.createElement('span');
		copy.textContent = message;
		const retry = document.createElement('button');
		retry.className = 'button compact';
		retry.type = 'button';
		retry.textContent = 'Try again';
		retry.addEventListener('click', loadProfile);
		status.append(copy, retry);
	}
	async function request(path, options = {}, attempts = 3) {
		const token = localStorage.getItem('teblocks_token');
		const headers = new Headers(options.headers);
		if (token && !headers.has('Authorization')) {
			headers.set('Authorization', `Bearer ${token}`);
		}
		for (let attempt = 0; attempt < attempts; attempt += 1) {
			const controller = new AbortController();
			const timeout = window.setTimeout(() => controller.abort(), 8000);
			try {
				const response = await fetch(path, { ...options, headers, signal: controller.signal, cache: 'no-store' });
				window.clearTimeout(timeout);
				if (response.status >= 500 && response.status !== 503 && attempt < attempts - 1) {
					await new Promise((resolve) => window.setTimeout(resolve, 300 * (attempt + 1)));
					continue;
				}
				return response;
			} catch (error) {
				window.clearTimeout(timeout);
				if (attempt === attempts - 1) throw error;
				await new Promise((resolve) => window.setTimeout(resolve, 300 * (attempt + 1)));
			}
		}
		throw new Error('Request failed');
	}
	function renderMatches(matches) {
		if (!matches?.length) {
			matchList.innerHTML = '<p class="activity-empty">No completed matches yet.</p>';
			return;
		}
		matchList.replaceChildren(...matches.map((match) => {
			const item = document.createElement('article');
			const change = Number(match.rating_change);
			const mode = String(match.mode || 'match').replaceAll('_', ' ');
			item.className = 'match';
			item.innerHTML = `<span class="result ${match.result}">${match.result}</span><div><strong>${match.opponent?.username || mode}</strong><small>${mode} · ${new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(new Date(match.completed_at))}</small></div>${Number.isFinite(change) ? `<span class="rating-change ${change >= 0 ? 'positive' : 'negative'}">${change >= 0 ? '+' : ''}${change}</span>` : ''}`;
			return item;
		}));
	}
	async function loadMatches(targetUserId) {
		try {
			const endpoint = targetUserId ? `https://backend.teblocks.my.id/api/profile/${encodeURIComponent(targetUserId)}/matches` : 'https://backend.teblocks.my.id/api/profile/matches?limit=8';
			const response = await request(endpoint);
			if (!response.ok) { renderMatches([]); return; }
			renderMatches((await response.json()).matches);
		} catch {
			renderMatches([]);
		}
	}
	// Chart geometry is fixed to the SVG viewBox (600x200); padding leaves room
	// for the y-axis rating labels on the left.
	const GRAPH_W = 600, GRAPH_H = 200;
	const GRAPH_PAD = { top: 16, right: 16, bottom: 16, left: 42 };
	let graphPoints = [];

	// Converts a series of [x, y] points into a smooth SVG path using
	// Catmull-Rom-to-Bezier interpolation, instead of straight polyline segments.
	function smoothPath(points) {
		if (points.length < 2) {
			const [p] = points;
			return p ? `M ${p[0].toFixed(2)},${p[1].toFixed(2)}` : '';
		}
		let d = `M ${points[0][0].toFixed(2)},${points[0][1].toFixed(2)} `;
		for (let i = 0; i < points.length - 1; i += 1) {
			const p0 = points[i === 0 ? 0 : i - 1];
			const p1 = points[i];
			const p2 = points[i + 1];
			const p3 = points[i + 2 < points.length ? i + 2 : i + 1];
			const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
			const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
			const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
			const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
			d += `C ${cp1x.toFixed(2)},${cp1y.toFixed(2)} ${cp2x.toFixed(2)},${cp2y.toFixed(2)} ${p2[0].toFixed(2)},${p2[1].toFixed(2)} `;
		}
		return d.trim();
	}

	function renderRankGraph(points) {
		const svg = document.getElementById('rank-graph');
		const empty = document.getElementById('rank-graph-empty');
		const tooltip = document.getElementById('rank-graph-tooltip');
		if (!svg || !empty) return;
		if (!points?.length) {
			svg.hidden = true;
			empty.hidden = false;
			if (tooltip) tooltip.hidden = true;
			graphPoints = [];
			return;
		}
		empty.hidden = true;
		svg.hidden = false;

		const sorted = [...points].sort((a, b) => new Date(a.recorded_at) - new Date(b.recorded_at));
		const ratings = sorted.map((p) => Number(p.rating));
		let min = Math.min(...ratings);
		let max = Math.max(...ratings);
		if (min === max) { min -= 50; max += 50; }
		const breathing = (max - min) * 0.1;
		min -= breathing;
		max += breathing;

		const times = sorted.map((p) => new Date(p.recorded_at).getTime());
		let tMin = Math.min(...times);
		let tMax = Math.max(...times);
		if (tMin === tMax) { tMin -= 1; tMax += 1; }

		const { top, right, bottom, left } = GRAPH_PAD;
		const innerW = GRAPH_W - left - right;
		const innerH = GRAPH_H - top - bottom;
		const x = (t) => left + ((t - tMin) / (tMax - tMin)) * innerW;
		const y = (r) => top + innerH - ((r - min) / (max - min)) * innerH;

		const coords = sorted.map((p) => [x(new Date(p.recorded_at).getTime()), y(Number(p.rating))]);
		graphPoints = sorted.map((p, i) => ({
			x: coords[i][0], y: coords[i][1], rating: Number(p.rating), date: new Date(p.recorded_at),
		}));

		const linePath = smoothPath(coords);
		const baseline = (top + innerH).toFixed(2);
		const areaPath = `${linePath} L ${coords[coords.length - 1][0].toFixed(2)},${baseline} L ${coords[0][0].toFixed(2)},${baseline} Z`;

		const gridRows = 4;
		let gridSvg = '';
		for (let i = 0; i <= gridRows; i += 1) {
			const gy = top + (innerH / gridRows) * i;
			const value = Math.round(max - ((max - min) / gridRows) * i);
			gridSvg += `<line x1="${left}" y1="${gy.toFixed(1)}" x2="${(left + innerW).toFixed(1)}" y2="${gy.toFixed(1)}" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 4" />`;
			gridSvg += `<text x="${(left - 8).toFixed(1)}" y="${(gy + 3.5).toFixed(1)}" text-anchor="end" font-size="9" fill="var(--dim-2)" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">${value}</text>`;
		}

		svg.innerHTML = `
			<defs>
				<linearGradient id="rank-graph-fill" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--i)" stop-opacity="0.35" />
					<stop offset="100%" stop-color="var(--i)" stop-opacity="0" />
				</linearGradient>
			</defs>
			${gridSvg}
			<path d="${areaPath}" fill="url(#rank-graph-fill)" stroke="none" />
			<path d="${linePath}" fill="none" stroke="var(--i)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			<line id="rank-graph-hover-line" x1="0" y1="${top}" x2="0" y2="${top + innerH}" stroke="var(--line)" stroke-width="1" opacity="0" />
			<circle id="rank-graph-dot" cx="0" cy="0" r="4" fill="var(--i)" stroke="var(--board)" stroke-width="2" opacity="0" />
		`;
	}

	function setupRankGraphHover() {
		const svg = document.getElementById('rank-graph');
		const tooltip = document.getElementById('rank-graph-tooltip');
		if (!svg || !tooltip) return;
		const dateFmt = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' });

		function handleMove(event) {
			if (!graphPoints.length) return;
			const rect = svg.getBoundingClientRect();
			const scaleX = GRAPH_W / rect.width;
			const scaleY = GRAPH_H / rect.height;
			const localX = (event.clientX - rect.left) * scaleX;
			let nearest = graphPoints[0];
			let nearestDist = Infinity;
			for (const point of graphPoints) {
				const dist = Math.abs(point.x - localX);
				if (dist < nearestDist) { nearestDist = dist; nearest = point; }
			}
			const dot = svg.querySelector('#rank-graph-dot');
			const hoverLine = svg.querySelector('#rank-graph-hover-line');
			if (dot) {
				dot.setAttribute('cx', nearest.x.toFixed(2));
				dot.setAttribute('cy', nearest.y.toFixed(2));
				dot.setAttribute('opacity', '1');
			}
			if (hoverLine) {
				hoverLine.setAttribute('x1', nearest.x.toFixed(2));
				hoverLine.setAttribute('x2', nearest.x.toFixed(2));
				hoverLine.setAttribute('opacity', '1');
			}
			tooltip.style.left = `${nearest.x / scaleX}px`;
			tooltip.style.top = `${nearest.y / scaleY}px`;
			tooltip.innerHTML = `<strong>${nearest.rating} rating</strong><span>${dateFmt.format(nearest.date)}</span>`;
			tooltip.hidden = false;
		}
		function handleLeave() {
			tooltip.hidden = true;
			const dot = svg.querySelector('#rank-graph-dot');
			const hoverLine = svg.querySelector('#rank-graph-hover-line');
			if (dot) dot.setAttribute('opacity', '0');
			if (hoverLine) hoverLine.setAttribute('opacity', '0');
		}
		svg.addEventListener('pointermove', handleMove);
		svg.addEventListener('pointerleave', handleLeave);
	}
	async function loadRatingHistory(targetUserId) {
		try {
			const endpoint = targetUserId ? `https://backend.teblocks.my.id/api/profile/${encodeURIComponent(targetUserId)}/rating-history?days=30` : 'https://backend.teblocks.my.id/api/profile/rating-history?days=30';
			const response = await request(endpoint);
			if (!response.ok) { renderRankGraph([]); return; }
			renderRankGraph((await response.json()).points);
		} catch {
			renderRankGraph([]);
		}
	}
	async function uploadMedia(kind, input) {
		const file = input.files?.[0];
		if (!file) return;
		if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type) || file.size > 5 * 1024 * 1024) {
			bioStatus.textContent = 'Choose a PNG, JPEG, or WebP image under 5 MB.';
			input.value = '';
			return;
		}
		const form = new FormData();
		form.append('file', file);
		bioStatus.textContent = `Uploading ${kind}...`;
		try {
			const response = await request(`https://backend.teblocks.my.id/api/profile/media/${kind}`, { method: 'POST', body: form }, 1);
			const body = await response.json().catch(() => ({}));
			if (!response.ok) {
				bioStatus.textContent = body.error || `Unable to upload ${kind}.`;
				return;
			}
			const url = body.url || body[`${kind}_url`];
			if (!url) {
				bioStatus.textContent = 'Upload completed but no image URL was returned.';
				return;
			}
			const imageEl = document.querySelector(`#${kind}-image`);
			const fallbackEl = document.querySelector(kind === 'avatar' ? '#avatar-initial' : '.banner-blocks');
			setImage(imageEl, fallbackEl, url, kind === 'avatar' ? `${document.querySelector('#profile-name').textContent}'s avatar` : 'Profile banner');
			bioStatus.textContent = `${kind[0].toUpperCase() + kind.slice(1)} updated.`;
		} catch {
			bioStatus.textContent = `The ${kind} upload timed out. Please try again.`;
		}
	}
	async function loadProfile() {
		const isOwnProfile = !userId;
		const endpoint = isOwnProfile ? 'https://backend.teblocks.my.id/api/profile/me' : `https://backend.teblocks.my.id/api/profile/${encodeURIComponent(userId)}`;
		// Hide every editable control up front. They are only revealed once we have
		// positive proof this profile belongs to the signed-in viewer, so a stale
		// build, a failed request, or a misleading backend flag can never expose them.
		hideEditableControls();
		try {
			const [response, meResponse] = await Promise.all([
				request(endpoint),
				request('https://backend.teblocks.my.id/api/auth/me'),
			]);
			if (response.status === 401) { window.location.replace('/login/'); return; }
			const body = await response.json().catch(() => ({}));
			if (!response.ok) {
				if (response.status === 404) {
					showRetry('Player not found.');
				} else {
					showRetry(body.error || 'Unable to load this profile.');
				}
				return;
			}
			// Determine ownership from two independent sources: the backend flag and a
			// client-side comparison of the signed-in user id against the profile id.
			let viewerId = null;
			if (meResponse.ok) {
				const me = await meResponse.json().catch(() => ({}));
				viewerId = me.user_id || null;
			}
			const isOwn = Boolean(
				isOwnProfile ||
				body.is_own ||
				(viewerId && body.user_id && viewerId === body.user_id)
			);
			setImage(document.querySelector('#banner-image'), document.querySelector('.banner-blocks'), body.banner_url, 'Profile banner');
			setImage(document.querySelector('#avatar-image'), document.querySelector('#avatar-initial'), body.avatar_url, `${body.username || 'Player'}'s avatar`);
			text('#profile-name', body.username);
			text('#avatar-initial', (body.username || '?').slice(0, 1).toUpperCase());
			text('#profile-id', body.user_id);
			text('#member-since', body.created_at ? `Joined ${formatDate(body.created_at)}` : 'TeBlocks player');
			const badge = document.querySelector('#verification-badge');
			badge.textContent = body.email_verified ? 'Verified account' : 'Email not verified';
			badge.classList.toggle('verified', Boolean(body.email_verified));
			text('#player-bio', body.bio || 'No profile note yet.');
			if (isOwn) {
				bioInput.value = body.bio || '';
				profileActions.innerHTML = '<button id="edit-button" class="button-native" type="button">Edit profile</button><button id="share-button" class="button-native" type="button">Share</button><button id="logout-button" class="button-native danger" type="button">Log out</button>';
				setEditMode(false);
				const editBtn = document.getElementById('edit-button');
				if (editBtn) editBtn.addEventListener('click', () => setEditMode(!editMode));
				setAccountCardLabel('Private', 'Account details');
				const shareBtn = document.getElementById('share-button');
				if (shareBtn) shareBtn.addEventListener('click', (event) => copyText(window.location.href, event.currentTarget, 'Link copied'));
				const copyBtn = document.getElementById('copy-id');
				if (copyBtn) copyBtn.addEventListener('click', () => copyText(body.user_id, copyBtn, 'Copied'));
				const logoutBtn = document.getElementById('logout-button');
				if (logoutBtn) logoutBtn.addEventListener('click', async () => { localStorage.removeItem('teblocks_token'); await fetch('https://backend.teblocks.my.id/api/auth/logout', { method: 'POST' }); window.location.assign('/'); });
			} else {
				document.getElementById('avatar-control').hidden = true;
				document.getElementById('banner-control').hidden = true;
				bioForm.hidden = true;
				profileActions.innerHTML = '';
				setAccountCardLabel('Public', 'Player info');
			}
			const ranked = body.ranked || {};
			const stats = body.stats || {};
			const placed = ranked.is_placed;
			const tier = placed ? getRankForRating(ranked.rating) : null;
			const rankLabel = tier ? [tier.name, tier.division].filter(Boolean).join(' ') : 'Unranked';
			text('#rank-name', rankLabel);
			text('#rank-glyph', tier ? tier.glyph : '?');
			text('#rank-copy', placed ? `${ranked.rating} rating` : 'Play ranked matches to place.');
			applyRankTier(tier ? tier.tier : null);
			text('#stat-rating', ranked.rating ?? '--');
			text('#rating-detail', tier ? rankLabel : 'No rating yet');
			text('#stat-matches', stats.matches_played || 0);
			text('#matches-detail', `${stats.wins || 0} wins · ${stats.losses || 0} losses`);
			text('#stat-win-rate', stats.win_rate == null ? '--' : `${stats.win_rate}%`);
			text('#win-detail', stats.win_rate == null ? 'Pending matches' : 'All completed games');
			text('#stat-streak', stats.best_win_streak || 0);
			text('#streak-detail', stats.current_win_streak ? `${stats.current_win_streak} current` : 'Build a run');

			const casual = body.casual || {};
			text('#casual-total', casual.total_plays || 0);
			text('#casual-40l', formatDuration(casual.best_40l_time));
			text('#casual-l', formatDuration(casual.best_l_survival));
			text('#casual-sprint', casual.best_sprint_score != null ? Number(casual.best_sprint_score).toLocaleString() : '--');

			status.hidden = true;
			profileEl.hidden = false;
			loadMatches(isOwn ? null : body.user_id);
			loadRatingHistory(isOwn ? null : body.user_id);
		} catch {
			showRetry('Unable to load this profile.');
		}
	}
	bioForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const button = bioForm.querySelector('button');
		button.disabled = true;
		bioStatus.textContent = 'Saving...';
		try {
			const response = await request('https://backend.teblocks.my.id/api/profile/me', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bio: bioInput.value.trim() || null }) }, 1);
			const body = await response.json().catch(() => ({}));
			if (!response.ok) {
				bioStatus.textContent = body.error || 'Unable to save your profile note.';
				return;
			}
			text('#player-bio', body.bio || 'No profile note yet.');
			bioStatus.textContent = 'Profile note saved.';
		} catch {
			bioStatus.textContent = 'The profile service timed out. Please try again.';
		} finally {
			button.disabled = false;
		}
	});
	document.querySelector('#avatar-upload')?.addEventListener('change', (event) => uploadMedia('avatar', event.currentTarget));
	document.querySelector('#banner-upload')?.addEventListener('change', (event) => uploadMedia('banner', event.currentTarget));
	setupRankGraphHover();
	loadProfile();
</script>
