	.graph-tooltip span { color: var(--dim); }
	.graph-tooltip[hidden] { display: none; }
	#rank-graph { width: 100%; height: 220px; display: block; }

	/* ---------- TAB 5: ACHIEVEMENTS ---------- */
	.profile-achievements-showcase {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.9rem;
		margin-top: 1.2rem;
	}
	.profile-ach-card {
		padding: 0.9rem 1rem;
