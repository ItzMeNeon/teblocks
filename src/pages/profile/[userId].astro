	.profile-ach-card.locked { opacity: 0.5; }
	.profile-ach-icon { font-size: 1.5rem; flex-shrink: 0; }
	.profile-ach-title {
		font-weight: 700;
		font-size: 0.88rem;
		color: var(--text);
		margin: 0 0 0.15rem;
	}
	.profile-ach-status { font-size: 0.75rem; color: var(--text-muted); }
	.profile-ach-card.unlocked .profile-ach-status { color: var(--success); font-weight: 600; }

	@media (max-width: 780px) {
		.profile { margin-top: 2em; padding: 0 0.9em; }
		.profile-banner { height: 140px; }
		.identity-row { flex-wrap: wrap; padding: 0 1.2em 1.2em; }
		.avatar { width: 88px; height: 88px; font-size: 2.5rem; }
