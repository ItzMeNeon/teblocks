---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Profile | ${SITE_TITLE}`} description="TeBlocks player profile and competitive statistics." />
	</head>
	<body>
		<Header />
		<main>
			<div id="profile-status" class="loading" role="status" aria-live="polite">Loading player profile...</div>

			<section id="profile" class="profile" hidden aria-labelledby="profile-name">
				<!-- Cover Banner with Tetromino Parallax Accents -->
				<div id="profile-banner" class="profile-banner">
					<img id="banner-image" alt="" hidden />
					<div class="banner-blocks" aria-hidden="true">
						<i></i><i></i><i></i><i></i>
					</div>
					<div class="banner-overlay" aria-hidden="true"></div>
					<label id="banner-control" class="media-control banner-control" hidden>
						<span>Change banner</span>
						<input id="banner-upload" type="file" accept="image/png,image/jpeg,image/webp" />
					</label>
				</div>

				<div class="profile-card">
					<!-- Identity Row (Avatar + Name + Badges + Actions) -->
					<div class="identity-row">
						<div class="avatar-wrap">
							<div id="avatar" class="avatar">
								<img id="avatar-image" alt="" hidden />
								<span id="avatar-initial">?</span>
							</div>
							<label id="avatar-control" class="media-control avatar-control" hidden>
								<span>Change</span>
								<input id="avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" />
							</label>
						</div>
						<div class="identity">
							<p class="eyebrow" style="--accent-color: var(--i)">
								<span class="presence"></span> Player profile
							</p>
							<h1 id="profile-name">Player</h1>
							<div class="player-meta">
								<span id="country-banner" class="country-banner" hidden>
									<span id="country-flag" class="country-flag">🌐</span>
									<span id="country-name" class="country-name">Global</span>
									<span class="country-locked-tag" title="Region is permanently detected and locked.">🔒 Locked</span>
								</span>
								<span id="verification-badge" class="verification-badge">Unverified</span>
								<span id="member-since" class="member-since"></span>
							</div>
						</div>
						<div class="profile-actions" id="profile-actions"></div>
					</div>

					<!-- osu! × TETR.IO Style Sticky Sub-Nav Tabs -->
					<nav class="profile-tabs-nav" role="tablist" aria-label="Profile navigation">
						<button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="overview">
							<span class="tab-icon">👤</span> Overview
						</button>
						<button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="stats">
							<span class="tab-icon">📊</span> Statistics
						</button>
						<button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="history">
							<span class="tab-icon">📈</span> Rating Chart
						</button>
						<button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="matches">
							<span class="tab-icon">⚔️</span> Matches
						</button>
						<button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="achievements">
							<span class="tab-icon">🏆</span> Badges
						</button>
					</nav>

					<!-- Tab Panels Container -->
					<div class="tab-panels">
						<!-- TAB 1: OVERVIEW -->
						<div id="tab-overview" class="tab-panel active" role="tabpanel">
							<div class="overview-grid">
								<!-- Left Column: Bio & Account Details -->
								<div class="overview-col-left">
									<section class="about-card panel-sub" aria-labelledby="about-title">
										<div class="section-heading">
											<p class="eyebrow" style="--accent-color: var(--t)">Player card</p>
											<h2 id="about-title">About Me</h2>
										</div>
										<p id="player-bio" class="player-bio">No profile note yet.</p>
										<form id="bio-form" class="bio-form" hidden>
											<label class="sr-only" for="profile-bio-input">Profile note</label>
											<input id="profile-bio-input" maxlength="120" placeholder="Add a short profile note" />
											<button class="button compact" type="submit">Save</button>
										</form>
										<p id="bio-status" class="form-status" role="status"></p>
									</section>

									<div class="account-card panel-sub" id="account-card">
										<div class="account-card-header">
											<span class="eyebrow" style="--accent-color: var(--j)">Player</span>
											<strong id="account-card-title">Account details</strong>
										</div>
										<dl>
											<div>
												<dt>Player ID</dt>
												<dd>
													<button id="copy-id" class="copy-id" type="button">
														<span id="profile-id"></span> <b>Copy</b>
													</button>
												</dd>
											</div>
										</dl>
									</div>
								</div>

								<!-- Right Column: Rank & Quick Stat Highlights -->
								<div class="overview-col-right">
									<section class="rank-card panel-sub" aria-labelledby="rank-title">
										<div class="section-heading">
											<p class="eyebrow" style="--accent-color: var(--o)">Competitive</p>
											<h2 id="rank-title">Current Standing</h2>
										</div>
										<div class="rank-display">
											<div class="rank-glyph-wrapper">
												<span id="rank-glyph" class="rank-glyph">?</span>
											</div>
											<div class="rank-details">
												<strong id="rank-name" class="rank-name">Unranked</strong>
												<p id="rank-copy">Play your first ranked match to place.</p>
											</div>
										</div>
									</section>

									<!-- Quick Glance Stats Rack (TETR.IO inspired) -->
									<div class="quick-stats-rack">
										<div class="quick-stat-box">
											<span class="quick-stat-label">Rating</span>
											<strong class="quick-stat-value" id="quick-stat-rating">--</strong>
										</div>
										<div class="quick-stat-box">
											<span class="quick-stat-label">Win Rate</span>
											<strong class="quick-stat-value" id="quick-stat-winrate">--</strong>
										</div>
										<div class="quick-stat-box">
											<span class="quick-stat-label">Matches</span>
											<strong class="quick-stat-value" id="quick-stat-matches">0</strong>
										</div>
										<div class="quick-stat-box">
											<span class="quick-stat-label">Best 40L</span>
											<strong class="quick-stat-value" id="quick-stat-40l">--</strong>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- TAB 2: STATISTICS -->
						<div id="tab-stats" class="tab-panel" role="tabpanel" hidden>
							<div class="stats-category-grid">
								<!-- Ranked Multiplayer Performance -->
								<section class="stats-section panel-sub" aria-labelledby="stats-title">
									<div class="section-heading">
										<p class="eyebrow" style="--accent-color: var(--s)">Multiplayer</p>
										<h2 id="stats-title">Ranked Combat Metrics</h2>
									</div>
									<div class="stats-grid">
										<div class="stat">
											<span>Rating</span>
											<strong id="stat-rating">--</strong>
											<small id="rating-detail">No rating yet</small>
										</div>
										<div class="stat">
											<span>Matches</span>
											<strong id="stat-matches">0</strong>
											<small id="matches-detail">Start your first game</small>
										</div>
										<div class="stat">
											<span>Win rate</span>
											<strong id="stat-win-rate">--</strong>
											<small id="win-detail">Pending matches</small>
										</div>
										<div class="stat">
											<span>Best streak</span>
											<strong id="stat-streak">0</strong>
											<small id="streak-detail">Build a run</small>
										</div>
									</div>
								</section>

								<!-- Solo & Speedrun Records -->
								<section class="stats-section panel-sub" aria-labelledby="casual-title">
									<div class="section-heading">
										<p class="eyebrow" style="--accent-color: var(--z)">Solo & Casual</p>
										<h2 id="casual-title">Speedrun & Records</h2>
									</div>
									<div class="stats-grid stats-grid-3">
										<div class="stat">
											<span>Total plays</span>
											<strong id="casual-total">0</strong>
											<small id="casual-total-detail">Casual games</small>
										</div>
										<div class="stat">
											<span>Best 40L</span>
											<strong id="casual-40l">--</strong>
											<small>Fastest sprint clear</small>
										</div>
										<div class="stat">
											<span>Best sprint</span>
											<strong id="casual-sprint">--</strong>
											<small>Top ultra score</small>
										</div>
									</div>
								</section>
							</div>
						</div>

						<!-- TAB 3: RATING CHART -->
						<div id="tab-history" class="tab-panel" role="tabpanel" hidden>
							<section class="stats-section panel-sub" aria-labelledby="rank-graph-title">
								<div class="section-heading">
									<p class="eyebrow" style="--accent-color: var(--j)">Trajectory</p>
									<h2 id="rank-graph-title">Rank History · 30 Days</h2>
								</div>
								<div class="rank-graph-card panel">
									<svg id="rank-graph" viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label="Rating over the last 30 days"></svg>
									<div id="rank-graph-tooltip" class="graph-tooltip" hidden></div>
									<p id="rank-graph-empty" class="activity-empty">Play ranked matches to build your rating history.</p>
								</div>
							</section>
						</div>

						<!-- TAB 4: MATCHES -->
						<div id="tab-matches" class="tab-panel" role="tabpanel" hidden>
							<section class="activity-card panel-sub" aria-labelledby="activity-title">
								<div class="section-heading">
									<p class="eyebrow" style="--accent-color: var(--z)">Match History</p>
									<h2 id="activity-title">Recent 1v1 Duels</h2>
								</div>
								<div id="match-list" class="match-list">
									<p class="activity-empty">Loading recent matches...</p>
								</div>
							</section>
						</div>

						<!-- TAB 5: ACHIEVEMENTS -->
						<div id="tab-achievements" class="tab-panel" role="tabpanel" hidden>
							<section class="stats-section panel-sub" aria-labelledby="achievements-title">
								<div class="section-heading" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 0.8rem;">
									<div>
										<p class="eyebrow" style="--accent-color: var(--l)">Badges & Milestones</p>
										<h2 id="achievements-title">Achievements</h2>
									</div>
									<a href="/achievements/" class="btn btn-secondary btn-sm" style="font-size: 0.82rem; padding: 0.35rem 0.8rem; text-decoration: none;">View All Achievements →</a>
								</div>
								<div id="profile-achievements-grid" class="profile-achievements-showcase">
									<p class="activity-empty">Loading player achievements...</p>
								</div>
							</section>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.loading { max-width: 960px; margin: 5em auto; padding: 0 1.25em; color: var(--dim); }
	.profile { max-width: 960px; margin: 3.5em auto 0; padding: 0 1.25em; }
	.profile-card {
		border: 1px solid var(--border);
		background: #14141e;
		box-shadow: var(--shadow);
		border-radius: 0 0 var(--radius-lg) var(--radius-lg);
		overflow: hidden;
	}
	.profile-banner {
		position: relative;
		height: 200px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-bottom: 0;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
		background: #0d0d14;
	}
	.profile-banner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.banner-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 60%, rgba(10, 10, 15, 0.8));
		pointer-events: none;
	}
	.banner-blocks {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: end;
		gap: 14px;
		padding-left: 8%;
		pointer-events: none;
	}
	.banner-blocks[hidden] { display: none; }
	.banner-blocks i {
		width: 68px;
		height: 68px;
		margin-bottom: -24px;
		transform: rotate(45deg);
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
	}
	.banner-blocks i:nth-child(2) { height: 118px; background: rgba(255, 102, 171, 0.08); }
	.banner-blocks i:nth-child(3) { height: 55px; background: rgba(255, 204, 34, 0.08); }
	.banner-blocks i:nth-child(4) { height: 92px; background: rgba(68, 221, 136, 0.08); }
	.media-control {
		position: absolute;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		cursor: pointer;
		border: 1px solid var(--border-bright);
		border-radius: var(--radius-sm);
		background: rgba(14, 14, 22, 0.95);
		color: var(--text);
		font-size: .78rem;
		font-weight: 700;
		box-shadow: var(--shadow);
		transition: all var(--transition-fast);
	}
	.media-control:hover {
		border-color: var(--accent);
		background: #1e1e2c;
	}
	.media-control input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.media-control[hidden] { display: none; }
	.media-control span { padding: .45em .75em; }
	.banner-control { right: 1.2em; top: 1.2em; }
	.avatar-wrap { position: relative; flex: 0 0 auto; margin-top: -64px; }
	.avatar {
		width: 112px;
		height: 112px;
		display: grid;
		place-items: center;
		overflow: hidden;
		border: 4px solid var(--bg);
		border-radius: var(--radius-lg);
		background: var(--accent);
		color: #ffffff;
		box-shadow: 0 4px 16px rgba(0,0,0,.6);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 3rem;
		transition: border-color .2s ease;
	}
	.avatar.tier-bronze      { border-color: #ff9f73; }
	.avatar.tier-silver      { border-color: #e0e0e0; }
	.avatar.tier-gold        { border-color: #ffd700; }
	.avatar.tier-platinum    { border-color: #4ec9b0; }
	.avatar.tier-diamond     { border-color: #b388ff; }
	.avatar.tier-master      { border-color: #ff6b8b; }
	.avatar.tier-grandmaster { border-color: #ff9d6e; }

	.avatar img { width: 100%; height: 100%; object-fit: cover; }
	.avatar-control { right: -6px; bottom: -6px; }
	.identity-row { display: flex; align-items: flex-end; gap: 1.4em; padding: 0 1.8em 1.4em; }
	.identity { flex: 1; min-width: 0; }
	.identity .eyebrow { margin: 0 0 .25em; }
	.presence {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 6px var(--success);
	}
	.identity h1 { margin: 0; font-size: clamp(1.8rem, 4.5vw, 2.6rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; overflow-wrap: anywhere; }
	.player-meta { display: flex; gap: .6em; align-items: center; margin: .35em 0 0; font-size: .85rem; flex-wrap: wrap; }
	.verification-badge {
		padding: .15em .55em;
		border-radius: var(--radius-sm);
		background: rgba(255, 68, 102, 0.12);
		color: var(--danger);
		font-weight: 700;
		font-size: .74rem;
		font-family: var(--font-mono);
		border: 1px solid rgba(255, 68, 102, 0.25);
	}
	.verification-badge.verified {
		background: rgba(68, 221, 136, 0.12);
		color: var(--success);
		border-color: rgba(68, 221, 136, 0.25);
	}
	.country-banner {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text);
		font-family: var(--font-mono);
	}
	.country-flag { font-size: 1rem; }
	.country-locked-tag {
		font-size: 0.7rem;
		color: var(--text-muted);
		background: #111118;
		padding: 1px 4px;
		border-radius: 3px;
		cursor: help;
	}

	/* ---------- osu! × TETR.IO SUB-NAV TABS ---------- */
	.profile-tabs-nav {
		display: flex;
		gap: 0.3rem;
		padding: 0 1.8em;
		border-bottom: 1px solid var(--border);
		background: rgba(0, 0, 0, 0.25);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.profile-tabs-nav::-webkit-scrollbar { display: none; }
	.tab-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.95rem 1.25rem;
		border: none;
		border-bottom: 2px solid transparent;
		background: transparent;
		color: var(--text-dim);
		font-family: var(--font-ui);
		font-size: 0.92rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		transition: all var(--transition-fast);
	}
	.tab-btn:hover {
		color: var(--text);
		background: rgba(255, 255, 255, 0.03);
	}
	.tab-btn.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
		background: rgba(255, 102, 171, 0.08);
	}
	.tab-icon { font-size: 1.05rem; }

	/* ---------- TAB PANELS ---------- */
	.tab-panel {
		padding: 1.8em;
		animation: tabFadeIn 0.22s ease-out;
	}
	.tab-panel[hidden] { display: none !important; }
	@keyframes tabFadeIn {
		from { opacity: 0; transform: translateY(4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.panel-sub {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-elevated);
		padding: 1.6em;
	}

	/* ---------- TAB 1: OVERVIEW GRID ---------- */
	.overview-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.4em;
	}
	.overview-col-left, .overview-col-right {
		display: flex;
		flex-direction: column;
		gap: 1.4em;
	}
	.section-heading .eyebrow { margin-bottom: .35em; }
	.section-heading h2 { font-size: 1.3rem; margin: 0; }
	.player-bio { min-height: 2.3em; margin: 1.1em 0 .8em; color: var(--text); line-height: 1.6; }
	.bio-form { display: flex; gap: .55em; }
	.bio-form[hidden] { display: none; }
	.bio-form input {
		min-width: 0;
		flex: 1;
		padding: .6em .8em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--panel);
		color: var(--text);
		font: inherit;
	}
	.bio-form input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: var(--focus-ring);
	}
	.form-status { min-height: 1.1em; margin: .45em 0 0; color: var(--dim); font-size: .76rem; }

	/* Rank Card */
	.rank-display { display: flex; gap: 1.2em; align-items: center; margin: 1.2em 0 0.4em; }
	.rank-glyph-wrapper { flex-shrink: 0; }
	.rank-glyph {
		display: grid;
		place-items: center;
		width: 58px;
		height: 58px;
		border-radius: 50%;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.6rem;
		border: 2px solid var(--border);
		transition: color .2s ease, border-color .2s ease, background .2s ease;
	}
	.rank-glyph.tier-bronze     { color: #ff9f73; border-color: rgba(205,127,50,.45);  background: rgba(205,127,50,.12); }
	.rank-glyph.tier-silver     { color: #e0e0e0; border-color: rgba(192,192,192,.45); background: rgba(192,192,192,.12); }
	.rank-glyph.tier-gold       { color: #ffd700; border-color: rgba(255,215,0,.45);   background: rgba(255,215,0,.12); }
	.rank-glyph.tier-platinum   { color: #4ec9b0; border-color: rgba(78,201,176,.45);  background: rgba(78,201,176,.12); }
	.rank-glyph.tier-diamond    { color: #b388ff; border-color: rgba(179,136,255,.45); background: rgba(179,136,255,.12); }
	.rank-glyph.tier-master     { color: #ff6b8b; border-color: rgba(255,107,139,.45); background: rgba(255,107,139,.12); }
	.rank-glyph.tier-grandmaster{ color: #ff9d6e; border-color: rgba(255,157,110,.45); background: rgba(255,157,110,.12); }
	.rank-name { font-size: 1.25rem; display: block; margin-bottom: 0.15rem; }
	.rank-name.tier-bronze     { color: #ff9f73; }
	.rank-name.tier-silver     { color: #e0e0e0; }
	.rank-name.tier-gold       { color: #ffd700; }
	.rank-name.tier-platinum   { color: #4ec9b0; }
	.rank-name.tier-diamond    { color: #b388ff; }
	.rank-name.tier-master     { color: #ff6b8b; }
	.rank-name.tier-grandmaster{ color: #ff9d6e; }
	.rank-details p { margin: 0; font-size: .88rem; color: var(--text-muted); }

	/* Quick Glance Stats Rack */
	.quick-stats-rack {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.8rem;
	}
	.quick-stat-box {
		padding: 1rem 0.8rem;
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		text-align: center;
